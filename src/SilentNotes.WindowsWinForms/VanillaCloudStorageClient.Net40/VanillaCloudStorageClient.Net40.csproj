<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A11C0F7E-3D52-4B8A-9E2F-0C6B7D1A5003}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>VanillaCloudStorageClient</RootNamespace>
    <AssemblyName>VanillaCloudStorageClient</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>6</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- C# 6 compiles with the Roslyn csc built into MSBuild 14; no external CscToolPath needed -->
    <!-- net40 targeting pack is not installed; use the reference assemblies package directly
         (its .targets file is SDK-style and cannot be imported by MSBuild 14) -->
    <FrameworkPathOverride>$(MSBuildThisFileDirectory)..\..\..\packages\Microsoft.NETFramework.ReferenceAssemblies.net40.1.0.3\build\.NETFramework\v4.0</FrameworkPathOverride>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- 冻结源码中与平台无关的契约与凭证类型（保持序列化格式兼容） -->
    <Compile Include="..\..\VanillaCloudStorageClient\ICloudStorageClient.cs" />
    <Compile Include="..\..\VanillaCloudStorageClient\CloudStorageCredentials.cs" />
    <Compile Include="..\..\VanillaCloudStorageClient\CloudStorageCredentialsRequirements.cs" />
    <Compile Include="..\..\VanillaCloudStorageClient\CloudStorageException.cs" />
    <Compile Include="..\..\VanillaCloudStorageClient\CloudStorageToken.cs" />
    <Compile Include="..\..\VanillaCloudStorageClient\SecureStringExtensions.cs" />
    <Compile Include="..\..\VanillaCloudStorageClient\SerializeableCloudStorageCredentials.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- net40 兼容层：替换 Flurl/OAuth2/FTP 实现，仅保留 WebDAV（HTTP 栈走 net40 原生 HttpWebRequest） -->
    <Compile Include="Compat\StjAttributesShim.cs" />
    <Compile Include="Compat\CloudStorageClientBase.net40.cs" />
    <Compile Include="Compat\WebdavCloudStorageClient.net40.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
