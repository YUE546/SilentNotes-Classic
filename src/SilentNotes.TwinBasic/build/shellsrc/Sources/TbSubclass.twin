Option Explicit

' TbSubclass - minimal WndProc subclass shim for the main form.
'
' P3 SHELL REWORK: the window now carries a NATIVE frame (BorderStyle=1
' Fixed Single, fixed client 1200x800). All custom-chrome duties were
' removed from this class:
'   - WM_NCHITTEST hit codes (resize/caption hot zones)  - gone
'   - WM_GETMINMAXINFO min track size                    - gone
'   - WM_NCLBUTTONDBLCLK maximize toggle                 - gone
' What remains (flicker fix + list wheel):
'   - WM_ERASEBKGND -> 1 (background fully painted by the backbuffer blit;
'     the DefWindowProc erase flash was a flicker source)
'   - WM_MOUSEWHEEL -> list scroll (a focused VB form does not get wheel
'     messages routed to children otherwise)
'
' P1 lesson: bare Module blocks are not accepted in .twin files (TB5079),
' so this stays a [PredeclaredId] class - the default instance is reachable
' as "TbSubclass.<member>" both from the form and from inside the
' AddressOf callback. P1 hard rule: Remove() MUST run before the window
' dies (Form_Unload).

[PredeclaredId]
Class TbSubclass

    Private Const WM_MOUSELEAVE = &H2A3
    Private Const WM_MOUSEWHEEL = &H20A
    Private Const WM_ERASEBKGND = &H14

Private Declare Function SetWindowLongW Lib "user32" (ByVal hWnd As Long, ByVal nIndex As Long, ByVal dwNewLong As Long) As Long
Private Declare Function GetWindowLongW Lib "user32" (ByVal hWnd As Long, ByVal nIndex As Long) As Long
Private Declare Function CallWindowProcW Lib "user32" (ByVal lpPrevWndFunc As Long, ByVal hWnd As Long, ByVal uMsg As Long, ByVal wParam As Long, ByVal lParam As Long) As Long

Public g_Frm As MainForm

' m_origProc must be Public: the (possibly static-like) WndProc callback
' reaches it through the default instance via the class name
Public m_origProc As Long

Private m_hWnd As Long
Private m_installed As Boolean

Public Sub Install(ByVal hWnd As Long, ByVal frm As MainForm)
    If m_installed Then Exit Sub
    Set g_Frm = frm
    m_hWnd = hWnd
    m_origProc = GetWindowLongW(hWnd, GWL_WNDPROC)
    SetWindowLongW hWnd, GWL_WNDPROC, AddressOf WndProc
    m_installed = True
End Sub

Public Sub Remove()
    If Not m_installed Then Exit Sub
    SetWindowLongW m_hWnd, GWL_WNDPROC, m_origProc
    m_installed = False
    Set g_Frm = Nothing
End Sub

Public Function IsInstalled() As Boolean
    IsInstalled = m_installed
End Function

Public Function OrigProc() As Long
    OrigProc = m_origProc
End Function

Private Property Get GWL_WNDPROC() As Long
    GWL_WNDPROC = -4
End Property

Public Function WndProc(ByVal hWnd As Long, ByVal uMsg As Long, ByVal wParam As Long, ByVal lParam As Long) As Long
    On Error GoTo defproc
    Select Case uMsg
        Case WM_ERASEBKGND
            ' background is composed on the backbuffer and blitted by
            ' MainForm.Form_Paint - skip the erase to avoid flicker
            WndProc = 1
            Exit Function
        Case WM_MOUSELEAVE
            If Not TbSubclass.g_Frm Is Nothing Then TbSubclass.g_Frm.OnMouseLeave
        Case WM_MOUSEWHEEL
            If Not TbSubclass.g_Frm Is Nothing Then
                TbSubclass.g_Frm.OnWheel wParam
                WndProc = 0
                Exit Function
            End If
    End Select
defproc:
    WndProc = CallWindowProcW(TbSubclass.m_origProc, hWnd, uMsg, wParam, lParam)
End Function

End Class
