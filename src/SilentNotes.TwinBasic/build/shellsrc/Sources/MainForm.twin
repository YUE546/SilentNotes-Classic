    ' format button captions (CJK via ChrW$, tbform stays ASCII)
    Private Function SFmtCap(ByVal i As Long) As String
        Select Case i
            Case 0
                SFmtCap = ChrW$(&H52A0&) & ChrW$(&H7C97&)                    ' 加粗
            Case 1
                SFmtCap = ChrW$(&H659C&) & ChrW$(&H4F53&)                    ' 斜体
            Case 2
                SFmtCap = ChrW$(&H5220&) & ChrW$(&H9664&) & ChrW$(&H7EBF&)   ' 删除线
            Case 3
                SFmtCap = ChrW$(&H6807&) & ChrW$(&H9898&) & "1"              ' 标题1
            Case 4
                SFmtCap = ChrW$(&H6807&) & ChrW$(&H9898&) & "2"              ' 标题2
            Case 5
                SFmtCap = ChrW$(&H6807&) & ChrW$(&H9898&) & "3"              ' 标题3
            Case 6
                SFmtCap = ChrW$(&H5217&) & ChrW$(&H8868&)                    ' 列表
            Case 7
                SFmtCap = ChrW$(&H7F16&) & ChrW$(&H53F7&)                    ' 编号
            Case 8
                SFmtCap = ChrW$(&H6A2A&) & ChrW$(&H7EBF&)                    ' 横线
            Case 9
                SFmtCap = ChrW$(&H94FE&) & ChrW$(&H63A5&)                    ' 链接
        End Select
    End Function

    ' Each toolbar button shows icon-over-caption (vbButtonGraphical). The
    ' 16x16 pngs are EMBEDDED resources (Resources\PICTURE, compiled into
    ' the exe); a failed load keeps the text-only caption as fallback.
    Private Sub ApplyToolbarIcons()
        SetToolbarIcon cmdFmt0, "text_bold.png"
        SetToolbarIcon cmdFmt1, "text_italic.png"
        SetToolbarIcon cmdFmt2, "text_strikethrough.png"
        SetToolbarIcon cmdFmt3, "text_heading_1.png"
        SetToolbarIcon cmdFmt4, "text_heading_2.png"
        SetToolbarIcon cmdFmt5, "text_heading_3.png"
        SetToolbarIcon cmdFmt6, "text_list_bullets.png"
        SetToolbarIcon cmdFmt7, "text_list_numbers.png"
        SetToolbarIcon cmdFmt8, "text_horizontalrule.png"
        SetToolbarIcon cmdFmt9, "link.png"
        SetToolbarIcon cmdNew, "page_add.png"
        SetToolbarIcon cmdSaveN, "disk.png"
        SetToolbarIcon cmdSafe, "lock.png"
        SetToolbarIcon cmdSync, "arrow_refresh.png"
        SetToolbarIcon cmdSet, "cog.png"
        SetToolbarIcon cmdTheme, "weather_sun.png"
    End Sub

    Private Sub SetToolbarIcon(c As CommandButton, ByVal fn As String)
        On Error Resume Next
        Dim b() As Byte
        b = LoadResData(fn, "PICTURE")
        If UBound(b) >= 0 Then
            Dim p As Object
            Set p = Global.LoadPicture(b)
            If (Err.Number = 0) And (Not p Is Nothing) Then
                c.Picture = p
            End If
            Err.Clear
        End If
    End Sub

    ' ================================================== editor host events

    ' signature MUST match the SHDocVw typelib (p0\wbsrc proved the shape).
    ' Only records navigation completion - EditorInit runs from
    ' EnsureEditorReady with a real time budget (designMode rebuilds the
    ' document and there is no second event to wait on).
    Private Sub wbEdit_DocumentComplete(ByVal pDisp As Object, ByRef URL As Variant)
        On Error Resume Next
        m_Ed.OnDocumentComplete
        WLog "[Editor.doccomplete] tick=" & GetTickCount() & " url=" & CStr(URL)
    End Sub

    ' ======================================================== flicker machine

    ' tmrFmt (60ms) drives three phases before switching to its steady-state
    ' duty (format button state refresh + paste garbage poll):
    '   0: park the cursor on a neutral spot, then measure 5s of true idle
    '   1: sweep the cursor across 5 list rows, count repaints
    '   2: Frame.native gate, tally, (shot mode: capture + unload)
    '   3: steady state
    Private Sub tmrFmt_Timer()
        On Error Resume Next
        If m_modalPump Then Exit Sub       ' modal gate dialog pumping - not now
#If Not CBool(RELEASE_BUILD) Then
        If m_phase = -1 Then
            ' deferred diagnostic start (Form_Activate ran before the repo
            ' was open). Give-up budget ~6s: a failed open still runs the
            ' gates so the failures land in the log instead of hanging
            m_phaseTick = m_phaseTick + 1
            If m_Repo.IsOpen Or m_phaseTick > 100 Then
                WLog "[Diag.deferred] repoOpen=" & m_Repo.IsOpen & " waitedTicks=" & m_phaseTick
                StartDiagBlock
            End If
            Exit Sub
        End If
#End If
        Select Case m_phase
#If Not CBool(RELEASE_BUILD) Then
            Case 0
                If m_phaseTick = 0 Then
                    ' automation launches must not leave another window on
                    ' top: an occluded sweep point swallows the synthetic
                    ' WM_MOUSEMOVEs (Chrome overlap was caught by probe)
                    SetForegroundWindow Me.hWnd
                    DoEvents
                    ParkCursorNeutral
                    m_idleBase = m_paintN
                    m_idleTick0 = GetTickCount()
                End If
                m_phaseTick = m_phaseTick + 1
                If GetTickCount() - m_idleTick0 >= 5000 Then
                    Dim dIdle As Long
                    dIdle = m_paintN - m_idleBase
                    RAssert "Flicker.idle", dIdle <= 2, _
                        "5s true idle paint delta=" & dIdle & " (total paints=" & m_paintN & " redraws=" & m_redrawN & ") [trace lines above if any]"
                    WLog "[ph0] idle done"
                    WLog "[ph0] idle done"
                    m_diagActive = False
                    m_phase = 1
                    m_phaseTick = 0
                    m_hoverBase = m_redrawN
                End If
            Case 1
                ' sweep rows 0..4 (exactly 5 moves); each move to a NEW row
                ' costs exactly one backbuffer redraw (hover change
                ' detection) - counted on the redraw counter
                Dim listTop As Long
                listTop = ToolH + TagH
                SweepTo 140, listTop + m_phaseTick * ItemH + 30
                m_phaseTick = m_phaseTick + 1
                If m_phaseTick > 4 Then
                Dim dHov As Long
                dHov = m_redrawN - m_hoverBase
                RAssert "Flicker.hover", dHov <= 8, _
                    "cursor sweep over 5 rows full-redraw delta=" & dHov & " (row hover = cache strip blits, fast=" & m_fastN & "; WM_PAINT delta=" & (m_paintN - m_idleBase) & ")"
                WLog "[ph1] sweep done"
                ParkCursorNeutral
                m_phase = 2
                m_phaseTick = 0
                End If
            Case 2
                ' re-entry guard: any DoEvents below (gates, wobble) would
                ' dispatch WM_TIMER and re-run this whole phase inside the
                ' pump (P3 lesson) - the timer is off until phase 3
                tmrFmt.Enabled = False
                InstallEditorSubclass   ' retry if the server window came late
                WLog "[ph2] frame"
                FrameNativeGate
                WLog "[ph2] perfscroll"
                GatePerfScroll
                WLog "[ph2] perfselect"
                GatePerfSelect
                WLog "[ph2] maximize"
                GateMaximizeCycle
                WLog "[ph2] syncgate?"
                If m_syncGate Then GateSyncRound
                WLog "[ph2] wobble"
                ' the resize/snap-back can leave the hosted Trident PAINT
                ' SURFACE stale (DOM intact, nothing drawn) - force a full
                ' re-layout with a size wobble + a content re-set
                If m_editReady Then
                    wbEdit.Move ListW + 9, m_rcEdit.y1 + 9, (m_W - 9) - (ListW + 9), (m_rcEdit.y2 - 9) - (m_rcEdit.y1 + 9) - 2
                    DoEvents
                    wbEdit.Move ListW + 9, m_rcEdit.y1 + 9, (m_W - 9) - (ListW + 9), (m_rcEdit.y2 - 9) - (m_rcEdit.y1 + 9)
                    DoEvents
                    m_Ed.SetHtml m_Ed.GetHtml()
                    DoEvents
                End If
                WLog "[ph2] wobble done"
                WLog "=== STARTUP pass=" & m_pass & " fail=" & m_fail & " ==="
                If m_shotMode Then
                    ShotSequence
                    Unload Me
                    Exit Sub
                End If
                If m_maxShot Then
                    MaxShotSequence
                    Unload Me
                    Exit Sub
                End If
                m_phase = 3
                m_phaseTick = 0
                m_pollLen = -1
                tmrFmt.Enabled = True
#End If
            Case 3
                ' steady state: format button states + paste garbage poll
                If m_editReady Then RefreshFmtState
                m_pollTick = m_pollTick + 1
                If m_pollTick >= 12 Then
                    m_pollTick = 0
                    PollPasteClean
                End If
        End Select
    End Sub

#If Not CBool(RELEASE_BUILD) Then
    Private Sub SweepTo(ByVal cx As Long, ByVal cy As Long)
        Dim pt As POINTM
        pt.px = cx
        pt.py = cy
        ClientToScreenA Me.hWnd, pt
        SetCursorPos pt.px, pt.py
        DoEvents
    End Sub

    Private Sub ParkCursorNeutral()
        ' park over the editor paper (no hoverable element there)
        SweepTo (ListW + m_W) \ 2, (ToolH + TagH + m_rcList.y2) \ 2
    End Sub

    Private Sub FrameNativeGate()
        On Error Resume Next
        WLog "[Frame.native] begin tick=" & GetTickCount()
        Dim st As Long
        st = GetWindowLongW(Me.hWnd, GWL_STYLE)
        ' fixed-single border (no WS_THICKFRAME -> no drag-resize) but the
        ' maximize button IS present (user asked for it back)
        Dim ok As Boolean, det As String
        ok = ((st And WS_CAPTION) = WS_CAPTION)
        ok = ok And ((st And WS_SYSMENU) <> 0)
        ok = ok And ((st And WS_MINIMIZEBOX) <> 0)
        ok = ok And ((st And WS_MAXIMIZEBOX) <> 0)
        ok = ok And ((st And WS_THICKFRAME) = 0)
        det = "style=0x" & Hex$(st) & " caption=" & ((st And WS_CAPTION) = WS_CAPTION) & _
            " sysmenu=" & ((st And WS_SYSMENU) <> 0) & " minbox=" & ((st And WS_MINIMIZEBOX) <> 0) & _
            " maxbox=" & ((st And WS_MAXIMIZEBOX) <> 0) & " thick=" & ((st And WS_THICKFRAME) <> 0) & _
            " (maxbox=True: maximize allowed, thick=False: no drag-resize)"
        RAssert "Frame.native", ok, "native fixed chrome, maximizable (" & det & ")"
        WLog "[Frame.native] end tick=" & GetTickCount()
    End Sub

    ' Perf.scroll: 10 wheel notches on the UI thread. Budget 120ms total and
    ' at most 2 full-list rebuilds (a correct scroll only blits; the content
    ' cache survives, full-window redraws would show as redraws>0 too).
    Private Sub GatePerfScroll()
        On Error GoTo fail
        If m_Repo.VisibleCount < 5 Then
            RAssert "Perf.scroll", True, "skip (visible=" & m_Repo.VisibleCount & "<5)"
            Exit Sub
        End If
        m_offset = 0
        ClampScroll
        RedrawAll "perf_scroll_setup"
        Dim full0 As Long, red0 As Long, t0 As Long, i As Long
        full0 = m_listRebuildN
        red0 = m_redrawN
        t0 = GetTickCount()
        For i = 1 To 10
            OnWheel -120 * &H10000              ' notch DOWN (toward the end) = 3 rows
        Next
        Dim dt As Long, rebuilds As Long, reds As Long
        dt = GetTickCount() - t0
        rebuilds = m_listRebuildN - full0
        reds = m_redrawN - red0
        Dim offAfter As Long
        offAfter = m_offset
        m_offset = 0
        ClampScroll
        RedrawAll "perf_scroll_restore"
        RAssert "Perf.scroll", (dt <= 120) And (rebuilds <= 2), _
            "10 wheel notches UI-time=" & dt & "ms (budget 120ms) full-list rebuilds=" & rebuilds & _
            " (budget 2) full-window redraws=" & reds & " scrolledTo=" & offAfter & "px"
        Exit Sub
fail:
        RAssert "Perf.scroll", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' Perf.select: click 5 DIFFERENT notes; the UI-thread time of the select
    ' path (save-check + list feedback + editor html swap) is budgeted at
    ' 150ms total. Content correctness stays with Save.semantics.
    Private Sub GatePerfSelect()
        On Error GoTo fail
        Dim n As Long
        n = m_Repo.VisibleCount
        If n < 10 Then
            RAssert "Perf.select", True, "skip (visible=" & n & "<10)"
            Exit Sub
        End If
        Dim vs(1 To 5) As Long
        vs(1) = 1
        vs(2) = 3
        vs(3) = 5
        vs(4) = n - 2
        vs(5) = n - 1
        Dim i As Long
        For i = 1 To 5
            If vs(i) = m_sel Then vs(i) = vs(i) + 1
        Next
        Dim t0 As Long
        t0 = GetTickCount()
        For i = 1 To 5
            SelectVisible vs(i)
        Next
        Dim dt As Long
        dt = GetTickCount() - t0
        Dim okLoad As Boolean
        okLoad = (m_loadDoc = m_Repo.VisDoc(m_sel))
        Dim lastDoc As Long
        lastDoc = m_Repo.VisDoc(m_sel)
        ' restore to the top row for the shot/interactive state
        SelectVisible 0
        m_offset = 0
        ClampScroll
        RedrawAll "perf_select_restore"
        RAssert "Perf.select", (dt <= 150) And okLoad, _
            "5 clicks on different notes UI-time=" & dt & "ms (budget 150ms, editor async excluded) " & _
            "lastDoc=" & lastDoc & " loadedInEditor=" & okLoad
        Exit Sub
fail:
        RAssert "Perf.select", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' Maximize.cycle: maximize, assert the client grew and the dynamic
    ' layout + hosted editor followed, then restore to exactly 1200x800.
    ' Path A = WM_SYSCOMMAND SC_MAXIMIZE (what the real title-bar button
    ' sends; an external probe confirmed the runtime honors it). Path B =
    ' Me.WindowState. The placement can arrive via posted messages, so each
    ' step pumps for up to 500ms before measuring.
    Private Sub GateMaximizeCycle()
        On Error GoTo fail
        Dim sw0 As Long
        sw0 = ScaleWidth
        Dim path As String
        path = MaximizeHelper(True)
        Dim swMax As Long, shMax As Long
        swMax = ScaleWidth
        shMax = ScaleHeight
        Dim maxOk As Boolean
        maxOk = (swMax > FixedW) And (shMax >= FixedH)
        Dim layOk As Boolean
        layOk = (m_W = swMax) And (m_H = shMax) And (m_rcEdit.x2 = m_W) And (m_rcList.x2 = 280) _
            And (m_rcStatus.y2 = m_H) And (m_rcStatus.y1 = m_H - 24) And (m_rcEdit.y2 = m_rcStatus.y1)
        Dim edOk As Boolean
        edOk = True
        On Error Resume Next
        edOk = (wbEdit.Left = ListW + 9) And (Abs((wbEdit.Left + wbEdit.Width) - (m_W - 9)) <= 1)
        On Error GoTo fail
        Dim pathR As String
        Dim swR As Long, shR As Long
        pathR = MaximizeHelper(False)
        swR = ScaleWidth
        shR = ScaleHeight
        Dim restOk As Boolean
        restOk = (swR = FixedW) And (shR = FixedH) And (m_W = swR) And (m_H = shR)
        RedrawAll "maximize_restore"
        RAssert "Maximize.cycle", maxOk And layOk And edOk And restOk, _
            "max via " & path & " client=" & swMax & "x" & shMax & " layout=" & layOk & " editor=" & edOk & _
            " -> restore via " & pathR & " client=" & swR & "x" & shR & " (back to " & FixedW & "x" & FixedH & ")"
        Exit Sub
fail:
        RAssert "Maximize.cycle", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' maximize (up) / restore with two paths + a pump; returns which path won
    Private Function MaximizeHelper(ByVal up As Boolean) As String
        On Error Resume Next
        Dim sw0 As Long
        sw0 = ScaleWidth
        If up Then
            SendMessageW Me.hWnd, &H112, &HF030&, 0    ' WM_SYSCOMMAND SC_MAXIMIZE
            PumpUntilChanged sw0
            If ScaleWidth > sw0 Then
                MaximizeHelper = "syscmd"
                Exit Function
            End If
            Me.WindowState = 2                        ' vbMaximized
            PumpUntilChanged sw0
            If ScaleWidth > sw0 Then MaximizeHelper = "state=2"
        Else
            SendMessageW Me.hWnd, &H112, &HF120&, 0    ' WM_SYSCOMMAND SC_RESTORE
            PumpUntilChanged sw0
            If ScaleWidth < sw0 Then
                MaximizeHelper = "syscmd"
                Exit Function
            End If
            Me.WindowState = 0                        ' vbNormal
            PumpUntilChanged sw0
            If ScaleWidth < sw0 Then MaximizeHelper = "state=0"
        End If
    End Function

    Private Sub PumpUntilChanged(ByVal sw0 As Long)
        Dim t0 As Long
        t0 = GetTickCount()
        Do While ScaleWidth = sw0
            DoEvents
            If GetTickCount() - t0 > 500 Then Exit Do
        Loop
    End Sub

    ' ======================================================= shot sequence

    Private Sub ShotSequence()
        On Error Resume Next
        ' the overlay capture reads the SCREEN - claim the foreground so
        ' nothing overlaps our window during the shot
        SetForegroundWindow Me.hWnd
        DoEvents
        ' badge verification: when the visible pool has no pinned note, pin
        ' note0 temporarily (gateway memory only - never saved to disk, and
        ' the working copy resets on every start), reload and redraw so the
        ' capture proves the triangle draw path; restored right after.
        Dim probed As Boolean
        probed = False
        If m_Repo.IsOpen Then
            If m_safeN = 0 Then
                WLog "[Screenshot.safe_probe] INFO visible pool has no safe notes - lock badge not exercised in this capture"
            End If
            If m_pinN = 0 Then
                Dim id0 As String
                Dim pr As String
                id0 = m_Repo.NoteId(m_Repo.VisDoc(0))
                pr = m_Repo.SetPinned(id0, True)
                If Left$(pr, 4) <> "ERR:" Then
                    m_Repo.LoadAll
                    RebuildFilterCurrent
                    RedrawAll "shot_pin"
                    WLog "[Screenshot.pinned_probe] INFO note0 " & id0 & " pinned=True for capture (visible pool had no pinned note)"
                    probed = True
                Else
                    WLog "[Screenshot.pinned_probe] FAIL SetNotePinned " & pr
                End If
            Else
                WLog "[Screenshot.pinned_probe] INFO visible pool already has " & m_pinN & " pinned note(s) - no probe needed"
            End If
        End If

        ' -scrollshot regression: drive the REAL scroll path (scrollbar value
        ' change -> cache slice blit) down 3 rows, then capture. The pixel
        ' suite compares this shot against the unscrolled one row-for-row.
        If m_scrollShot And m_sbNative And vsList.Visible Then
            m_syncSb = False
            vsList.Value = 3
            DoEvents
            WLog "[Scroll.shot] INFO scrollshot offset=" & m_offset & " rows=3 (axis regression capture)"
        End If

        EditorDemoForShot
        CaptureNow

        If probed Then
            m_Repo.SetPinned id0, False
            m_Repo.LoadAll
            RebuildFilterCurrent
            m_loadDoc = -1
            LoadNoteForEdit
            RedrawAll "shot_unpin"
            WLog "[Screenshot.pinned_probe] INFO note0 restored pinned=False (not persisted)"
        End If
    End Sub

    ' -maxshot: SC_MAXIMIZE, load the capture-only demo html, self-photograph
    ' the enlarged client (dynamic layout), then the caller unloads.
    Private Sub MaxShotSequence()
        On Error Resume Next
        SetForegroundWindow Me.hWnd
        DoEvents
        SendMessageW Me.hWnd, &H112, &HF030&, 0    ' WM_SYSCOMMAND SC_MAXIMIZE
        DoEvents
        EditorDemoForShot
        DoEvents
        Dim det As String
        Dim ok As Boolean
        If m_ieHwnd <> 0 And m_editReady Then
            ok = m_G.CaptureWithOverlay(hDC, ScaleWidth, ScaleHeight, m_shotFile, det, Me.hWnd, m_ieHwnd)
        Else
            ok = m_G.CaptureWindowPng(hDC, ScaleWidth, ScaleHeight, m_shotFile, det)
        End If
        If ok Then
            WLog "[Screenshot.saved] PASS " & m_shotFile & " (maximized " & det & ")"
        Else
            WLog "[Screenshot.saved] FAIL could not write " & m_shotFile & " (" & det & ")"
        End If
    End Sub

    ' capture-only rich demo content: detaches the editor from the note
    ' (m_loadDoc = -1) so nothing is ever saved to the repository
    Private Sub EditorDemoForShot()
        On Error Resume Next
        If Not m_editReady Then Exit Sub
        m_loadDoc = -1
        m_Ed.SetHtml SRichDemoHtml()
        RefreshFmtState
        WLog "[Screenshot.editor_demo] INFO capture-only demo html loaded (m_loadDoc=-1, nothing saved)"
    End Sub

#End If

#If Not CBool(RELEASE_BUILD) Then
    Private Sub CaptureNow()
        On Error Resume Next
        Dim det As String
        ' capture from the form's own client DC (client == window interior);
        ' the windowed WebBrowser region is composited via WM_PRINT
        Dim ok As Boolean
        If m_ieHwnd <> 0 And m_editReady Then
            ok = m_G.CaptureWithOverlay(hDC, ScaleWidth, ScaleHeight, m_shotFile, det, Me.hWnd, m_ieHwnd)
        Else
            ok = m_G.CaptureWindowPng(hDC, ScaleWidth, ScaleHeight, m_shotFile, det)
        End If
        If ok Then
            WLog "[Screenshot.saved] PASS " & m_shotFile & " (" & det & ")"
        Else
            WLog "[Screenshot.saved] FAIL could not write " & m_shotFile & " (" & det & ")"
        End If
    End Sub
#End If

    Private Sub Form_Unload(Cancel As Integer)
        On Error Resume Next
        ' hard rules: save the open note, restore the subclassed WndProcs,
        ' then close the repo
        SaveIfDirty
        TbEditSub.Remove
        TbSubclass.Remove
        m_Repo.CloseRepo
        m_G.Free
        End
    End Sub

    ' ==================================================== subclass callbacks

    Public Sub OnMouseLeave()
        On Error Resume Next
        m_tracked = False
        Dim needFull As Boolean
        If m_hovSb Then
            m_hovSb = False
            needFull = True
        End If
        If m_hovItem <> -1 Then
            Dim oldItem As Long
            oldItem = m_hovItem
            m_hovItem = -1
            If needFull Then
                RedrawAll "leave"
            Else
                PaintListRow oldItem            ' row-only: cache blit
                m_fastN = m_fastN + 1
            End If
        ElseIf needFull Then
            RedrawAll "leave"
        End If
    End Sub

    ' WM_MOUSEWHEEL (routed by TbSubclass): row-quantized scroll through the
    ' built-in VScrollBar - setting Value fires Change -> ApplySbValue ->
    ' one list-strip blit. No full redraw on the wheel path.
    Public Sub OnWheel(ByVal wParam As Long)
        On Error Resume Next
        If EmptyStateKind() > 0 Then Exit Sub
        If m_sbNative Then
            If Not vsList.Visible Then Exit Sub   ' everything already visible
            Dim delta As Long
            delta = (wParam And &HFFFF0000) \ &H10000
            Dim rows As Long
            rows = (Abs(delta) \ 120) * 3         ' 3 rows per notch
            If rows = 0 Then rows = 1
            Dim v As Long
            If delta > 0 Then v = vsList.Value - rows Else v = vsList.Value + rows
            If v < 0 Then v = 0
            If v > vsList.Max Then v = vsList.Max
            If v <> vsList.Value Then
                vsList.Value = v
            End If
        Else
            ' hand-drawn fallback: direct pixel scroll (old path)
            Dim d2 As Long
            d2 = (wParam And &HFFFF0000) \ &H10000
            Dim stepPx As Long
            stepPx = (Abs(d2) \ 120) * (ItemH * 3)
            If stepPx = 0 Then stepPx = ItemH
            If d2 > 0 Then stepPx = -stepPx
            m_offset = m_offset - stepPx
            ClampScroll
            RedrawAll "wheel"
        End If
    End Sub

    ' ============================================== native scrollbar events

    ' The built-in VScrollBar is the scroll STATE source while visible:
    ' user drag/arrows/page and our programmatic syncs all funnel into one
    ' idempotent applier (the sync guard makes our own writes silent).
    Private Sub vsList_Change()
        ApplySbValue
    End Sub

    Private Sub vsList_Scroll()
        ApplySbValue
    End Sub

    Private Sub ApplySbValue()
        On Error Resume Next
        If m_syncSb Then Exit Sub
        If Not m_sbNative Then Exit Sub
        Dim offNew As Long
        offNew = vsList.Value * ItemH
        If offNew < 0 Then offNew = 0
        If offNew > m_sbMaxOff Then offNew = m_sbMaxOff
        If offNew <> m_offset Then
            m_offset = offNew
            RepaintListFast
        End If
    End Sub

    ' Ctrl+click inside the editor (routed by TbEditSub from the
    ' Internet Explorer_Server subclass): open the link externally
    Public Sub OnEditClick(ByVal x As Long, ByVal y As Long)
        On Error Resume Next
        If Not m_editReady Then Exit Sub
        Dim href As String
        If Not m_Ed.LinkAtPoint(x, y, href) Then Exit Sub
        OpenExternalUrl href
    End Sub

    ' ================================================================ layout

    ' THE single source of truth for every region on screen. Drawing AND
    ' hit-testing both read these rects - this is what keeps things aligned.
    Private Sub LayoutAll()
        m_W = ScaleWidth
        m_H = ScaleHeight
        Dim listTop As Long, listBot As Long

        SetRect m_rcTool, 0, 0, m_W, ToolH
        SetRect m_rcTag, 0, ToolH, m_W, ToolH + TagH
        listTop = ToolH + TagH
        listBot = m_H - StatusH
        If listBot < listTop + ItemH Then listBot = listTop + ItemH
        SetRect m_rcList, 0, listTop, ListW, listBot
        SetRect m_rcEdit, ListW, listTop, m_W, listBot
        SetRect m_rcStatus, 0, listBot, m_W, m_H
        SetRect m_rcSb, ListW - SbW, listTop, ListW, listBot

        ' toolbar, right to left: safe, new, sync, settings, moon, format
        Dim yT As Long
        yT = (ToolH - BtnH) \ 2
        SetRect m_rcSafe, m_W - 12 - BtnSafeW, yT, m_W - 12, yT + BtnH
        SetRect m_rcNew, m_rcSafe.x1 - 8 - BtnNewW, yT, m_rcSafe.x1 - 8, yT + BtnH
        SetRect m_rcSaveN, m_rcNew.x1 - 8 - BtnSaveNW, yT, m_rcNew.x1 - 8, yT + BtnH
        SetRect m_rcSync, m_rcSaveN.x1 - 8 - BtnSyncW, yT, m_rcSaveN.x1 - 8, yT + BtnH
        SetRect m_rcSet, m_rcSync.x1 - 8 - BtnSetW, yT, m_rcSync.x1 - 8, yT + BtnH
        SetRect m_rcTheme, m_rcSet.x1 - 8 - MoonS, (ToolH - MoonS) \ 2, m_rcSet.x1 - 8, (ToolH - MoonS) \ 2 + MoonS

        ' format cluster (right-aligned before the moon button). The span
        ' between the search box and the moon shrinks on narrow maximized
        ' clients - compress the buttons to fit instead of overlapping the
        ' box; below the 36px floor the cluster parks off-client
        Dim fx As Long, i As Long
        Dim w As Long, pitch As Long, total As Long, avail As Long
        w = FmtW: pitch = FmtPitch
        total = 9 * pitch + 4 * 2 + w
        avail = (m_rcTheme.x1 - 10) - (m_rcSearch.x2 + 12)
        If avail < total Then
            w = (avail - 26) \ 10
            If w < 36 Then w = 36
            pitch = w + 2
            total = 9 * pitch + 4 * 2 + w
        End If
        If total > avail Then
            For i = 0 To FmtN - 1
                SetRect m_rcFmt(i), -200, -200, -160, -160
            Next
        Else
            fx = m_rcTheme.x1 - 10 - total
            For i = 0 To FmtN - 1
                SetRect m_rcFmt(i), fx, yT, fx + w, yT + BtnH
                fx = fx + pitch
                If i = 2 Or i = 5 Or i = 7 Or i = 8 Then fx = fx + 2   ' group gaps
            Next
        End If

        ' the ten format buttons ride their layout rects (physical pixels)
        cmdFmt0.Move m_rcFmt(0).x1, m_rcFmt(0).y1, FmtW, BtnH
        cmdFmt1.Move m_rcFmt(1).x1, m_rcFmt(1).y1, FmtW, BtnH
        cmdFmt2.Move m_rcFmt(2).x1, m_rcFmt(2).y1, FmtW, BtnH
        cmdFmt3.Move m_rcFmt(3).x1, m_rcFmt(3).y1, FmtW, BtnH
        cmdFmt4.Move m_rcFmt(4).x1, m_rcFmt(4).y1, FmtW, BtnH
        cmdFmt5.Move m_rcFmt(5).x1, m_rcFmt(5).y1, FmtW, BtnH
        cmdFmt6.Move m_rcFmt(6).x1, m_rcFmt(6).y1, FmtW, BtnH
        cmdFmt7.Move m_rcFmt(7).x1, m_rcFmt(7).y1, FmtW, BtnH
        cmdFmt8.Move m_rcFmt(8).x1, m_rcFmt(8).y1, FmtW, BtnH
        cmdFmt9.Move m_rcFmt(9).x1, m_rcFmt(9).y1, FmtW, BtnH

        ' status labels park off-client (y=-100): windowed children fight
        ' the form DC on this WS_CLIPCHILDREN-less form (black strip +
        ' repaint shreds). DrawStatusBar draws the text via GDI and keeps
        ' the labels only as Caption data (gates read them)
        lblStatusL.Move 12, -100, 500, 18
        lblStatusR.Move 12, -100, 520, 18

        ' native search row: a Label beside the permanently visible TextBox
        ' (XP dialog style); the box ends at a fixed x (104px wide),
        ' independent of window width
        SetRect m_rcSearch, 56, yT, 160, yT + BtnH
        On Error Resume Next
        lblSearch.Move 12, -100, 44, 20      ' parked off-client (paint race);
                                             ' DrawToolbar draws its Caption
        txtFind.Move m_rcSearch.x1, (ToolH - 24) \ 2, m_rcSearch.x2 - m_rcSearch.x1, 24
        ' the WebBrowser covers the paper sheet (1px inside the sunken bevel)
        wbEdit.Move ListW + 9, m_rcEdit.y1 + 9, (m_W - 9) - (ListW + 9), (m_rcEdit.y2 - 9) - (m_rcEdit.y1 + 9)
        ' built-in VScrollBar rides the list strip's right edge (17px); the
        ' item cache stays ListW-SbW=268 wide - badges end left of x=258 so
        ' nothing meaningful hides under the control
        vsList.Move ListW - SbNativeW, m_rcList.y1, SbNativeW, m_rcList.y2 - m_rcList.y1

        ' the three toolbar buttons ride their layout rects (physical pixels)
        cmdSafe.Move m_rcSafe.x1, m_rcSafe.y1, m_rcSafe.x2 - m_rcSafe.x1, m_rcSafe.y2 - m_rcSafe.y1
        cmdNew.Move m_rcNew.x1, m_rcNew.y1, m_rcNew.x2 - m_rcNew.x1, m_rcNew.y2 - m_rcNew.y1
        cmdSaveN.Move m_rcSaveN.x1, m_rcSaveN.y1, m_rcSaveN.x2 - m_rcSaveN.x1, m_rcSaveN.y2 - m_rcSaveN.y1
        cmdSync.Move m_rcSync.x1, m_rcSync.y1, m_rcSync.x2 - m_rcSync.x1, m_rcSync.y2 - m_rcSync.y1
        cmdSet.Move m_rcSet.x1, m_rcSet.y1, m_rcSet.x2 - m_rcSet.x1, m_rcSet.y2 - m_rcSet.y1
        cmdTheme.Move m_rcTheme.x1, m_rcTheme.y1, m_rcTheme.x2 - m_rcTheme.x1, m_rcTheme.y2 - m_rcTheme.y1

        ' tag strip: the native cboTag picker rides the strip right of the
        ' drawn "标签：" caption (x=12..56); the bin-empty button appears
        ' only in recycle-bin view (P5-B)
        cboTag.Move 56, m_rcTag.y1 + 4, 220, 24
        cmdTagMgr.Move 280, m_rcTag.y1 + 4, 64, 24
        On Error Resume Next
        cmdBinEmpty.Move 352, m_rcTag.y1 + 4, 96, 24
        cmdBinEmpty.Visible = m_binMode
        On Error GoTo 0
    End Sub

    ' Sizes the window to the fixed client in PHYSICAL pixels via
    ' AdjustWindowRectEx + SetWindowPos. The twips-based Me.Move math
    ' double-converted at 125% DPI (tppx=12 vs the runtime's internal 15)
    ' and produced a window at exactly 80% (965x668 instead of 1206x835),
    ' clipping the right/bottom fifth of the layout.
    Private Const SWP_NOZORDER As Long = 4
    Private Sub SnapFixedSize()
        On Error Resume Next
        Dim rc As RECTW
        rc.R = FixedW
        rc.B = FixedH
        AdjustWindowRectEx rc, GetWindowLongW(Me.hWnd, GWL_STYLE), 0, GetWindowLongW(Me.hWnd, GWL_EXSTYLE)
        Dim w As Long, h As Long
        w = rc.R - rc.L
        h = rc.B - rc.T
        Dim sx As Long, sy As Long
        sx = GetSystemMetrics(16)   ' SM_CXFULLSCREEN
        sy = GetSystemMetrics(17)   ' SM_CYFULLSCREEN
        SetWindowPos Me.hWnd, 0, (sx - w) \ 2, (sy - h) \ 2, w, h, SWP_NOZORDER
        DoEvents
    End Sub

    Private Sub SetRect(r As TRect, ByVal a As Long, ByVal b As Long, ByVal c As Long, ByVal d As Long)
        r.x1 = a
        r.y1 = b
        r.x2 = c
        r.y2 = d
    End Sub

    ' Rebuilds the tag list into cboTag (pick-only combo). m_syncChip holds
    ' off cboTag_Click while ListIndex is restored programmatically.
    ' P5-A: one pseudo entry "回收站" sits at the END of the list when a
    ' repository is open - picking it enters the recycle-bin view.
    Private Sub LayoutChips()
        On Error Resume Next
        Dim n As Long, i As Long

        n = 1 + m_Repo.TagCount
        If m_Repo.IsOpen Then n = n + 1     ' + recycle-bin pseudo entry
        If n < 1 Then n = 1
        m_chipN = n
        ReDim m_chipName(0 To n - 1)

        m_chipName(0) = SAll()
        For i = 1 To m_Repo.TagCount
            m_chipName(i) = m_Repo.AllTag(i - 1)
        Next
        If m_Repo.IsOpen Then m_chipName(n - 1) = SRecycleBin()

        m_syncChip = True
        cboTag.Clear
        For i = 0 To n - 1
            cboTag.AddItem m_chipName(i)
        Next
        If m_chipSel >= n Then m_chipSel = 0
        cboTag.ListIndex = m_chipSel
        m_syncChip = False
    End Sub

    Private Function ChipTagName(ByVal i As Long) As String
        If i >= 1 And i < m_chipN Then
            ChipTagName = m_chipName(i)
        Else
            ChipTagName = ""
        End If
    End Function

    ' ================================================================== data

    Private Sub LoadRepoAndChips()
        On Error Resume Next
        Dim t0 As Long
        t0 = GetTickCount()
        m_Repo.OpenExisting WorkRepo
        If m_Repo.IsOpen Then
            LayoutChips
        End If
        ' startup segment timing (Perf.* instrumentation)
        WLog "[Perf.t.open] open=" & m_Repo.OpenMs & "ms meta=" & m_Repo.MetaMs & "ms html=" & m_Repo.HtmlMs & "ms total=" & (GetTickCount() - t0) & "ms"
    End Sub

    Private Sub RebuildFilterCurrent()
        On Error Resume Next
        Dim q As String, tg As String
        ' P5-A: recycle-bin view = in-bin notes only; tag/search step aside
        m_Repo.RecycleMode = m_binMode
        If m_binMode Then
            q = ""
            tg = ""
        Else
            q = EffectiveQuery()               ' cue text is never a query
            tg = ChipTagName(m_chipSel)
        End If
        m_Repo.RebuildFilter q, tg
        If m_sel >= m_Repo.VisibleCount Then m_sel = m_Repo.VisibleCount - 1
        If m_sel < 0 Then m_sel = 0
        ClampScroll
        ' P5-B: the bin-empty button exists only in the bin view
        cmdBinEmpty.Visible = m_binMode
    End Sub

    ' m_offset is the pixel truth, always a multiple of ItemH (wheel is
    ' row-quantized through the VScrollBar, EnsureVisible aligns to rows).
    ' m_sbMaxOff = the highest row-aligned offset.
    Private Sub ClampScroll()
        Dim viewH As Long, n As Long, viewRows As Long, maxRow As Long
        viewH = m_rcList.y2 - m_rcList.y1
        n = m_Repo.VisibleCount
        viewRows = viewH \ ItemH
        If viewRows < 1 Then viewRows = 1
        maxRow = n - viewRows
        If maxRow < 0 Then maxRow = 0
        m_sbMaxOff = maxRow * ItemH
        If m_offset > m_sbMaxOff Then m_offset = m_sbMaxOff
        If m_offset < 0 Then m_offset = 0
        SyncSb
        CalcSb                                  ' hand-drawn fallback thumb
    End Sub

    ' mirrors m_offset into the built-in VScrollBar (hidden when everything
    ' fits). The sync guard keeps our own Value writes from re-entering.
    Private Sub SyncSb()
        On Error Resume Next
        If Not m_sbNative Then Exit Sub
        If m_syncSb Then Exit Sub
        Dim n As Long, viewRows As Long
        n = m_Repo.VisibleCount
        viewRows = (m_rcList.y2 - m_rcList.y1) \ ItemH
        If viewRows < 1 Then viewRows = 1
        Dim wantVis As Boolean
        wantVis = (n > viewRows)
        If vsList.Visible <> wantVis Then vsList.Visible = wantVis
        If Not wantVis Then Exit Sub
        m_syncSb = True
        Dim newMax As Long
        newMax = n - viewRows
        If vsList.Max <> newMax Then vsList.Max = newMax
        If vsList.LargeChange <> viewRows Then vsList.LargeChange = viewRows
        Dim rowV As Long
        rowV = m_offset \ ItemH
        If rowV > newMax Then rowV = newMax
        If rowV < 0 Then rowV = 0
        If vsList.Value <> rowV Then vsList.Value = rowV
        m_syncSb = False
    End Sub

    ' hand-drawn FALLBACK thumb geometry (only painted when the built-in
    ' VScrollBar probe failed); harmless no-op otherwise
    Private Sub CalcSb()
        Dim viewH As Long, contentH As Long
        viewH = m_rcList.y2 - m_rcList.y1
        contentH = m_Repo.VisibleCount * ItemH
        m_sbThumbH = 0
        m_sbThumbY = 0
        If contentH <= viewH Or contentH <= 0 Then Exit Sub
        m_sbThumbH = viewH * viewH \ contentH
        If m_sbThumbH < 24 Then m_sbThumbH = 24
        If m_sbThumbH > viewH Then m_sbThumbH = viewH
        If m_sbMaxOff > 0 Then
            m_sbThumbY = m_rcSb.y1 + (viewH - m_sbThumbH) * m_offset \ m_sbMaxOff
        Else
            m_sbThumbY = m_rcSb.y1
        End If
    End Sub

    ' keeps the selected row fully visible (row-aligned offsets)
    Private Sub EnsureVisible()
        Dim viewH As Long, viewRows As Long
        Dim top As Long
        viewH = m_rcList.y2 - m_rcList.y1
        viewRows = viewH \ ItemH
        If viewRows < 1 Then viewRows = 1
        If m_Repo.VisibleCount = 0 Then
            m_offset = 0
            Exit Sub
        End If
        top = m_sel * ItemH
        If top < m_offset Then
            m_offset = top                      ' selection becomes the top row
        ElseIf top + ItemH > m_offset + viewH Then
            Dim rowV As Long
            rowV = m_sel - viewRows + 1         ' selection becomes the bottom row
            If rowV < 0 Then rowV = 0
            m_offset = rowV * ItemH
        End If
        ClampScroll
    End Sub

    ' ============================================================ editor io

    ' Loads the selected note into the editor (baseline for the dirty test).
    ' Same-doc reloads are skipped (repeated clicks on the selected row are
    ' free; gates that need a forced reload use LoadNoteForEditDoc).
    ' P5-A: recycle-bin rows are NOT loaded into the editor (the original
    ' app offers no editing from the bin) - the editor keeps its previous
    ' content and SaveIfDirty no-ops (m_loadDoc stays -1).
    Private Sub LoadNoteForEdit()
        If Not m_editReady Then Exit Sub
        If Not m_Repo.IsOpen Then Exit Sub
        If m_binMode Then
            m_loadDoc = -1
            Exit Sub
        End If
        If m_Repo.VisibleCount = 0 Then
            m_loadDoc = -1
            m_Ed.SetHtml ""
            m_loadedHtml = m_Ed.GetHtml()
            Exit Sub
        End If
        Dim doc As Long
        doc = m_Repo.VisDoc(m_sel)
        If doc = m_loadDoc Then Exit Sub
        LoadNoteForEditDoc doc
    End Sub

    Private Sub LoadNoteForEditDoc(ByVal doc As Long)
        On Error Resume Next
        If Not m_editReady Then Exit Sub
        m_lockedDoc = False
        ' P5-B safe note: decrypted content when the safe is open, else the
        ' title placeholder with the save guard (VB _safeNoteTitles view)
        If m_Repo.NoteSafe(doc) Then
            Dim sid As String, plain As String
            sid = m_Repo.NoteSafeId(doc)
            If m_Repo.SafeIsOpen(sid) Then
                plain = m_Repo.DecryptContent(m_Repo.NoteId(doc))
                If Left$(plain, 4) <> "ERR:" Then
                    If Len(plain) = 0 Then plain = "<p><br></p>"
                    m_Ed.SetHtml plain
                    m_loadedHtml = m_Ed.GetHtml()
                    m_loadDoc = doc
                    Exit Sub
                End If
            End If
            m_Ed.SetHtml "<p>" & m_Repo.NoteTitle(doc) & "</p>"
            m_lockedDoc = True
            m_loadedHtml = m_Ed.GetHtml()
            m_loadDoc = doc
            ILog "safe_locked_view", "doc=" & doc & " id=" & m_Repo.NoteId(doc)
            Exit Sub
        End If
        Dim h As String
        h = m_Repo.DocHtml(doc)
        If Len(h) = 0 Then h = "<p><br></p>"
        m_Ed.SetHtml h
        m_loadedHtml = m_Ed.GetHtml()
        m_loadDoc = doc
    End Sub

    ' 淇濆瓨璇箟鐓у師鐗堬細switching away saves the open note first (only when
    ' the editor content differs from the load baseline); paste garbage is
    ' cleaned on the way out.
    Private Sub SaveIfDirty()
        On Error Resume Next
        If Not m_editReady Or m_loadDoc < 0 Then Exit Sub
        If m_lockedDoc Then Exit Sub      ' P5-B: locked safe note = read-only placeholder
        If Not m_Repo.IsOpen Then Exit Sub
        Dim cur As String
        cur = m_Ed.GetHtml()
        If StrComp(cur, m_loadedHtml, vbBinaryCompare) = 0 Then Exit Sub

        Dim cln As String
        cln = m_Ed.CleanHtml(cur)
        Dim id As String
        id = m_Repo.NoteId(m_loadDoc)
        If m_Repo.UpdateHtml(id, cln) Then
            ILog "note_save", "doc=" & m_loadDoc & " id=" & id & " len=" & Len(cln) & " cleaned=" & (StrComp(cln, cur, vbBinaryCompare) <> 0)
            m_loadedHtml = cur
        Else
            ' keep m_loadedHtml: a failed save stays dirty so the next
            ' switch-away retries instead of silently dropping the edit
            ILog "note_save", "FAILED doc=" & m_loadDoc & " " & m_Repo.LastErr
        End If
    End Sub

    ' is the editor holding unsaved changes for the open note? (the dirty
    ' test of SaveIfDirty, shared with the switch-away save-ask)
    Private Function EditorDirty() As Boolean
        On Error Resume Next
        If Not m_editReady Or m_loadDoc < 0 Then Exit Function
        If m_lockedDoc Then Exit Function
        If Not m_Repo.IsOpen Then Exit Function
        Dim cur As String
        cur = m_Ed.GetHtml()
        EditorDirty = (StrComp(cur, m_loadedHtml, vbBinaryCompare) <> 0)
    End Function

    ' selection change with save-before-switch semantics. Immediate visual
    ' feedback comes from the row cache (two row re-renders + one strip
    ' blit); the editor html swap happens AFTER the list has repainted, so
    ' a slow editor roundtrip never delays the selection feedback.
    Private Sub SelectVisible(ByVal v As Long)
        On Error Resume Next
        ' NOTE: no VisibleCount upper-bound exit - SaveIfDirty MUST run on
        ' every switch-away (data-loss guard). The gates call SelectVisible
        ' right after AddNew/UpdateHtml while the visible pool is still
        ' stale-empty (LoadAll zeroes it until RebuildFilter) - the cache
        ' paths below self-guard in that window.
        If v < 0 Then Exit Sub
        If v = m_sel Then
            ' same row: only skip when the editor really shows this row's
            ' doc (repeat clicks). Gates can desync row/editor via
            ' LoadNoteForEditDoc - then the switch (save + load) must run.
            ' A stale pool (post-LoadAll, pre-RebuildFilter) must not feed
            ' this check - VisDoc reads a zeroed slot then.
            If m_Repo.VisibleCount > v Then
                If m_loadDoc = m_Repo.VisDoc(v) Then Exit Sub
            End If
        End If
        If EditorDirty() Then
            If m_shotMode Or m_gatesMode Or m_syncGate Then
                SaveIfDirty                  ' gates keep the auto-save contract
            ElseIf ShowConfirmModal(SSaveTitle(), SSaveQ(), SSaveOk()) Then
                SaveIfDirty                  ' user chose save
            Else
                m_loadedHtml = m_Ed.GetHtml() ' discard: suppress poll/save
                m_pollLen = Len(m_loadedHtml)
            End If
        End If
        Dim oldSel As Long
        oldSel = m_sel
        m_sel = v
        EnsureVisible
        If EmptyStateKind() = 0 Then
            RenderCacheRow oldSel               ' unselect (if in range)
            RenderCacheRow m_sel                ' select
            RepaintListFast
            m_fastN = m_fastN + 1
        End If
        LoadNoteForEdit
        ILog "select", "row=" & v & " id=" & m_Repo.NoteId(m_Repo.VisDoc(v)) & " old=" & oldSel & " fast=1"
    End Sub

    ' Paste garbage poll (steady state, every ~720ms): a length change plus
    ' a quick banned-tag probe triggers the same clean pass the save path
    ' uses. Late-bound string fetch once per poll is cheap.
    Private Sub PollPasteClean()
        On Error Resume Next
        If Not m_editReady Then Exit Sub
        Dim cur As String
        cur = m_Ed.GetHtml()
        If Len(cur) = m_pollLen Then Exit Sub
        m_pollLen = Len(cur)
        If InStr(1, cur, "<script", vbTextCompare) > 0 _
            Or InStr(1, cur, "<o:p", vbTextCompare) > 0 _
            Or InStr(1, cur, "<style", vbTextCompare) > 0 _
            Or InStr(1, cur, "<iframe", vbTextCompare) > 0 Then
            Dim cln As String
            cln = m_Ed.CleanHtml(cur)
            If StrComp(cln, cur, vbBinaryCompare) <> 0 Then
                m_Ed.SetHtml cln
                m_pollLen = Len(m_Ed.GetHtml())
                ILog "paste_clean", "stripped " & Len(cur) & " -> " & Len(cln)
            End If
        End If
    End Sub

    ' -------------------------------------------------------------- theme

    Private Sub ToggleTheme()
        Dim nm As String
        nm = m_Th.Toggle
        m_Th.SaveToIni IniPath
        m_listThemeDirty = True                 ' list cache re-renders
        ApplyChildTheme
        ApplyEditorTheme
        RedrawAll "theme"
        ' P6: theme switch feedback (5s auto-revert)
        SetStatusMsg SThemeIs() & nm
        ILog "theme_toggle", "now=" & nm
    End Sub

    Private Sub ApplyChildTheme()
        On Error Resume Next
        ' the box keeps its native 3D border (XP look); changing BorderStyle
        ' at runtime would RECREATE the tB control window and reset Visible
        txtFind.BackColor = m_Th.EditSheet
        If m_cueOn Then txtFind.ForeColor = m_Th.TextMuted Else txtFind.ForeColor = m_Th.Text
        ' status labels replace the old m_G.TextAt colors (Text / TextMuted)
        lblStatusL.ForeColor = m_Th.Text
        lblStatusR.ForeColor = m_Th.TextMuted
        ' P6: the opaque labels ride the solid strip - same color as the
        ' DrawStatusBar fill, set per theme (dual-theme guard)
        lblStatusL.BackColor = m_Th.StatusTop
        lblStatusR.BackColor = m_Th.StatusTop
    End Sub

    Private Sub ApplyEditorTheme()
        On Error Resume Next
        If Not m_editReady Then Exit Sub
        m_Ed.ApplyTheme (StrComp(m_Th.Name, "graphite", vbTextCompare) = 0)
    End Sub

    ' ------------------------------------------------------------ actions

    Private Sub cboTag_Click()
        On Error Resume Next
        If m_syncChip Then Exit Sub
        m_chipSel = cboTag.ListIndex
        If m_chipSel < 0 Then m_chipSel = 0
        ' the pseudo entry at the END of the picker is the recycle bin
        Dim wasBin As Boolean
        wasBin = m_binMode
        m_binMode = (StrComp(ChipTagName(m_chipSel), SRecycleBin(), vbTextCompare) = 0)
        SaveIfDirty
        RebuildFilterCurrent
        m_sel = 0
        m_offset = 0
        LoadNoteForEdit
        If m_binMode <> wasBin Then
            ILog "bin_mode", IIf(m_binMode, "enter", "leave") & " visible=" & m_Repo.VisibleCount & " bin=" & m_Repo.BinCount
        End If
        ILog "tag_pick", "tag='" & ChipTagName(m_chipSel) & "' visible=" & m_Repo.VisibleCount
        RedrawAll "tagpick"
    End Sub

    ' Tag manager: modal TagDlg shuttle over the selected note's tags.
    ' On Confirmed the US-joined result goes through TbRepo.SetNoteTags
    ' (save + reload inside); the shell then rebuilds chips + filter and
    ' repaints. Skips silently when no note is selected.
    Private Sub cmdTagMgr_Click()
        On Error Resume Next
        If m_Repo.VisibleCount = 0 Then Exit Sub
        If m_sel < 0 Or m_sel >= m_Repo.VisibleCount Then Exit Sub
        Dim doc As Long
        doc = m_Repo.VisDoc(m_sel)
        Dim id As String
        id = m_Repo.NoteId(doc)

        Dim nAll As Long, nCur As Long
        nAll = m_Repo.TagCount
        nCur = m_Repo.NoteTagCount(doc)
        Dim allTags() As String, curTags() As String
        Dim j As Long
        If nAll > 0 Then
            ReDim allTags(0 To nAll - 1)
            For j = 0 To nAll - 1
                allTags(j) = m_Repo.AllTag(j)
            Next
        Else
            ReDim allTags(0 To 0)
        End If
        If nCur > 0 Then
            ReDim curTags(0 To nCur - 1)
            For j = 0 To nCur - 1
                curTags(j) = m_Repo.NoteTag(doc, j)
            Next
        Else
            ReDim curTags(0 To 0)
        End If

        TagDlg.Preload allTags, nAll, curTags, nCur, Me.hWnd, m_Repo.NoteTitle(doc)
        ShowModalGuarded TagDlg
        If TagDlg.Confirmed Then
            Dim r As String
            r = m_Repo.SetNoteTags(id, TagDlg.UsJoined)
            If Left$(r, 4) <> "ERR:" Then
                LayoutChips
                RebuildFilterCurrent
                m_sel = 0
                m_offset = 0
                LoadNoteForEdit
                RedrawAll "tagmgr"
                ILog "tagmgr", "id=" & id & " nAll=" & nAll & " nCur=" & nCur
            Else
                ILog "tagmgr_err", r
            End If
        End If
    End Sub

    Private Sub ClearSearch()
        On Error Resume Next
        If m_cueOn Then
            LeaveCue                           ' placeholder is not a query
        ElseIf Len(txtFind.Text) > 0 Then
            txtFind.Text = ""
            ILog "search_clear", "Esc/button"
        End If
    End Sub

    Private Sub MoveSel(ByVal d As Long)
        If m_Repo.VisibleCount = 0 Then Exit Sub
        Dim t As Long
        t = m_sel + d
        If t < 0 Then t = 0
        If t > m_Repo.VisibleCount - 1 Then t = m_Repo.VisibleCount - 1
        If t = m_sel Then Exit Sub
        ILog "select_move", "row=" & t & " id=" & m_Repo.NoteId(m_Repo.VisDoc(t))
        SelectVisible t
    End Sub

    Private Sub NewNote()
        On Error GoTo fail
        ' save the open note first, then reset filters so the new note is
        ' visible and selectable
        SaveIfDirty
        If m_chipSel <> 0 Then
            m_chipSel = 0
            m_binMode = False              ' leaving the recycle-bin view too
            m_syncChip = True
            cboTag.ListIndex = 0
            m_syncChip = False
            m_Repo.RecycleMode = False
            m_Repo.RebuildFilter EffectiveQuery(), ""
        End If
        If Len(txtFind.Text) > 0 Then txtFind.Text = ""

        Dim id As String
        id = m_Repo.AddNew(SNewNoteHtml())
        If Left$(id, 4) = "ERR:" Then
            ILog "new_note", "FAILED " & id & " " & m_Repo.LastErr
            Exit Sub
        End If
        RebuildFilterCurrent
        Dim v As Long
        v = m_Repo.FindVisByDoc(m_Repo.FindDocById(id))
        If v >= 0 Then
            m_sel = v
            EnsureVisible
        End If
        LoadNoteForEdit
        ' P6: the new note is persisted immediately (AddNew) - report it
        SetStatusMsg SNoteCreated()
        ILog "new_note", "id=" & id & " visible=" & m_Repo.VisibleCount & " saved=1"
        RedrawAll "new_note"
        Exit Sub
fail:
        ILog "new_note", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' ------------------------------------------------ P5-A note lifecycle

    ' Modal confirm dialog (ConfirmDlg). In gate/automation mode GateAnswer
    ' auto-answers through the REAL dialog path (same pattern as
    ' SyncDlg.GateApply) - no modal can hang the unattended run.
    ' Re-entry guard: when the gates run from the tmrFmt phase -1 deferral
    ' the timer is LIVE - a modal pump would dispatch WM_TIMER mid-gates
    ' and re-run the phase machine (P3 lesson #16). The timer goes off
    ' around the pump; m_modalPump is the belt-and-braces guard.
    Private m_modalPump As Boolean

    Private Function ShowConfirmModal(ByVal title As String, ByVal msg As String, ByVal okText As String) As Boolean
        On Error GoTo fail
        ConfirmDlg.Preload title, msg, okText, Me.hWnd
        If m_shotMode Or m_gatesMode Or m_syncGate Then
            ' auto-answer WITHOUT Show 1: the modal's Activate-driven
            ' answer loses to any foreground focus fight (observed as the
            ' purge confirm sitting forever), so the gates consume the
            ' answer straight through the real button handlers instead
            ConfirmDlg.GateAnswer = "ok"
            ConfirmDlg.AutoAnswerNow
            ShowConfirmModal = ConfirmDlg.Confirmed
            Exit Function
        End If
        Dim timerWasOn As Boolean
        timerWasOn = tmrFmt.Enabled
        If timerWasOn Then tmrFmt.Enabled = False
        m_modalPump = True
        ConfirmDlg.Show 1, Me
        m_modalPump = False
        If timerWasOn Then tmrFmt.Enabled = True
        ShowConfirmModal = ConfirmDlg.Confirmed
        Exit Function
fail:
        m_modalPump = False
        On Error Resume Next
        If timerWasOn Then tmrFmt.Enabled = True
        WLog "[ConfirmDlg] err=" & Err.Number & " " & Err.Description
        ShowConfirmModal = False
    End Function

    ' modal Show 1 with the tmrFmt/m_modalPump guard of ShowConfirmModal:
    ' PollPasteClean (tmrFmt phase 3) must not touch the editor while a
    ' modal form owns the message loop
    Private Sub ShowModalGuarded(ByRef f As Form)
        Dim timerWasOn As Boolean
        timerWasOn = tmrFmt.Enabled
        If timerWasOn Then tmrFmt.Enabled = False
        m_modalPump = True
        On Error GoTo fail
        f.Show 1, Me
        m_modalPump = False
        If timerWasOn Then tmrFmt.Enabled = True
        Exit Sub
fail:
        m_modalPump = False
        On Error Resume Next
        If timerWasOn Then tmrFmt.Enabled = True
    End Sub

    ' DELETE key (normal mode): move the selected note to the recycling bin
    ' (VB line DeleteSelectedNoteFromUi semantics: confirm -> in_recycling_bin
    ' -> save -> select the first visible note -> refresh; pending edits of
    ' the dying note are discarded like the original does).
    Private Sub DeleteSelectedFromUi()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then Exit Sub
        If m_binMode Then Exit Sub             ' bin rows use Shift+Delete
        If m_sel < 0 Or m_sel >= m_Repo.VisibleCount Then Exit Sub
        Dim doc As Long
        doc = m_Repo.VisDoc(m_sel)
        Dim id As String
        id = m_Repo.NoteId(doc)

        If Not ShowConfirmModal(SBinTitle(), SMoveToBinQ(), SOkMoveBin()) Then Exit Sub

        If m_loadDoc = doc Then
            ' discard pending edits of the DYING note (VB semantics); a
            ' different open note keeps its pending edits for its own
            ' switch-away save
            m_loadDoc = -1
            m_lockedDoc = False
            m_loadedHtml = m_Ed.GetHtml()      ' baseline reset: no stray save
        End If
        Dim r As String
        r = m_Repo.SetNoteRecycling(id, True)
        If Left$(r, 4) = "ERR:" Then
            SetStatusMsg SMoveBinFail()
            ILog "note_bin", "FAILED id=" & id & " " & m_Repo.LastErr
            Exit Sub
        End If
        RebuildFilterCurrent
        m_sel = 0
        m_offset = 0
        LoadNoteForEdit
        RedrawAll "note_bin"
        SetStatusMsg SMovedToBin()           ' after the redraw - DrawStatusBar rewrites the left label
        ILog "note_bin", "id=" & id & " visible=" & m_Repo.VisibleCount & " bin=" & m_Repo.BinCount
        Exit Sub
fail:
        ILog "note_bin", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' Ctrl+P: toggle the pinned flag of the selected note (normal mode).
    ' Persists through SetPinnedSave (gateway + save + reload).
    Private Sub TogglePinFromUi()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then Exit Sub
        If m_binMode Then Exit Sub
        If m_sel < 0 Or m_sel >= m_Repo.VisibleCount Then Exit Sub
        Dim doc As Long
        doc = m_Repo.VisDoc(m_sel)
        Dim id As String
        id = m_Repo.NoteId(doc)
        Dim newPin As Boolean
        newPin = Not m_Repo.NotePin(doc)
        Dim r As String
        r = m_Repo.SetPinnedSave(id, newPin)
        If Left$(r, 4) = "ERR:" Then
            ILog "note_pin", "FAILED id=" & id & " " & m_Repo.LastErr
            Exit Sub
        End If
        RebuildFilterCurrent
        If m_sel >= 0 And m_sel < m_Repo.VisibleCount Then
            RenderCacheRow m_sel               ' pinned triangle repaints
            RepaintListFast
        End If
        ' P6: operation feedback in the status bar (5s auto-revert)
        If newPin Then
            SetStatusMsg SPinned()
        Else
            SetStatusMsg SUnpinned()
        End If
        ILog "note_pin", "id=" & id & " pinned=" & newPin & " total=" & m_Repo.CountPinned()
        Exit Sub
fail:
        ILog "note_pin", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' Ctrl+R (recycle-bin mode): restore the selected note to the list.
    Private Sub RestoreSelectedFromBin()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then Exit Sub
        If Not m_binMode Then Exit Sub
        If m_sel < 0 Or m_sel >= m_Repo.VisibleCount Then Exit Sub
        Dim doc As Long
        doc = m_Repo.VisDoc(m_sel)
        Dim id As String
        id = m_Repo.NoteId(doc)
        Dim r As String
        r = m_Repo.SetNoteRecycling(id, False)
        If Left$(r, 4) = "ERR:" Then
            SetStatusMsg SRestoreFail()
            ILog "note_restore", "FAILED id=" & id & " " & m_Repo.LastErr
            Exit Sub
        End If
        RebuildFilterCurrent                   ' stays in bin mode
        If m_sel >= m_Repo.VisibleCount Then m_sel = m_Repo.VisibleCount - 1
        If m_sel < 0 Then m_sel = 0
        RedrawAll "note_restore"
        SetStatusMsg SRestored()                 ' after the redraw
        ILog "note_restore", "id=" & id & " bin=" & m_Repo.BinCount
        Exit Sub
fail:
        ILog "note_restore", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' Shift+Delete (recycle-bin mode): PERMANENT delete of the selected note
    ' after confirmation - tombstone + removal (RecycleBinViewModel
    ' .DeleteNotePermanently semantics, sync picks it up as a deletion).
    Private Sub PurgeSelectedFromBin()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then Exit Sub
        If Not m_binMode Then Exit Sub
        If m_sel < 0 Or m_sel >= m_Repo.VisibleCount Then Exit Sub
        Dim doc As Long
        doc = m_Repo.VisDoc(m_sel)
        Dim id As String
        id = m_Repo.NoteId(doc)

        If Not ShowConfirmModal(SBinTitle(), SPurgeQ(), SOkPurge()) Then Exit Sub

        If Not m_Repo.DeleteNote(id) Then
            SetStatusMsg SPurgeFail()
            ILog "note_purge", "FAILED id=" & id & " " & m_Repo.LastErr
            Exit Sub
        End If
        RebuildFilterCurrent                   ' stays in bin mode
        If m_sel >= m_Repo.VisibleCount Then m_sel = m_Repo.VisibleCount - 1
        If m_sel < 0 Then m_sel = 0
        RedrawAll "note_purge"
        SetStatusMsg SPurged()                   ' after the redraw
        ILog "note_purge", "id=" & id & " total=" & m_Repo.TotalCount
        Exit Sub
fail:
        ILog "note_purge", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' ---------------------------------------------------- format toolbar

    Private Sub FmtClick(ByVal i As Long)
        On Error Resume Next
        If Not m_editReady Then Exit Sub
        Select Case i
            Case 0
                m_Ed.Exec "bold", ""
            Case 1
                m_Ed.Exec "italic", ""
            Case 2
                m_Ed.Exec "strikeThrough", ""
            Case 3
                ToggleBlock "H1"
            Case 4
                ToggleBlock "H2"
            Case 5
                ToggleBlock "H3"
            Case 6
                m_Ed.Exec "insertUnorderedList", ""
            Case 7
                m_Ed.Exec "insertOrderedList", ""
            Case 8
                m_Ed.Exec "insertHorizontalRule", ""
            Case 9
                OpenLinkDialog
        End Select
        If i <> 9 Then
            RefreshFmtState
        End If
    End Sub

    Private Sub ToggleBlock(ByVal tag As String)
        Dim target As String
        If StrComp(m_Ed.BlockTag(), tag, vbTextCompare) = 0 Then
            target = "P"
        Else
            target = tag
        End If
        m_Ed.Exec "formatBlock", "<" & target & ">"
        If StrComp(m_Ed.BlockTag(), target, vbTextCompare) <> 0 Then
            m_Ed.SetBlockTag target      ' doc-mode fallback (outerHTML)
        End If
    End Sub

    ' 60ms QueryState refresh; the buttons are graphical (icon-only, no
    ' text) so the toggled state shows as a BackColor highlight - the
    ' buttons repaint themselves, no form redraw involved
    Private Sub RefreshFmtState()
        On Error Resume Next
        If Not m_editReady Then Exit Sub
        m_fmtOn(0) = m_Ed.QueryState("bold")
        m_fmtOn(1) = m_Ed.QueryState("italic")
        m_fmtOn(2) = m_Ed.QueryState("strikeThrough")
        m_fmtOn(6) = m_Ed.QueryState("insertUnorderedList")
        m_fmtOn(7) = m_Ed.QueryState("insertOrderedList")
        Dim bt As String
        bt = UCase$(m_Ed.BlockTag())
        m_fmtOn(3) = (bt = "H1")
        m_fmtOn(4) = (bt = "H2")
        m_fmtOn(5) = (bt = "H3")
        m_fmtOn(8) = False
        m_fmtOn(9) = False

        ' 0..7 carry the toggled state; 8/9 have no state (neutral face)
        If m_fmtOn(0) Then cmdFmt0.BackColor = m_Th.ChipSelTop Else cmdFmt0.BackColor = vbButtonFace
        If m_fmtOn(1) Then cmdFmt1.BackColor = m_Th.ChipSelTop Else cmdFmt1.BackColor = vbButtonFace
        If m_fmtOn(2) Then cmdFmt2.BackColor = m_Th.ChipSelTop Else cmdFmt2.BackColor = vbButtonFace
        If m_fmtOn(3) Then cmdFmt3.BackColor = m_Th.ChipSelTop Else cmdFmt3.BackColor = vbButtonFace
        If m_fmtOn(4) Then cmdFmt4.BackColor = m_Th.ChipSelTop Else cmdFmt4.BackColor = vbButtonFace
        If m_fmtOn(5) Then cmdFmt5.BackColor = m_Th.ChipSelTop Else cmdFmt5.BackColor = vbButtonFace
        If m_fmtOn(6) Then cmdFmt6.BackColor = m_Th.ChipSelTop Else cmdFmt6.BackColor = vbButtonFace
        If m_fmtOn(7) Then cmdFmt7.BackColor = m_Th.ChipSelTop Else cmdFmt7.BackColor = vbButtonFace
        cmdFmt8.BackColor = vbButtonFace
        cmdFmt9.BackColor = vbButtonFace
    End Sub

    ' -------------------------------------------------------- link dialog

    ' modal LinkDlg (native controls in its own window). vbStartUpOwner
    ' centers it on this form at the true DPI - no pixel/twips math here;
    ' the modal state also blocks main-form input for free.
    Private Sub OpenLinkDialog()
        On Error Resume Next
        Dim sel As String
        m_Ed.SaveSelection           ' the dialog steals focus - keep the range
        sel = m_Ed.SelectionText()
        LinkDlg.Preload sel, Me.hWnd
        ShowModalGuarded LinkDlg
        Dim u As String
        If LinkDlg.Confirmed Then
            u = LinkDlg.LinkUrl
            If Len(u) > 0 Then
                If StrComp(Left$(u, 7), "http://", vbTextCompare) <> 0 _
                    And StrComp(Left$(u, 8), "https://", vbTextCompare) <> 0 Then
                    u = "https://" & u
                End If
                m_Ed.RestoreSelection      ' the dialog focus cleared it
                m_Ed.InsertLink u, LinkDlg.LinkText
                ILog "link_insert", "url=" & u & " (modal dialog)"
            End If
        End If
        RefreshFmtState
    End Sub

    ' -------------------------------------------------------- link open

    ' real open (or gate probe when m_openProbe is set)
    Private Sub OpenExternalUrl(ByVal url As String)
        On Error Resume Next
        If Len(url) = 0 Then Exit Sub
        If m_openProbe Then
            m_lastLinkUrl = url
            WLog "[Link.open] PROBE path=shellexecute url=" & url & " (browser NOT launched)"
            Exit Sub
        End If
        Dim t As String
        t = Trim$(url)
        If StrComp(Left$(t, 7), "http://", vbTextCompare) <> 0 _
            And StrComp(Left$(t, 8), "https://", vbTextCompare) <> 0 _
            And StrComp(Left$(t, 7), "mailto:", vbTextCompare) <> 0 Then
            t = "https://" & t
        End If
        Dim r As Long
        r = ShellExecuteW(Me.hWnd, StrPtr("open"), StrPtr(t), 0, 0, 1)
        ILog "link_open_external", "url=" & t & " ret=" & r
    End Sub

    ' ------------------------------------------------------- list scrollbar

    Private Sub SbMouseDown(ByVal mx As Long, ByVal my As Long)
        If m_sbMaxOff <= 0 Then Exit Sub
        If my < m_sbThumbY Then
            m_offset = m_offset - (m_rcList.y2 - m_rcList.y1)
            ClampScroll
            RedrawAll "sb_page"
        ElseIf my > m_sbThumbY + m_sbThumbH Then
            m_offset = m_offset + (m_rcList.y2 - m_rcList.y1)
            ClampScroll
            RedrawAll "sb_page"
        Else
            m_sbDrag = True
            m_sbDragDy = my - m_sbThumbY
        End If
    End Sub

    Private Sub SbDragMove(ByVal my As Long)
        Dim viewH As Long
        viewH = m_rcList.y2 - m_rcList.y1
        If viewH - m_sbThumbH <= 0 Then Exit Sub
        m_offset = (my - m_sbDragDy - m_rcSb.y1) * m_sbMaxOff \ (viewH - m_sbThumbH)
        ClampScroll
        RedrawAll "sbdrag"
    End Sub

    ' ============================================================= hit tests

    Private Function InRc(r As TRect, ByVal x As Long, ByVal y As Long) As Boolean
        InRc = (x >= r.x1) And (x < r.x2) And (y >= r.y1) And (y < r.y2)
    End Function

    Private Function ItemAt(ByVal mx As Long, ByVal my As Long) As Long
        ItemAt = -1
        If mx < 0 Or mx >= ListW - SbW Then Exit Function
        If Not InRc(m_rcList, mx, my) Then Exit Function
        Dim v As Long
        v = (my - m_rcList.y1 + m_offset) \ ItemH
        If v >= 0 And v < m_Repo.VisibleCount Then ItemAt = v
    End Function

    Private Function UpdateHover(ByVal mx As Long, ByVal my As Long) As Boolean
        ' snapshots first: a change touching ONLY the hovered list row is
        ' repainted from the row cache (two row renders + one strip blit) -
        ' everything else keeps the full-redraw path
        Dim oSb As Boolean, oItem As Long
        oSb = m_hovSb
        oItem = m_hovItem

        m_hovSb = (Not m_sbNative) And InRc(m_rcSb, mx, my) And (m_sbMaxOff > 0)
        m_hovItem = ItemAt(mx, my)

        If (m_hovItem <> oItem) And (m_hovSb = oSb) Then
            PaintListRow oItem                  ' un-hover the old row
            PaintListRow m_hovItem              ' hover the new row
            m_fastN = m_fastN + 1
            UpdateHover = False                 ' full redraw not needed
        Else
            UpdateHover = (m_hovSb <> oSb) _
                Or (m_hovItem <> oItem)
        End If
    End Function

    ' empty state: 0 = list has rows, 1 = fresh empty repo, 2 = filter mismatch
    Private Function EmptyStateKind() As Long
        If Not m_Repo.IsOpen Then
            EmptyStateKind = 1
        ElseIf m_Repo.VisibleCount > 0 Then
            EmptyStateKind = 0
        ElseIf m_Repo.NonBinCount = 0 Then
            EmptyStateKind = 1
        Else
            EmptyStateKind = 2
        End If
    End Function

    ' ================================================================ drawing

    ' Full-client repaint: composed on the backbuffer, blitted once (the
    ' flicker fix). why is traced during the diagnostic window.
    Private Sub RedrawAll(Optional ByVal why As String = "")
        On Error GoTo drawfail
        If m_firstFrameTick = 0 Then m_firstFrameTick = GetTickCount() - m_bootTick
        m_redrawN = m_redrawN + 1
        If m_diagActive And m_diagLines < 200 Then
            m_diagLines = m_diagLines + 1
            WLog "[paint.trace] n=" & m_redrawN & " tick=" & GetTickCount() & " why=" & why
        End If
        If (Not m_G.MemReady()) Or (m_G.MemW() <> m_W) Or (m_G.MemH() <> m_H) Then
            m_G.InitBackbuffer hDC, m_W, m_H
        End If
        Dim h As Long
        Dim stage As String
        h = m_G.MemHdc()
        If h = 0 Then h = hDC     ' fallback: paint direct
        stage = "editor"
        DrawEditorArea h
        stage = "list"
        DrawListArea h
        stage = "tags"
        DrawTagBar h
        stage = "toolbar"
        DrawToolbar h
        stage = "status"
        DrawStatusBar h
        m_G.BltBackbuffer hDC, m_W, m_H
        m_lastDrawErr = ""
        Exit Sub
drawfail:
        m_lastDrawErr = stage & ": " & Err.Number & " " & Err.Description
        WLog "[RedrawAll.err] " & m_lastDrawErr
    End Sub

    Private Sub DrawToolbar(ByVal h As Long)
        m_G.GradRect h, m_rcTool.x1, m_rcTool.y1, m_rcTool.x2, m_rcTool.y2, m_Th.ToolGradTop, m_Th.ToolGradBot
        m_G.FillRc h, 0, m_rcTool.y2 - 1, m_W, m_rcTool.y2, m_Th.ToolLine

        ' the search label is form-drawn: a windowed Label on this
        ' WS_CLIPCHILDREN-less form loses the paint race against the
        ' gradient (status-bar lesson) - lblSearch stays parked off-client
        ' as the Caption holder
        m_G.TextClip h, lblSearch.Caption, 12, (ToolH - 20) \ 2 + 2, 44, m_Th.Text, m_G.FontUI

        ' search row and all buttons are native controls positioned by
        ' LayoutAll (txtFind + the button cluster) - they paint themselves
        ' over the gradient
    End Sub

    ' tag strip: form-drawn "标签：" prefix at the left end, then the
    ' native cboTag ComboBox (positioned by LayoutAll, rides the strip
    ' right of the caption)
    Private Sub DrawTagBar(ByVal h As Long)
        m_G.FillRc h, m_rcTag.x1, m_rcTag.y1, m_rcTag.x2, m_rcTag.y2, m_Th.TagBg
        m_G.TextClip h, STagLbl(), 12, m_rcTag.y1 + (TagH - 20) \ 2 + 2, 44, m_Th.Text, m_G.FontUI
        m_G.FillRc h, 0, m_rcTag.y2 - 1, m_W, m_rcTag.y2, m_Th.ToolLine
    End Sub

    ' The list renders from a full-content cache (85 items x 60px bitmap):
    ' scrolling/hover/selection only blit; the cache rebuilds on data or
    ' theme changes and single rows re-render in place on selection/hover.
    ' Bottom half-items stay undrawn (the P2 pixel-verified geometry).
    Private Sub DrawListArea(ByVal h As Long)
        m_G.FillRc h, m_rcList.x1, m_rcList.y1, m_rcList.x2, m_rcList.y2, m_Th.ListBg

        If EmptyStateKind() > 0 Then
            DrawEmptyState h
            Exit Sub
        End If

        cmdEmpty.Visible = False            ' normal path: no empty-state button
        EnsureListCache
        Dim itemW As Long, viewH As Long, n As Long
        itemW = ListW - SbW
        viewH = m_rcList.y2 - m_rcList.y1
        n = m_Repo.VisibleCount
        Dim blitH As Long
        blitH = FullSliceH(viewH, n)
        If blitH > 0 Then
            m_G.BltRegion h, 0, m_rcList.y1, itemW, blitH, m_G.ListHdc(), 0, m_offset
        End If
        ' residue below the last full item keeps the list background
        If blitH < viewH Then
            m_G.FillRc h, 0, m_rcList.y1 + blitH, itemW, m_rcList.y2, m_Th.ListBg
        End If

        If Not m_sbNative Then
            DrawScrollbar h                     ' hand-drawn fallback only
        End If
        ' (native mode: the built-in VScrollBar paints itself on top)
    End Sub

    ' source-space height of the cache slice holding no bottom-partial row
    ' (rows straddling the TOP edge are included - the blit origin cuts them)
    Private Function FullSliceH(ByVal viewH As Long, ByVal n As Long) As Long
        Dim listTop As Long, listBot As Long
        listTop = m_rcList.y1
        listBot = m_rcList.y2
        Dim v As Long, endSrc As Long, topScr As Long
        v = m_offset \ ItemH
        endSrc = m_offset
        Do While v < n
            topScr = listTop + v * ItemH - m_offset
            If topScr >= listBot Then Exit Do
            If topScr + ItemH <= listBot Then
                endSrc = (v + 1) * ItemH        ' fully visible row
            ElseIf topScr < listTop Then
                endSrc = (v + 1) * ItemH        ' straddles the top edge
            Else
                Exit Do                         ' bottom partial - stop
            End If
            v = v + 1
        Loop
        FullSliceH = endSrc - m_offset
        If FullSliceH > viewH Then FullSliceH = viewH
        If FullSliceH < 0 Then FullSliceH = 0
    End Function

    ' rebuilds the list content cache when stale (first use, data epoch
    ' change, theme change); renders every row once
    Private Sub EnsureListCache()
        Dim n As Long, itemW As Long, needH As Long
        n = m_Repo.VisibleCount
        If n <= 0 Then Exit Sub
        itemW = ListW - SbW
        needH = n * ItemH
        If m_G.ListReady() And (m_G.ListW() = itemW) And (m_G.ListH() = needH) _
            And (m_listCacheEpoch = m_Repo.Epoch) And (Not m_listThemeDirty) Then Exit Sub
        If Not m_G.InitListCache(hDC, itemW, needH) Then Exit Sub
        Dim h As Long, v As Long
        h = m_G.ListHdc()
        m_G.FillRc h, 0, 0, itemW, needH, m_Th.ListBg
        For v = 0 To n - 1
            DrawItem h, v, v * ItemH, itemW
        Next
        m_listCacheEpoch = m_Repo.Epoch
        m_listThemeDirty = False
        m_listRebuildN = m_listRebuildN + 1
    End Sub

    ' re-renders ONE row into the cache at its absolute slot
    Private Sub RenderCacheRow(ByVal v As Long)
        If EmptyStateKind() > 0 Then Exit Sub
        If v < 0 Or v >= m_Repo.VisibleCount Then Exit Sub
        EnsureListCache
        If Not m_G.ListReady() Then Exit Sub
        Dim itemW As Long
        itemW = ListW - SbW
        Dim h As Long
        h = m_G.ListHdc()
        m_G.FillRc h, 0, v * ItemH, itemW, (v + 1) * ItemH, m_Th.ListBg
        DrawItem h, v, v * ItemH, itemW
    End Sub

    ' recomposes ONLY the list strip (cache slice + scrollbar) and blits
    ' that strip to the screen - the wheel/select/hover fast path
    Private Sub RepaintListFast()
        If EmptyStateKind() > 0 Then
            RedrawAll "list_fast_empty"
            Exit Sub
        End If
        If m_G.MemReady() Then
            DrawListArea m_G.MemHdc()
            m_G.BltRegion hDC, 0, m_rcList.y1, ListW, m_rcList.y2 - m_rcList.y1, m_G.MemHdc(), 0, m_rcList.y1
        Else
            DrawListArea hDC
        End If
    End Sub

    ' single-row feedback entry point (hover/leave/selection): re-render the
    ' row in the cache, then recompose the visible strip
    Private Sub PaintListRow(ByVal v As Long)
        If v >= 0 Then RenderCacheRow v
        RepaintListFast
    End Sub

    Private Sub DrawItem(ByVal h As Long, ByVal v As Long, ByVal y As Long, ByVal itemW As Long)
        Dim doc As Long
        doc = m_Repo.VisDoc(v)
        Dim isSel As Boolean, isHov As Boolean
        isSel = (v = m_sel)
        isHov = (v = m_hovItem) And Not isSel

        ' XP-style solid selection (#316AC5, both themes) or hover wash;
        ' unselected rows end with a 1px separator line
        If isSel Then
            m_G.FillRc h, 0, y, itemW, y + ItemH, m_Th.SelTop
        ElseIf isHov Then
            m_G.FillRc h, 0, y, itemW, y + ItemH, m_Th.ItemHover
        End If
        If Not isSel Then
            m_G.FillRc h, 0, y + ItemH - 1, itemW, y + ItemH, m_Th.RowSep
        End If

        ' status badges, top right
        If m_Repo.NotePin(doc) Then
            m_G.DrawTriUp h, itemW - 14, y + 9, 7, 4, m_Th.PinTri
        End If
        If m_Repo.NoteSafe(doc) Then
            m_G.DrawLock h, itemW - 27, y + 8, m_Th.LockC
        End If

        ' selected rows read white on the solid blue; row text uses the
        ' list face (SimSun), the chrome keeps the UI face
        If isSel Then
            m_G.TextClip h, m_Repo.NoteTitle(doc), 12, y + 9, itemW - 12 - 34, &HFFFFFF, m_G.FontListB
            m_G.TextClip h, m_Repo.NotePrev(doc), 12, y + 32, itemW - 12 - 12, &HFFFFFF, m_G.FontList
        Else
            m_G.TextClip h, m_Repo.NoteTitle(doc), 12, y + 9, itemW - 12 - 34, m_Th.Text, m_G.FontListB
            m_G.TextClip h, m_Repo.NotePrev(doc), 12, y + 32, itemW - 12 - 12, m_Th.TextMuted, m_G.FontList
        End If
    End Sub

    Private Sub DrawScrollbar(ByVal h As Long)
        If m_sbMaxOff <= 0 Then Exit Sub
        Dim cr As Long
        cr = m_Th.ChipLine
        If m_sbDrag Or m_hovSb Then cr = m_Th.SelLine
        m_G.FillRc h, m_rcSb.x1, m_rcSb.y1, m_rcSb.x1 + 1, m_rcSb.y2, m_Th.ToolLine
        m_G.ChipRect h, m_rcSb.x1 + 2, m_sbThumbY, m_rcSb.x2 - 2, m_sbThumbY + m_sbThumbH, cr, -1
    End Sub

    Private Sub DrawEmptyState(ByVal h As Long)
        Dim cx As Long, cy As Long
        Dim w As Long
        w = ListW - SbW
        cx = w \ 2
        cy = (m_rcList.y1 + m_rcList.y2) \ 2

        Dim btnCaption As String
        If EmptyStateKind() = 1 Then
            m_G.TextCenter h, SNoNotes(), cx, cy - 46, m_Th.TextMuted, m_G.FontUIB
            btnCaption = SCreateNote()
        Else
            m_G.TextCenter h, SNoMatch(), cx, cy - 48, m_Th.TextMuted, m_G.FontUIB
            m_G.TextCenter h, STryOther(), cx, cy - 28, m_Th.TextMuted, m_G.FontSmall
            btnCaption = SClearSearch()
        End If

        ' the button itself is the native cmdEmpty (bw + SetRect stay: the
        ' rect is the per-frame Move source) - no hand-drawn hover/normal
        ' paint, the control renders and consumes its own clicks
        Dim bw As Long
        bw = m_G.TextWidth(h, btnCaption, m_G.FontUI) + 28
        SetRect m_rcEmptyBtn, cx - bw \ 2, cy + 2, cx + bw \ 2, cy + 32
        On Error Resume Next
        cmdEmpty.Caption = btnCaption
        cmdEmpty.Move m_rcEmptyBtn.x1, m_rcEmptyBtn.y1, m_rcEmptyBtn.x2 - m_rcEmptyBtn.x1, m_rcEmptyBtn.y2 - m_rcEmptyBtn.y1
        cmdEmpty.Visible = True
        On Error GoTo 0
    End Sub

    Private Sub DrawEditorArea(ByVal h As Long)
        ' panel + sunken outer edge; the WebBrowser (white/dark paper) sits
        ' inset over it once ready - before that the placeholder shows
        m_G.FillRc h, m_rcEdit.x1 + 1, m_rcEdit.y1, m_rcEdit.x2, m_rcEdit.y2, m_Th.EditPanel
        m_G.FillRc h, ListW, m_rcEdit.y1, ListW + 1, m_rcEdit.y2, m_Th.ToolLine
        m_G.Bevel h, ListW + 1, m_rcEdit.y1, m_W, m_rcEdit.y2, m_Th.SunkenLight, m_Th.SunkenDark, False
        If Not m_editReady Then
            m_G.FillRc h, ListW + 8, m_rcEdit.y1 + 8, m_W - 8, m_rcEdit.y2 - 8, m_Th.EditSheet
            Dim cx As Long, cy As Long
            cx = (ListW + 8 + m_W - 8) \ 2
            cy = (m_rcEdit.y1 + 8 + m_rcEdit.y2 - 8) \ 2
            m_G.TextCenter h, SEditorLine1(), cx, cy - 22, m_Th.TextMuted, m_G.FontUI
            m_G.TextCenter h, "SilentNotes twinBASIC", cx, cy + 4, m_Th.TextMuted, m_G.FontSmall
        End If
    End Sub

    Private Sub DrawStatusBar(ByVal h As Long)
        ' SOLID full-width strip, text drawn straight into the form DC:
        ' windowed children on this WS_CLIPCHILDREN-less form race the
        ' paint (black strip + shreds), so no child may live on the strip
        m_G.FillRc h, 0, m_rcStatus.y1, m_W, m_rcStatus.y2, m_Th.StatusTop
        m_G.FillRc h, 0, m_rcStatus.y1, m_W, m_rcStatus.y1 + 1, m_Th.StatusLine

        ' left cell: the transient operation message while one is armed
        ' (SetStatusMsg/RevertStatus + tmrStatus 5s auto-revert), else the
        ' counts line; right cell stays empty (the size grip lives there)
        Dim leftText As String
        leftText = DefaultLeftText()
        If Len(m_statusMsg) > 0 Then leftText = m_statusMsg
        If Len(leftText) > 0 Then
            m_G.TextClip h, leftText, 12, m_rcStatus.y1 + 5, m_W - 560, m_Th.Text, m_G.FontUI
        End If
        ' caption kept in sync for the startup gates (labels are parked
        ' off-client and invisible)
        On Error Resume Next
        lblStatusL.Caption = leftText
        lblStatusR.Caption = ""
        On Error GoTo 0

        ' classic size grip: 2x2 dots on three diagonals, lower right
        Dim i As Long, j As Long
        For i = 0 To 2
            For j = 0 To 2
                If i + j >= 1 Then
                    m_G.FillRc h, m_W - 20 + i * 4, m_H - 14 + j * 4, m_W - 18 + i * 4, m_H - 12 + j * 4, m_Th.Grip
                End If
            Next
        Next
    End Sub

    ' ================================================================= gates
    ' (compiled out of the release artifact - see RELEASE_BUILD at the top)

#If Not CBool(RELEASE_BUILD) Then
    Private Sub RunStartupGates()
        On Error GoTo fail

        ' ---- data gates
        Dim okFile As Boolean
        Dim sz As Long
        sz = FileLenSafe(WorkRepo)
        okFile = (sz > 0)
        RAssert "Repo.file", okFile, "test repo " & WorkRepo & " " & sz & " bytes"

        RAssert "Repo.open", m_Repo.IsOpen, IIf(m_Repo.IsOpen, "pure backend ready", m_Repo.LastErr)

        Dim n As Long, expectN As Long
        n = m_Repo.TotalCount
        ' the expectation is counted from the test repo file, not hardcoded
        Dim srcTxt As String
        Dim srcBytes() As Byte
        If ReadBytesF(WorkRepo, srcBytes) Then
            srcTxt = m_U8.Decode(srcBytes)
            expectN = CountSubStr(srcTxt, "<note id=")
        End If
        RAssert "Repo.count", (n = expectN), "count=" & n & " expect=" & expectN

        WLog "[Repo.recycled] INFO total=" & n & " visiblePool=" & m_Repo.NonBinCount & " hiddenInRecyclingBin=" & (n - m_Repo.NonBinCount)
            m_pinN = m_Repo.CountPinned()
            m_safeN = m_Repo.CountSafe()
            WLog "[Repo.badges] INFO visiblePool pinned=" & m_pinN & " safe=" & m_safeN & " (pinned triangle / safe lock render at item top-right)"

            ' ---- extraction: title = text 1..60, preview = 61..150
            Dim full As String, t0 As String, p0 As String
            full = m_Repo.HtmlToText(m_Repo.DocHtml(0))
            t0 = m_Repo.NoteTitle(0)
            p0 = m_Repo.NotePrev(0)
            Dim exOk As Boolean, exDet As String
            exOk = True
            If Len(t0) = 0 Then exOk = False: exDet = exDet & " title-empty"
            If Len(t0) > 60 Then exOk = False: exDet = exDet & " title>60"
            If Len(p0) > 90 Then exOk = False: exDet = exDet & " preview>90"
            If Len(full) > 150 Then
                If StrComp(t0, Left$(full, 60), vbBinaryCompare) <> 0 Then exOk = False: exDet = exDet & " title!=left60"
                If StrComp(p0, Mid$(full, 61, 90), vbBinaryCompare) <> 0 Then exOk = False: exDet = exDet & " preview!=mid61-150"
            End If
            RAssert "Extract.title_preview", exOk, "note0 titleLen=" & Len(t0) & " previewLen=" & Len(p0) & " textLen=" & Len(full) & exDet

            ' ---- tags: chips = all + unique tags + recycle-bin pseudo entry
            ' (P5-A: the bin entry sits at the END of the picker)
            LayoutChips
            RAssert "Tags.aggregate", (m_chipN = m_Repo.TagCount + 2), "chips=" & m_chipN & " (all + " & m_Repo.TagCount & " unique tags + recycle-bin)"

            ' ---- search filter: a query made from note0's own title finds note0
            Dim q As String, visN As Long, j As Long, found As Boolean
            q = Left$(t0, 2)
            visN = m_Repo.RebuildFilter(q, "")
            found = False
            For j = 0 To visN - 1
                If StrComp(m_Repo.NoteId(m_Repo.VisDoc(j)), m_Repo.NoteId(0), vbTextCompare) = 0 Then found = True
            Next
            RAssert "Filter.search", (visN >= 1) And found, "q='" & q & "' matches=" & visN & " note0 included=" & found

            visN = m_Repo.RebuildFilter("@@no_such_note@@", "")
            RAssert "Filter.search_none", (visN = 0), "impossible query -> 0 rows (filtered-empty branch)"

            ' ---- tag filter + AND combination, using the first tagged note
            Dim docT As Long, tagT As String
            docT = -1
            For j = 0 To n - 1
                If Len(m_Repo.NoteTags(j)) > 0 Then docT = j
                If docT >= 0 Then Exit For
            Next
            If docT >= 0 Then
                Dim parts() As String, nP As Long
                m_Repo.SplitTags m_Repo.NoteTags(docT), parts, nP
                If nP > 0 Then tagT = parts(0)
                visN = m_Repo.RebuildFilter("", tagT)
                Dim f2 As Boolean
                f2 = (m_Repo.FindVisByDoc(docT) >= 0)
                RAssert "Filter.tag", (visN >= 1) And f2, "tag='" & tagT & "' matches=" & visN & " source note included=" & f2

                Dim q2 As String
                q2 = Left$(m_Repo.NoteTitle(docT), 2)
                visN = m_Repo.RebuildFilter(q2, tagT)
                f2 = (m_Repo.FindVisByDoc(docT) >= 0)
                RAssert "Filter.combined", (visN >= 1) And f2, "q='" & q2 & "' AND tag='" & tagT & "' matches=" & visN & " source note included=" & f2
            Else
                RAssert "Filter.tag", True, "no tagged notes in repo - skipped (INFO)"
                RAssert "Filter.combined", True, "no tagged notes in repo - skipped (INFO)"
            End If

            ' restore the live filter state
            m_Repo.RebuildFilter EffectiveQuery(), ChipTagName(m_chipSel)

            ' ---- empty-state logic (simulated, no UI interaction needed)
            m_Repo.RebuildFilter "@@no_such_note@@", ""
            Dim k1 As Long
            k1 = EmptyStateKind()
            m_Repo.RebuildFilter "", ""
            Dim k2 As Long
            k2 = EmptyStateKind()
            RAssert "EmptyState.logic", (k1 = 2) And (k2 = 0), "no-match filter -> kind=" & k1 & " (want 2); clear -> kind=" & k2 & " (want 0)"

        ' ---- theme tokens vs the spec table (blue / graphite)
        Dim t As TbTheme
        Set t = New TbTheme
        t.Apply "blue"
        RAssert "Theme.tokens_blue", Len(ThemeDiff(t, "blue")) = 0, ThemeDiff(t, "blue")
        t.Apply "graphite"
        RAssert "Theme.tokens_graphite", Len(ThemeDiff(t, "graphite")) = 0, ThemeDiff(t, "graphite")

        ' legacy ini values map: light -> blue, dark -> graphite
        t.Apply "light"
        Dim mapOk As Boolean
        mapOk = (StrComp(t.Name, "blue", vbTextCompare) = 0)
        t.Apply "dark"
        mapOk = mapOk And (StrComp(t.Name, "graphite", vbTextCompare) = 0)

        Dim perOk As Boolean
        perOk = m_Th.SaveToIni(IniPath)
        ' TbIni latent-bug regression: the old Save reused the length var as
        ' a write cursor and silently wrote 0 bytes for BOM-less files
        ' (SeedIniFile emits BOM-less UTF-8) - the ini must be non-empty
        Dim iniBytes As Long
        iniBytes = FileLenSafe(IniPath)
        Dim t2 As TbTheme
        Set t2 = New TbTheme
        t2.LoadFromIni IniPath
        RAssert "Theme.persist", perOk And mapOk And (iniBytes > 0) And (StrComp(t2.Name, m_Th.Name, vbTextCompare) = 0), _
            "ui.theme='" & m_Th.Name & "' written to ui_settings.ini and read back as '" & t2.Name & "'; ini bytes=" & iniBytes & " (>0, BOM-less write path); legacy light/dark map to blue/graphite"

        ' ---- layout regions, asserted DYNAMICALLY against the current
        ' client (1200x800 normal, larger when maximized - the layout
        ' derives everything from ScaleWidth/ScaleHeight)
        Dim lb As Boolean, lbDet As String
        lb = True
        If m_rcTool.y1 <> 0 Or m_rcTool.y2 <> 64 Then lb = False: lbDet = lbDet & " tool"
        If m_rcTag.y1 <> 64 Or m_rcTag.y2 <> 100 Then lb = False: lbDet = lbDet & " tag"
        If (m_rcList.x2 - m_rcList.x1) <> 280 Then lb = False: lbDet = lbDet & " listW=" & (m_rcList.x2 - m_rcList.x1)
        If (m_rcStatus.y2 - m_rcStatus.y1) <> 24 Then lb = False: lbDet = lbDet & " statusH=" & (m_rcStatus.y2 - m_rcStatus.y1)
        If m_rcEdit.x1 <> 280 Then lb = False: lbDet = lbDet & " edit.x1=" & m_rcEdit.x1
        If m_rcList.y2 <> m_rcEdit.y2 Or m_rcEdit.y2 <> m_rcStatus.y1 Then lb = False: lbDet = lbDet & " seams"
        If m_W <> ScaleWidth Or m_H <> ScaleHeight Then lb = False: lbDet = lbDet & " client!=scale"
        If m_W < FixedW Or m_H < FixedH Then lb = False: lbDet = lbDet & " client<" & FixedW & "x" & FixedH
        RAssert "Layout.bounds", lb, "client=" & m_W & "x" & m_H & " (dynamic >= " & FixedW & "x" & FixedH & ") tool=64 tag=36 listW=280 status=24 (native title bar; 1px separators)" & lbDet

        ' ---- subclass still installed, reduced duties (erase suppression +
        ' wheel only since the native-chrome rework)
        Dim curProc As Long
        curProc = GetWindowLongW(Me.hWnd, GWL_WNDPROC)
        RAssert "Subclass.installed", TbSubclass.IsInstalled And (curProc <> TbSubclass.OrigProc), _
            "wndproc 0x" & Hex$(TbSubclass.OrigProc) & " -> 0x" & Hex$(curProc) & " (WM_ERASEBKGND + WM_MOUSEWHEEL only - native chrome)"

        ' ---- native search row: the edit box is permanently visible next
        ' to its label (XP dialog style); the Change probe exercises the
        ' filter rebuild path
        If m_cueOn Then LeaveCue               ' placeholder is not a query
        txtFind.Text = "probe"       ' Change fires: filter rebuild, log line
        txtFind.Text = ""
        RAssert "Search.placeholder", (txtFind.hWnd <> 0) And txtFind.Enabled, _
            "native label+edit row present and enabled (tB .Visible reads False on form children)"

        ' ---- Cue.notquery: the placeholder is never a query. Force the cue
        ' state (the Form_Activate race does this before Form_Load's
        ' RebuildFilterCurrent - pitfall 8.13-9), rebuild through the
        ' GUARDED path and expect the FULL pool, not a placeholder search
        Dim cueVis As Long, cueExpect As Long
        If Not m_cueOn Then EnterCue
        RebuildFilterCurrent
        cueVis = m_Repo.VisibleCount
        cueExpect = m_Repo.NonBinCount
        RAssert "Cue.notquery", (cueVis = cueExpect), _
            "cue-on rebuild keeps the pool: visible=" & cueVis & " nonBin=" & cueExpect & _
            " boxTextLen=" & Len(txtFind.Text) & " (placeholder never filters)"
        ' restore the neutral state the steady path expects
        If m_cueOn Then LeaveCue
        txtFind.Text = ""
        RebuildFilterCurrent

        ' ---- Status.wired: operation feedback = SetStatusMsg shows the
        ' message + arms the 5s one-shot; RevertStatus restores the default
        ' row (counts line left, right cell empty) and disarms the timer.
        ' Asserted through the real functions - no 5s wait, no event order.
        Dim sw1 As Boolean, sw2 As Boolean, swDet As String
        SetStatusMsg "gate-status-marker"
        sw1 = (StrComp(lblStatusL.Caption, "gate-status-marker", vbBinaryCompare) = 0) _
              And tmrStatus.Enabled And (StrComp(m_statusMsg, "gate-status-marker", vbBinaryCompare) = 0)
        RevertStatus
        sw2 = (Len(m_statusMsg) = 0) And (Not tmrStatus.Enabled) _
              And (StrComp(lblStatusL.Caption, DefaultLeftText(), vbBinaryCompare) = 0)
        swDet = "msg shown+timer armed=" & sw1 & "; default row restored+timer off=" & sw2 & _
                " (left='" & lblStatusL.Caption & "')"
        ' tB _Label exposes no hWnd member (compile-time) - both labels prove
        ' their presence through live caption round-trips instead
        Dim swR As Boolean
        swR = (Len(lblStatusR.Caption) = 0)      ' right cell intentionally blank
        RAssert "Status.wired", sw1 And sw2 And swR, swDet & " rightCellLen=" & Len(lblStatusR.Caption)

        ' ---- Icon.embedded: the original app icon ships INSIDE the exe
        ' (Resources\ICON\app.ico) and the form icon was set from it at boot
        ' (title bar; exe icon via post-build patch on the same resource
        ' bytes). tB packs the ico as a STANDARD icon resource - reachable
        ' by NAME through LoadResPicture(vbResIcon) but NOT through
        ' LoadResData (the byte-array probe only sees custom-type entries;
        ' the 2026-10-27 gate run proved both), so the gate round-trips the
        ' StdPicture instead - same proof, loadable-by-name = embedded.
        Dim icoPic As Boolean
        On Error Resume Next
        Dim ip2 As Object
        Set ip2 = LoadResPicture("app.ico", vbResIcon)
        icoPic = (Err.Number = 0) And (Not ip2 Is Nothing)
        Err.Clear
        On Error GoTo fail
        RAssert "Icon.embedded", icoPic And m_iconLoaded, _
            "LoadResPicture(app.ico, vbResIcon) ok=" & icoPic & " formIconSet=" & m_iconLoaded & _
            " (standard icon resource by name; exe icon frames byte-verified by build step 4)"

        ' P3 editor gates run from Form_Activate (RunEditorGates) - Trident
        ' completes its navigation only for a visible host window.
        ' final tally is printed by the tmrFmt machine after the flicker gates
        Exit Sub
fail:
        m_fail = m_fail + 1
        WLog "[StartupGates.hardFail] err=" & Err.Number & " " & Err.Description
    End Sub

    ' ================================================== P3 editor gates
    ' (Form_Activate, after EnsureEditorReady - the host window is visible
    ' by then so the hosted Trident has finished its navigation)
    Private Sub RunEditorGates()
        On Error GoTo fail

        Dim ehOk As Boolean
        ehOk = m_editReady And (StrComp(m_Ed.DocMode(), "On", vbTextCompare) = 0)
        RAssert "Editor.host", ehOk, _
            "SHDocVw designer child + MSHTML late-bound, designMode='" & m_Ed.DocMode() & "' ie_server=0x" & Hex$(m_ieHwnd) & " (" & WindowClassOf(m_ieHwnd) & ") ctrl_sub=" & TbEditSub.IsInstalled

        ' degradation contract: the editor is IE8-pinned (emulation 8888).
        ' TbEdit/TbEditSub use only the IE8-era DOM (document.selection,
        ' TextRange, outerHTML, elementFromPoint) and an IE7-safe CSS
        ' subset; the gates below exercise the full editing surface in
        ' that mode. designMode's document rebuild drops the standards
        ' declaration, so the practical mode is IE8 quirks (5); 8 = IE8
        ' standards would be fine too - anything else fails
        Dim dm As String
        dm = m_Ed.DocModeNumber()
        RAssert "Editor.docmode", (StrComp(dm, "5", vbBinaryCompare) = 0) Or (StrComp(dm, "8", vbBinaryCompare) = 0), _
            "documentMode='" & dm & "' (expected 5 = IE8 quirks after the designMode rebuild, 8 = IE8 standards; '' = pre-IE8 host)"

        GateRoundtrip
        GateFormatExec
        GatePasteClean
        GateLinkCtrlClick
        GateEditorCss
        GateInspectorRules
        GatePersistAndSemantics
        GateRecycleBin
        ' GateP5B re-enabled for the 0xC0000409 fast-fail hunt (WER LocalDumps
        ' armed); the crash lands after GateRecycleEmpty, before [ph2] frame
        GateP5B
        ' GateCrashlog
        Exit Sub
fail:
        m_fail = m_fail + 1
        WLog "[EditorGates.hardFail] err=" & Err.Number & " " & Err.Description
    End Sub

    ' Editor.roundtrip: load -> read back -> content equivalence + stability.
    ' MSHTML edit-mode serialization puts CRLF between BLOCK elements and
    ' uppercases tags, so the text comparison strips ALL whitespace from
    ' both sides (proves no characters gained/lost), tag counts are compared
    ' case-insensitively, and the serialization must be CONVERGED (stable
    ' from the second set/read cycle on - no unbounded open/save drift).
    Private Sub GateRoundtrip()
        On Error GoTo fail
        Dim src As String
        src = m_Repo.DocHtml(0)
        If Len(src) = 0 Then src = SRichProbeHtml()
        m_Ed.SetHtml src
        Dim rb1 As String, rb2 As String, rb3 As String
        rb1 = m_Ed.GetHtml()
        m_Ed.SetHtml rb1
        rb2 = m_Ed.GetHtml()
        m_Ed.SetHtml rb2
        rb3 = m_Ed.GetHtml()

        Dim textEq As Boolean, tagEq As Boolean
        textEq = (StrComp(TextFingerprint(m_Repo.HtmlToText(src)), TextFingerprint(m_Repo.HtmlToText(rb1)), vbBinaryCompare) = 0)
        Dim badTag As String
        ' MSHTML designMode appends a caret-holder empty paragraph to the
        ' document - empty paragraphs carry no content, strip them on BOTH
        ' sides before counting
        tagEq = TagCountsEqual(StripEmptyParagraphs(src), StripEmptyParagraphs(rb1), badTag)
        Dim idem As Boolean
        idem = (StrComp(rb2, rb3, vbBinaryCompare) = 0)

        RAssert "Editor.roundtrip", textEq And tagEq And idem, _
            "textEq(whitespace-free)=" & textEq & " tagEq=" & tagEq & " tagDiff='" & badTag & "' converged=" & idem & _
            " srcLen=" & Len(src) & " rb1Len=" & Len(rb1) & " rb2Len=" & Len(rb2) & " rb3Len=" & Len(rb3) & _
            " (normalizations: uppercase tags + CRLF between blocks + entity re-escaping; save path re-lowercases via TbClean - RESULTS)"
        Exit Sub
fail:
        RAssert "Editor.roundtrip", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' removes <p> elements whose content is only whitespace/<br>/&nbsp;
    ' (caret holders MSHTML appends in design mode; the trailing holder can
    ' come WITHOUT its close tag)
    Private Function StripEmptyParagraphs(ByVal html As String) As String
        Dim res As String
        res = html
        Dim p As Long, e As Long, tagEnd As Long
        Dim inner As String
        Dim changed As Boolean
        Do
            changed = False
            p = InStr(1, res, "<p", vbTextCompare)
            Do While p > 0
                ' only a real <p> open: next char is ">" or an attribute
                ' space (never "/" - that would be a closing tag)
                Dim nx As String
                nx = Mid$(res, p + 2, 1)
                If nx = ">" Or nx = " " Then
                    tagEnd = InStr(p, res, ">", vbBinaryCompare)
                    e = InStr(tagEnd + 1, res, "</p", vbTextCompare)
                    If tagEnd > 0 And e > 0 Then
                        inner = Mid$(res, tagEnd + 1, e - tagEnd - 1)
                        If IsBlankPara(inner) Then
                            e = InStr(e, res, ">", vbBinaryCompare)
                            res = Left$(res, p - 1) & Mid$(res, e + 1)
                            changed = True
                            Exit Do
                        End If
                    ElseIf tagEnd > 0 Then
                        ' unclosed: blank tail = caret holder at doc end
                        inner = Mid$(res, tagEnd + 1)
                        If IsBlankPara(inner) Then
                            res = Left$(res, p - 1)
                            changed = True
                            Exit Do
                        End If
                    End If
                End If
                p = InStr(p + 1, res, "<p", vbTextCompare)
            Loop
        Loop While changed
        StripEmptyParagraphs = res
    End Function

    ' True when s contains nothing but whitespace, <br>-variants, &nbsp;
    Private Function IsBlankPara(ByVal s As String) As Boolean
        Dim t As String
        t = s
        Dim p As Long
        ' drop <br ...> variants
        Do
            p = InStr(1, t, "<br", vbTextCompare)
            If p = 0 Then Exit Do
            Dim e As Long
            e = InStr(p, t, ">", vbBinaryCompare)
            If e = 0 Then Exit Do
            t = Left$(t, p - 1) & Mid$(t, e + 1)
        Loop
        t = Replace(t, "&nbsp;", "", , , vbTextCompare)
        t = Replace(t, " ", "")
        t = Replace(t, vbCr, "")
        t = Replace(t, vbLf, "")
        t = Replace(t, vbTab, "")
        IsBlankPara = (Len(t) = 0)
    End Function

    ' letters/digits/CJK only - whitespace-insensitive content fingerprint
    Private Function TextFingerprint(ByVal s As String) As String
        Dim L As Long, i As Long, p As Long
        Dim ch As String
        Dim out As String
        L = Len(s)
        If L = 0 Then Exit Function
        out = Space$(L)
        p = 0
        For i = 1 To L
            ch = Mid$(s, i, 1)
            If (ch >= "0" And ch <= "9") Or (ch >= "a" And ch <= "z") Or (ch >= "A" And ch <= "Z") Or AscW(ch) > 255 Then
                p = p + 1
                Mid$(out, p, 1) = ch
            End If
        Next
        TextFingerprint = Left$(out, p)
    End Function

    ' tag open+close count equality over the editor whitelist; badTag
    ' returns the first mismatching tag name
    Private Function TagCountsEqual(ByVal a As String, ByVal b As String, ByRef badTag As String) As Boolean
        Dim tags As String, i As Long, p As Long, nm As String
        tags = "p,br,b,i,u,s,strike,h1,h2,h3,ul,ol,li,blockquote,pre,code,hr,a,img,table,tr,td,th,div,span,strong,em"
        TagCountsEqual = True
        badTag = ""
        p = 1
        Do While p <= Len(tags)
            i = InStr(p, tags, ",")
            If i = 0 Then i = Len(tags) + 1
            nm = Mid$(tags, p, i - p)
            If CountTag(a, nm) <> CountTag(b, nm) Then
                TagCountsEqual = False
                badTag = nm & "(" & CountTag(a, nm) & "->" & CountTag(b, nm) & ")"
                Exit Function
            End If
            p = i + 1
        Loop
    End Function

    ' open-tag occurrences only (paired tags: opens == closes in balanced
    ' html; void tags have no closes) - avoids close-tag asymmetries
    Private Function CountTag(ByVal html As String, ByVal nm As String) As Long
        Dim c As Long, p As Long
        c = 0
        p = InStr(1, html, "<" & nm, vbTextCompare)
        Do While p > 0
            If p + Len(nm) + 1 > Len(html) Then
                c = c + 1
            Else
                Select Case Mid$(html, p + 1 + Len(nm), 1)
                    Case " ", ">", vbTab, vbCr, vbLf
                        c = c + 1
                End Select
            End If
            p = InStr(p + 1, html, "<" & nm, vbTextCompare)
        Loop
        CountTag = c
    End Function

    ' Format.exec: >=6 commands flip their queryCommandState
    Private Sub GateFormatExec()
        On Error GoTo fail
        m_Ed.SetHtml "<p>format probe text</p>"
        m_Ed.SelectAll
        Dim flips As Long
        flips = 0
        If TestFlip("bold") Then flips = flips + 1
        If TestFlip("italic") Then flips = flips + 1
        If TestFlip("strikeThrough") Then flips = flips + 1
        If TestFlip("underline") Then flips = flips + 1
        If TestFlip("insertUnorderedList") Then flips = flips + 1
        If TestFlip("insertOrderedList") Then flips = flips + 1
        RAssert "Format.exec", flips >= 6, "bold/italic/strike/underline/ul/ol queryCommandState flipped=" & flips & "/6 (detail lines above)"
        Exit Sub
fail:
        RAssert "Format.exec", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    Private Function TestFlip(ByVal cmd As String) As Boolean
        On Error Resume Next
        Dim before As Boolean, after As Boolean
        before = m_Ed.QueryState(cmd)
        m_Ed.Exec cmd, ""
        after = m_Ed.QueryState(cmd)
        WLog "[Format.exec] " & cmd & " " & before & "->" & after
        TestFlip = (before <> after)
    End Function

    ' Paste.clean: garbage in -> same clean pass as the save path -> none left
    Private Sub GatePasteClean()
        On Error GoTo fail
        Dim garbage As String
        ' NOTE: the iframe carries NO src - a relative src like "x" makes
        ' Trident resolve "about:x" and NAVIGATE the whole editor document
        ' away (observed as a doccomplete url=about:x + blank editor)
        garbage = "<p>before<script>evil()</script><o:p></o:p><style>.x{}</style>" & _
            "<span onmouseover=""x()"">mid</span>" & _
            "<a href=""javascript:alert(1)"">bad</a><!-- comment -->" & _
            "<p class=""MsoNormal"">after</p><iframe></iframe>"

        Dim cln As String
        cln = m_Ed.CleanHtml(garbage)
        Dim ok As Boolean
        ok = (InStr(1, cln, "<script", vbTextCompare) = 0)
        ok = ok And (InStr(1, cln, "<o:p", vbTextCompare) = 0)
        ok = ok And (InStr(1, cln, "<style", vbTextCompare) = 0)
        ok = ok And (InStr(1, cln, "onmouseover", vbTextCompare) = 0)
        ok = ok And (InStr(1, cln, "javascript:", vbTextCompare) = 0)
        ok = ok And (InStr(1, cln, "<!--", vbBinaryCompare) = 0)
        ok = ok And (InStr(1, cln, "MsoNormal", vbBinaryCompare) = 0)
        ok = ok And (InStr(1, cln, "<iframe", vbTextCompare) = 0)
        Dim keep As Boolean
        keep = (InStr(cln, "before") > 0) And (InStr(cln, "mid") > 0) And (InStr(cln, "after") > 0)

        ' in-place path: simulated paste result in the editor body, then the
        ' same routine the 720ms poll calls
        m_Ed.SetHtml garbage
        PollPasteCleanForce
        Dim rb As String
        rb = m_Ed.GetHtml()
        Dim ok2 As Boolean
        ok2 = (InStr(1, rb, "<script", vbTextCompare) = 0) And (InStr(1, rb, "<o:p", vbTextCompare) = 0) _
            And (InStr(1, rb, "<style", vbTextCompare) = 0) And (InStr(1, rb, "<iframe", vbTextCompare) = 0)

        RAssert "Paste.clean", ok And keep And ok2, _
            "script/o:p/style/on*/js-url/comment/Mso/iframe stripped, text kept, in-place poll path exercised"
        Exit Sub
fail:
        RAssert "Paste.clean", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' the gate's in-place variant of the poll (no timing gate)
    Private Sub PollPasteCleanForce()
        On Error Resume Next
        Dim cur As String, cln As String
        cur = m_Ed.GetHtml()
        cln = m_Ed.CleanHtml(cur)
        If StrComp(cln, cur, vbBinaryCompare) <> 0 Then
            m_Ed.SetHtml cln
        End If
    End Sub

    ' Link.ctrlclick: synthesize the Ctrl+click path on a probe URL
    Private Sub GateLinkCtrlClick()
        On Error GoTo fail
        m_Ed.SetHtml "<p>link <a href=""http://p3-gate.invalid/"">gatelog</a> probe</p>"
        m_openProbe = True
        m_lastLinkUrl = ""
        Dim lx As Long, ly As Long, found As Boolean
        found = m_Ed.FirstAnchorRect(lx, ly)
        If found Then OnEditClick lx, ly
        m_openProbe = False
        RAssert "Link.ctrlclick", found And (StrComp(m_lastLinkUrl, "http://p3-gate.invalid/", vbBinaryCompare) = 0), _
            "TbEditSub WM_LBUTTONUP route -> elementFromPoint ancestor walk -> ShellExecute path (probe url='" & m_lastLinkUrl & "', browser NOT launched)"

        ' Link.nativeDlg: drive the modal LinkDlg (GateUrl makes it
        ' auto-type + auto-OK on first activate, exercising the real
        ' txtUrl/cmdOK path), assert the link landed in the editor html
        m_Ed.SetHtml "<p>gate dialog probe</p>"
        m_Ed.SelectAll
        Dim selLen As Long
        selLen = Len(m_Ed.SelectionText())
        LinkDlg.GateUrl = "gate.example.com"
        OpenLinkDialog
        Dim okDlg As Boolean
        okDlg = LinkDlg.Confirmed And (InStr(1, m_Ed.GetHtml(), "gate.example.com", vbTextCompare) > 0)
        WLog "[Link.dbg] selLenBefore=" & selLen & " selLenAfter=" & Len(m_Ed.SelectionText()) & " htmlAfter='" & Left$(m_Ed.GetHtml(), 220) & "'"
        RAssert "Link.nativeDlg", okDlg, _
            "modal dialog open->OK->inserted=" & (InStr(1, m_Ed.GetHtml(), "gate.example.com", vbTextCompare) > 0) & " confirmed=" & LinkDlg.Confirmed
        ' restore the dirty baseline so later saves don't persist probe html
        m_Ed.SetHtml m_loadedHtml
        Exit Sub
fail:
        m_openProbe = False
        RAssert "Link.ctrlclick", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' Theme.editor_css: style-element injection switches the body paper
    ' AND (P6) the font chain: SimSun first, !important to beat the
    ' MSHTML edit-mode default (per-script IEPropFont on a Chinese system)
    Private Sub GateEditorCss()
        On Error GoTo fail
        m_Ed.ApplyTheme True
        Dim bg1 As String, bg2 As String
        bg1 = LCase$(m_Ed.BodyBackground())
        m_Ed.ApplyTheme False
        bg2 = LCase$(m_Ed.BodyBackground())
        Dim ff As String, css As String
        ff = LCase$(m_Ed.BodyFontFamily())
        css = LCase$(m_Ed.LastCss())
        Dim fontOk As Boolean
        fontOk = (InStr(css, "simsun") > 0) And (InStr(css, "!important") > 0) _
                 And (InStr(ff, "simsun") > 0)
        ApplyEditorTheme
        RAssert "Theme.editor_css", (bg1 = "#202429") And (bg2 = "#ffffff") And fontOk, _
            "graphite body bg=" & bg1 & " blue body bg=" & bg2 & _
            " fontChain live=" & (InStr(ff, "simsun") > 0) & " css has simsun+important=" & ((InStr(css, "simsun") > 0) And (InStr(css, "!important") > 0)) & _
            " (SimSun -> YaHei !important; MSHTML edit default beaten)"
        Exit Sub
fail:
        ApplyEditorTheme
        RAssert "Theme.editor_css", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' Inspector.rules: 16 rules, each flags its violation and passes its
    ' clean sample
    Private Sub GateInspectorRules()
        On Error GoTo fail
        Dim cln As TbClean
        Set cln = m_Ed.Cleaner()
        Dim okAll As Boolean, bad As String
        okAll = True
        Dim i As Long
        For i = 1 To 16
            Dim badOk As Boolean, goodOk As Boolean
            badOk = Not cln.RuleCheck(i, RuleBadSample(i))
            goodOk = cln.RuleCheck(i, RuleGoodSample(i))
            WLog "[Inspector.rules] " & cln.RuleName(i) & " bad-flagged=" & badOk & " good-passed=" & goodOk
            If Not (badOk And goodOk) Then
                okAll = False
                bad = bad & " R" & Format$(i, "00")
            End If
        Next
        RAssert "Inspector.rules", okAll, "16 rules x (violation flagged + clean sample passed); rebuilt rule set (no 16-rule source on disk - RESULTS)" & bad
        Exit Sub
fail:
        RAssert "Inspector.rules", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    Private Function RuleBadSample(ByVal i As Long) As String
        Select Case i
            Case 1: RuleBadSample = "<p>a<script>alert(1)</script></p>"
            Case 2: RuleBadSample = "<p><iframe src=""x""></iframe></p>"
            Case 3: RuleBadSample = "<p><object></object><embed src=""x""></embed></p>"
            Case 4: RuleBadSample = "<style>p{color:red}</style><p>a</p>"
            Case 5: RuleBadSample = "<base href=""x""><meta charset=""utf-8""><link rel=""a"" href=""y""><p>a</p>"
            Case 6: RuleBadSample = "<form><input type=""text""><button>b</button><select></select><textarea></textarea></form>"
            Case 7: RuleBadSample = "<p onclick=""x()"">a</p>"
            Case 8: RuleBadSample = "<a href=""javascript:alert(1)"">a</a>"
            Case 9: RuleBadSample = "<o:p></o:p><w:sdt></w:sdt><st1:place></st1:place><p>a</p>"
            Case 10: RuleBadSample = "<p class=""MsoNormal"">a</p>"
            Case 11: RuleBadSample = "<?xml version=""1.0""?><xml><a>x</a></xml><p>a</p>"
            Case 12: RuleBadSample = "<p>a<!-- c --></p>"
            Case 13: RuleBadSample = "<p><video src=""x""></video></p>"
            Case 14: RuleBadSample = "<p draggable=""true"">a</p>"
            Case 15: RuleBadSample = "<img src=""file:///C:/x.png"">"
            Case 16: RuleBadSample = "<applet code=""x""></applet><frameset><frame src=""y""></frameset>"
        End Select
    End Function

    Private Function RuleGoodSample(ByVal i As Long) As String
        Select Case i
            Case 3: RuleGoodSample = "<p><img src=""https://x/y.png""></p>"
            Case 15: RuleGoodSample = "<img src=""https://x/y.png"">"
            Case Else: RuleGoodSample = "<p>ok</p>"
        End Select
    End Function

    ' Format.persist + Save.semantics share one temp note (deleted after)
    Private Sub GatePersistAndSemantics()
        On Error GoTo fail
        ' temp note(s) (work copy is disposable; deleted below). The empty
        ' repo has no other note to switch to - add a switch target too.
        Dim idT As String
        idT = m_Repo.AddNew("<p>persist probe</p>")
        If Left$(idT, 4) = "ERR:" Then
            RAssert "Format.persist", False, "AddNew failed: " & m_Repo.LastErr
            RAssert "Save.semantics", False, "AddNew failed: " & m_Repo.LastErr
            Exit Sub
        End If
        Dim docT As Long
        docT = m_Repo.FindDocById(idT)
        Dim idO As String
        Dim docO As Long
        docO = -1
        ' reload rebuilt the note table - the visible-pool index is stale
        ' until a filter rebuild (FindVisByDoc would miss the temp notes)
        RebuildFilterCurrent

        ' ---- Format.persist: bold + H2 on one probe, list on a second
        ' (MSHTML correctly REPLACES a block with a list when a list is
        ' applied to a heading, so the three formats are verified as two
        ' round-trips through the gateway)
        LoadNoteForEditDoc docT
        m_Ed.SetHtml "<p>persist probe</p>"
        m_Ed.SelectAll
        Dim rBold As Boolean
        rBold = m_Ed.Exec("bold", "")
        ' FormatBlock refuses a body-spanning selection - select the first
        ' block, try execCommand, and fall back to the outerHTML retag
        m_Ed.SelectFirstBlock
        Dim rFmt As Boolean
        rFmt = m_Ed.Exec("formatBlock", "<H2>")
        If StrComp(m_Ed.BlockTag(), "H2", vbTextCompare) <> 0 Then rFmt = m_Ed.SetBlockTag("H2")
        WLog "[Format.persist] exec bold=" & rBold & " formatBlock=" & rFmt & " blockTag=" & m_Ed.BlockTag()
        Dim h1 As String
        h1 = m_Ed.GetHtml()
        Dim okU As Boolean
        okU = m_Repo.UpdateHtml(idT, h1)
        Dim h2 As String
        h2 = m_Repo.DocHtml(docT)
        m_Ed.SetHtml h2
        Dim rb As String
        rb = m_Ed.GetHtml()
        Dim boldTag As String
        If InStr(1, rb, "<b>", vbTextCompare) > 0 Then
            boldTag = "<b>"
        ElseIf InStr(1, rb, "<strong>", vbTextCompare) > 0 Then
            boldTag = "<strong>"
        End If
        Dim okFmt As Boolean
        okFmt = (Len(boldTag) > 0) And (InStr(1, rb, "<h2", vbTextCompare) > 0)

        ' list sub-probe
        m_Ed.SetHtml "<p>list probe</p>"
        m_Ed.SelectAll
        m_Ed.Exec "insertUnorderedList", ""
        Dim l1 As String
        l1 = m_Ed.GetHtml()
        Dim okU2 As Boolean
        okU2 = m_Repo.UpdateHtml(idT, l1)
        m_Ed.SetHtml m_Repo.DocHtml(docT)
        Dim rb2 As String
        rb2 = m_Ed.GetHtml()
        Dim okLi As Boolean
        okLi = okU2 And (InStr(1, rb2, "<li", vbTextCompare) > 0) And (InStr(1, rb2, "<ul", vbTextCompare) > 0)

        RAssert "Format.persist", okU And okFmt And okLi, _
            "bold(" & boldTag & ")+h2 kept=" & okFmt & ", ul+li kept=" & okLi & ", saves okU=" & okU & " okU2=" & okU2 & _
            " rb=''" & Left$(rb, 80) & "'' rb2=''" & Left$(rb2, 80) & "'' lastErr=[" & m_Repo.LastErr & "]"

        ' ---- Save.semantics: modify -> switch away (saves) -> switch back
        Dim modHtml As String
        modHtml = "<p>semantics probe " & Format$(Now, "hhnnss") & "</p>"
        m_Ed.SetHtml modHtml
        ' load baseline still points at the loaded note -> dirty at switch
        Dim other As Long
        If docO >= 0 Then
            other = docO
        Else
            other = 0
            If other = docT Then other = 1
        End If
        If other >= 0 And other < m_Repo.TotalCount Then
            ' switch to a note in the visible pool. Format.persist's saves
            ' ran LoadAll - the pool is stale-zeroed until this rebuild:
            ' FindVisByDoc would miss, and the row-0 fallback hits the
            ' same-row shortcut when the temp note IS doc 0 (empty repo).
            m_Repo.RebuildFilter EffectiveQuery(), ChipTagName(m_chipSel)
            Dim v As Long
            v = m_Repo.FindVisByDoc(other)
            If v < 0 Then v = 0
            SelectVisible v
            Dim okSaved As Boolean
            okSaved = InStr(1, m_Repo.DocHtml(docT), "semantics probe", vbBinaryCompare) > 0
            ' the save reloaded the note table - rebuild the visible pool
            ' before looking up the temp note's row again
            m_Repo.RebuildFilter EffectiveQuery(), ChipTagName(m_chipSel)
            ' switch back
            Dim vT As Long
            vT = m_Repo.FindVisByDoc(docT)
            If vT >= 0 Then SelectVisible vT
            Dim okBack As Boolean
            okBack = InStr(1, m_Ed.GetHtml(), "semantics probe", vbBinaryCompare) > 0
            RAssert "Save.semantics", okSaved And okBack, _
                "edit -> switch away (auto-saved=" & okSaved & ") -> switch back (content kept=" & okBack & ")"
        Else
            RAssert "Save.semantics", False, "no second note to switch to"
        End If

        ' cleanup: remove the temp note(s) (work copy tombstones fine), then
        ' back to the top of the list so no selection/scroll residue leaks
        ' into the screenshot
        m_Repo.DeleteNote idT
        If Len(idO) > 0 Then m_Repo.DeleteNote idO
        m_loadDoc = -1
        m_sel = 0
        m_offset = 0
        RebuildFilterCurrent
        ClampScroll
        LoadNoteForEdit
        RedrawAll "gate_cleanup"     ' the list/status would keep the stale
                                     ' pre-cleanup paint otherwise
        Exit Sub
fail:
        RAssert "Format.persist", False, "err=" & Err.Number & " " & Err.Description
        RAssert "Save.semantics", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' ================================================== P5-A gates
    ' Recycle bin + pin wiring, all on temp notes (work copy; every gate
    ' removes its own note, the repo content survives the run unchanged).

    ' "<deleted_note " tombstone count of the WORK copy file (the original
    ' under D:\Documents is never touched).
    Private Function TombstoneCountR() As Long
        On Error Resume Next
        Dim b() As Byte
        If ReadBytesF(WorkRepo, b) Then
            TombstoneCountR = CountSubStr(m_U8.Decode(b), "<deleted_note ")
        End If
    End Function

    Private Sub GateRecycleBin()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then
            RAssert "Delete.soft", False, "repo not open"
            RAssert "Pin.toggle", False, "repo not open"
            RAssert "Purge.hard", False, "repo not open"
            Exit Sub
        End If

        ' ---------- Delete.soft: temp note -> REAL UI path (ConfirmDlg with
        ' GateAnswer auto-OK) -> InRecyclingBin=True, pool net unchanged ->
        ' bin view shows it -> restore through the real UI path -> visible
        ' again in the normal pool
        Dim nonBin0 As Long
        nonBin0 = m_Repo.NonBinCount
        Dim idD As String
        idD = m_Repo.AddNew("<p>gate softdel probe " & Format$(Now, "hhnnss") & "</p>")
        If Left$(idD, 4) = "ERR:" Then
            RAssert "Delete.soft", False, "AddNew failed: " & m_Repo.LastErr
            GoTo pinGate
        End If
        RebuildFilterCurrent
        Dim docD As Long
        docD = m_Repo.FindDocById(idD)
        Dim vD As Long
        vD = m_Repo.FindVisByDoc(docD)
        Dim okSoft As Boolean
        Dim detSoft As String
        If vD < 0 Then
            RAssert "Delete.soft", False, "temp note not visible after rebuild"
        Else
            m_sel = vD
            m_offset = 0
            DeleteSelectedFromUi          ' bin mode off -> soft-delete path
            RebuildFilterCurrent
            ' soft delete: flag set, pool -1 vs post-add, gone from pool
            okSoft = (docD >= 0) And (docD < m_Repo.TotalCount) And m_Repo.NoteBin(docD)
            okSoft = okSoft And (m_Repo.NonBinCount = nonBin0)   ' +1 add, -1 binned
            okSoft = okSoft And (m_Repo.FindVisByDoc(docD) < 0)  ' gone from pool
            detSoft = "bin=" & m_Repo.NoteBin(docD) & " pool=" & m_Repo.NonBinCount & "(postadd " & (nonBin0 + 1) & ")"
            ' recycle-bin view (pseudo picker entry): the binned note shows
            m_binMode = True
            m_loadDoc = -1                 ' bin rows never load into the editor
            RebuildFilterCurrent
            okSoft = okSoft And (m_Repo.FindVisByDoc(docD) >= 0)
            ' restore through the real UI path (Ctrl+R handler body)
            Dim vB As Long
            vB = m_Repo.FindVisByDoc(docD)
            If vB >= 0 Then
                m_sel = vB
                RestoreSelectedFromBin
                RebuildFilterCurrent
                okSoft = okSoft And Not m_Repo.NoteBin(docD)
            Else
                okSoft = False
            End If
            ' back to the normal entry: the note is visible again
            m_binMode = False
            RebuildFilterCurrent
            okSoft = okSoft And (m_Repo.FindVisByDoc(docD) >= 0)
            RAssert "Delete.soft", okSoft, detSoft & " binView+restore+back visible=" & (m_Repo.FindVisByDoc(docD) >= 0) & " binTotal=" & m_Repo.BinCount
        End If
        m_Repo.DeleteNote idD              ' temp note out (tombstone ok)
        RebuildFilterCurrent

pinGate:
        ' ---------- Pin.toggle: temp note -> real UI path (Ctrl+P handler
        ' body) -> CountPinned +1 -> unpin -> +1 note removed
        Dim pin0 As Long
        pin0 = m_Repo.CountPinned()
        Dim idP As String
        idP = m_Repo.AddNew("<p>gate pin probe " & Format$(Now, "hhnnss") & "</p>")
        If Left$(idP, 4) = "ERR:" Then
            RAssert "Pin.toggle", False, "AddNew failed: " & m_Repo.LastErr
            GoTo purgeGate
        End If
        RebuildFilterCurrent
        Dim vP As Long
        vP = m_Repo.FindVisByDoc(m_Repo.FindDocById(idP))
        Dim okPin As Boolean
        If vP < 0 Then
            RAssert "Pin.toggle", False, "temp note not visible after rebuild"
        Else
            m_sel = vP
            TogglePinFromUi
            RebuildFilterCurrent
            Dim docP As Long
            docP = m_Repo.FindDocById(idP)
            okPin = (docP >= 0) And m_Repo.NotePin(docP) And (m_Repo.CountPinned() = pin0 + 1)
            RAssert "Pin.toggle", okPin, _
                "pinned=" & m_Repo.NotePin(docP) & " countPinned " & pin0 & "->" & m_Repo.CountPinned() & " (persisted via gateway+save+reload)"
            m_Repo.SetPinnedSave idP, False    ' restore
            RebuildFilterCurrent
            okPin = okPin And (m_Repo.CountPinned() = pin0) And Not m_Repo.NotePin(docP)
        End If
        m_Repo.DeleteNote idP
        RebuildFilterCurrent

purgeGate:
        ' ---------- Purge.hard: soft-delete a temp note, then PERMANENT
        ' delete through the real UI path (ConfirmDlg auto-OK) -> note gone
        ' AND the work file gains exactly one <deleted_note tombstone
        Dim total0 As Long
        total0 = m_Repo.TotalCount
        Dim del0 As Long
        del0 = TombstoneCountR()
        Dim idX As String
        idX = m_Repo.AddNew("<p>gate purge probe " & Format$(Now, "hhnnss") & "</p>")
        If Left$(idX, 4) = "ERR:" Then
            RAssert "Purge.hard", False, "AddNew failed: " & m_Repo.LastErr
            GoTo binStateRestore
        End If
        Dim rcBin As String
        rcBin = m_Repo.SetNoteRecycling(idX, True)  ' soft delete (data layer; the
                                           ' UI soft-delete path is Delete.soft's)
        m_loadDoc = -1                     ' purge shifts doc indices
        RebuildFilterCurrent
        m_binMode = True
        RebuildFilterCurrent
        Dim vX As Long
        vX = m_Repo.FindVisByDoc(m_Repo.FindDocById(idX))
        Dim okPurge As Boolean
        If vX < 0 Then
            RAssert "Purge.hard", False, "binned temp note not visible in bin view rc=[" & rcBin & "] lastErr=[" & m_Repo.LastErr & "] found=" & m_Repo.FindDocById(idX) & " bin=" & m_Repo.BinCount
        Else
            m_sel = vX
            PurgeSelectedFromBin           ' ConfirmDlg auto-OK -> DeleteNote
            RebuildFilterCurrent
            Dim del1 As Long
            del1 = TombstoneCountR()
            okPurge = (m_Repo.FindDocById(idX) < 0) And (m_Repo.TotalCount = total0) And (del1 = del0 + 1)
            RAssert "Purge.hard", okPurge, _
                "total " & total0 & "->" & m_Repo.TotalCount & " tombstones " & del0 & "->" & del1 & " (deleted_note in work file, read back)"
        End If

binStateRestore:
        ' leave the picker on the normal entry, selection on row 0; the
        ' editor re-syncs with the (possibly shifted) pool
        m_binMode = False
        RebuildFilterCurrent
        m_sel = 0
        m_offset = 0
        LoadNoteForEdit
        RedrawAll "gate_recycle_cleanup"
        Exit Sub
fail:
        RAssert "Delete.soft", False, "err=" & Err.Number & " " & Err.Description
        m_binMode = False
        m_loadDoc = -1
        RebuildFilterCurrent
        m_sel = 0
        m_offset = 0
        LoadNoteForEdit
    End Sub

    ' Crashlog.wired: TbLog.AppendEntry through a TEMP path (the real
    ' crash.log under the data directory is never touched by gates) -
    ' write, read back byte-wise, assert marker + format tail.
    Private Sub GateCrashlog()
        On Error GoTo fail
        Dim p As String
        p = P3Dir & "\crash_gate.tmp.log"
        On Error Resume Next
        Kill p
        Err.Clear
        On Error GoTo fail

        ' the wired failure exits resolve the data directory + file name
        ' (asserted WITHOUT writing - no test entries in the real log)
        Dim realPath As String
        realPath = CrashLogPathR()
        Dim pathOk As Boolean
        pathOk = (Len(realPath) > 10) And (StrComp(Right$(realPath, 10), "\crash.log", vbBinaryCompare) = 0)

        Dim lg As TbLog
        Set lg = New TbLog
        Dim marker As String
        marker = "crashlog pipe probe " & Format$(Now, "hhnnss")
        Dim okW As Boolean
        okW = lg.AppendEntry(p, "[gate] " & marker)
        Dim b() As Byte
        Dim back As String
        Dim okR As Boolean
        If ReadBytesF(p, b) Then
            back = m_U8.Decode(b)
            okR = (InStr(1, back, marker, vbBinaryCompare) > 0) _
                And (Left$(back, 1) = "[") _
                And (Right$(back, 4) = vbCrLf & vbCrLf)
        End If
        RAssert "Crashlog.wired", okW And okR And pathOk, _
            "AppendEntry->readback marker=" & okR & " format=[ts]+CRLFCRLF=" & (Right$(back, 4) = vbCrLf & vbCrLf) & " exitpath='" & realPath & "' (datadir root, not written)"
        On Error Resume Next
        Kill p
        Exit Sub
fail:
        RAssert "Crashlog.wired", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' ================================================== P5-B gates
    ' Safe UI wiring + import backup + data directory + bin empty, all on
    ' TEMP notes/safes (the work copy is disposable; every gate removes its
    ' own fixtures and rebuilds the filter - pit 9/17). No REAL password is
    ' ever used here: the roundtrip gate unlocks its own throwaway safe
    ' created moments before through the same dialog path.

    ' Safe.list: gateway ListSafes count == the XML's <safe id= count of the
    ' source repository (counted live, never hardcoded); encrypted-note
    ' count (<safe> elements inside notes) goes into the detail.
    Private Sub GateSafeList()
        On Error GoTo fail
        SyncEnsureInfra
        m_Repo.AttachCrypto m_Ck, m_Crypto
        Dim rows As Long, nXml As Long, nEnc As Long
        rows = m_Repo.SafeCount()
        Dim rawList As String
        rawList = m_Repo.SafeList()
        Dim srcTxt As String, b() As Byte
        If ReadBytesF(WorkRepo, b) Then
            srcTxt = m_U8.Decode(b)
            nXml = CountSubStr(srcTxt, "<safe id=")
            nEnc = CountSubStr(srcTxt, "<safe>")
        End If
        RAssert "Safe.list", (rows = nXml), _
            "safes=" & rows & " xml=" & nXml & " encryptedNotes=" & nEnc & " raw=[" & rawList & "] lastErr=[" & m_Repo.LastErr & "]"
        Exit Sub
fail:
        RAssert "Safe.list", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' Safe.open_wrongpw: a wrong password must come back as the
    ' recognizable ERR:wrong_password and open NOTHING.
    Private Sub GateSafeWrongPw()
        On Error GoTo fail
        Dim r As String
        r = m_Repo.SafeOpenAll("Gate-Wrong-Pw-99x")
        Dim okE As Boolean
        okE = (Left$(r, 4) = "ERR:") And (InStr(1, r, "wrong_password", vbBinaryCompare) > 0)
        okE = okE And (Len(m_Repo.SafeFirstOpenId()) = 0)
        Dim sid0 As String
        sid0 = FirstSafeIdFromList()
        If Len(sid0) > 0 Then okE = okE And (Not m_Repo.SafeIsOpen(sid0))
        RAssert "Safe.open_wrongpw", okE, "res=" & r & " firstOpenEmpty=" & (Len(m_Repo.SafeFirstOpenId()) = 0)
        Exit Sub
fail:
        RAssert "Safe.open_wrongpw", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    Private Function FirstSafeIdFromList() As String
        On Error Resume Next
        Dim s As String
        s = m_Repo.SafeList()
        FirstSafeIdFromList = ""
        If Left$(s, 4) = "ERR:" Or Len(s) = 0 Then Exit Function
        Dim rows() As String
        rows = Split(s, ChrW$(31))
        Dim f() As String
        f = Split(rows(0), "|")
        If UBound(f) >= 0 Then FirstSafeIdFromList = f(0)
    End Function

    ' Safe.ui_roundtrip: TEMP safe through the REAL SafeDlg create path ->
    ' temp note encrypted into it (SafeId + cipher persisted in the work
    ' file, list title decrypted) -> lock all (editor placeholder + save
    ' guard) -> unlock through the REAL SafeDlg path with the throwaway
    ' gate password -> editor shows plain -> tB save re-encrypts
    ' transparently -> un-encrypt -> full cleanup (note + safe removed).
    Private Sub GateSafeRoundtrip()
        On Error GoTo fail
        Dim n0 As Long, total0 As Long
        n0 = m_Repo.SafeCount()
        total0 = m_Repo.TotalCount
        Dim idN As String, idS As String, docN As Long

        ' ---- create through the real dialog (auto-answered)
        ShowSafeDialog "create:GatePw12345"
        Dim createdOk As Boolean
        idS = SafeDlg.CreatedSafeId
        createdOk = (StrComp(SafeDlg.Action, "created", vbTextCompare) = 0) _
            And (Len(idS) > 0) And (m_Repo.SafeCount() = n0 + 1)
        If Not createdOk Then
            RAssert "Safe.ui_roundtrip", False, "create failed action=" & SafeDlg.Action & " lastErr=" & SafeDlg.LastErr
            GoTo cleanup
        End If

        ' ---- temp note -> encrypt into the temp safe
        idN = m_Repo.AddNew("<h1>safe gate note</h1><p>roundtrip body " & Format$(Now, "hhnnss") & "</p>")
        If Left$(idN, 4) = "ERR:" Then
            RAssert "Safe.ui_roundtrip", False, "AddNew failed: " & m_Repo.LastErr
            GoTo cleanup
        End If
        RebuildFilterCurrent
        docN = m_Repo.FindDocById(idN)
        Dim rE As String
        rE = m_Repo.EncryptToSafe(idN, idS)
        RebuildFilterCurrent
        docN = m_Repo.FindDocById(idN)
        Dim encOk As Boolean
        encOk = (Len(rE) = 0) And (docN >= 0) And m_Repo.NoteSafe(docN) _
            And (StrComp(m_Repo.NoteSafeId(docN), idS, vbTextCompare) = 0)
        Dim b() As Byte, sXml As String
        If ReadBytesF(WorkRepo, b) Then
            sXml = m_U8.Decode(b)
            ' the note-level <safe> element AND the safe key both persisted
            encOk = encOk And (InStr(1, sXml, "<safe>" & idS & "</safe>", vbBinaryCompare) > 0)
            encOk = encOk And (InStr(1, sXml, "<safe id=""" & idS & """", vbBinaryCompare) > 0)
        End If
        encOk = encOk And (InStr(1, m_Repo.NoteTitle(docN), "safe gate note", vbBinaryCompare) > 0)

        ' ---- locked state: placeholder + save guard through the editor
        m_Repo.SafeCloseAll
        RebuildFilterCurrent
        LoadNoteForEditDoc docN
        Dim lockOk As Boolean
        lockOk = m_lockedDoc
        m_Ed.SetHtml "<p>HACKED</p>"
        SaveIfDirty                        ' must no-op
        lockOk = lockOk And (Left$(m_Repo.DecryptContent(idN), 4) = "ERR:")
        lockOk = lockOk And (InStr(1, m_Repo.DocHtml(docN), "HACKED", vbBinaryCompare) = 0)

        ' ---- unlock through the real dialog with the gate password
        ShowSafeDialog "unlock:GatePw12345"
        Dim unOk As Boolean
        unOk = (StrComp(SafeDlg.Action, "unlocked", vbTextCompare) = 0) And m_Repo.SafeIsOpen(idS)
        RebuildFilterCurrent
        LoadNoteForEditDoc docN
        unOk = unOk And (InStr(1, m_Ed.GetHtml(), "roundtrip body", vbBinaryCompare) > 0)

        ' ---- tB save path re-encrypts transparently (open safe)
        m_Ed.SetHtml "<p>roundtrip body edited</p>"
        Dim upOk As Boolean
        upOk = m_Repo.UpdateHtml(idN, m_Ed.CleanHtml(m_Ed.GetHtml()))
        RebuildFilterCurrent
        docN = m_Repo.FindDocById(idN)
        Dim reOk As Boolean
        reOk = upOk
        If ReadBytesF(WorkRepo, b) Then
            sXml = m_U8.Decode(b)
            reOk = reOk And (InStr(1, sXml, "roundtrip body edited", vbBinaryCompare) = 0)  ' cipher in store
        End If
        reOk = reOk And (InStr(1, m_Repo.DecryptContent(idN), "roundtrip body edited", vbBinaryCompare) > 0)

        ' ---- un-encrypt (VB toggle down-branch through the wrapper)
        Dim rd As String
        rd = m_Repo.DecryptFromSafe(idN)
        RebuildFilterCurrent
        docN = m_Repo.FindDocById(idN)
        Dim dnOk As Boolean
        dnOk = (Len(rd) = 0) And (docN >= 0) And (Not m_Repo.NoteSafe(docN)) _
            And (InStr(1, m_Repo.DocHtml(docN), "roundtrip body edited", vbBinaryCompare) > 0)

        RAssert "Safe.ui_roundtrip", createdOk And encOk And lockOk And unOk And reOk And dnOk, _
            "create=" & createdOk & " encrypt+persist=" & encOk & " lockedGuard=" & lockOk & _
            " unlock=" & unOk & " reencrypt=" & reOk & " unencrypt=" & dnOk

cleanup:
        On Error Resume Next
        If Len(idN) > 0 Then m_Repo.DeleteNote idN
        If Len(idS) > 0 Then m_Repo.SafeRemove idS
        m_loadDoc = -1
        m_lockedDoc = False
        m_sel = 0
        m_offset = 0
        RebuildFilterCurrent
        ClampScroll
        LoadNoteForEdit
        RedrawAll "gate_safe_cleanup"
        Exit Sub
fail:
        RAssert "Safe.ui_roundtrip", False, "err=" & Err.Number & " " & Err.Description
        Resume cleanup
    End Sub

    ' Import.backup: temp backup file (a copy of the work repo) -> marker
    ' note -> REAL UI import (ConfirmDlg auto-OK + session restart) ->
    ' total count back + marker gone. Only the WORK copy is ever a target.
    Private Sub GateImportBackup()
        On Error GoTo fail
        Dim dirB As String
        dirB = P3Dir & "\sync\backups"
        If Len(Dir$(dirB, vbDirectory)) = 0 Then
            RAssert "Import.backup", False, "missing fixture dir " & dirB
            Exit Sub
        End If
        Dim bp As String
        bp = dirB & "\gate_import_" & Format$(Now, "hhnnss") & ".silentnotes"
        On Error Resume Next
        Kill bp
        On Error GoTo fail
        FileCopy WorkRepo, bp

        Dim total0 As Long
        total0 = m_Repo.TotalCount
        Dim idM As String
        idM = m_Repo.AddNew("<p>import gate marker</p>")
        RebuildFilterCurrent
        Dim grewOk As Boolean
        grewOk = (Left$(idM, 4) <> "ERR:") And (m_Repo.TotalCount = total0 + 1)

        ImportBackupFromUi bp              ' real confirm + session restart

        Dim back As Boolean
        back = m_Repo.IsOpen And (m_Repo.TotalCount = total0) And (m_Repo.FindDocById(idM) < 0)
        RAssert "Import.backup", grewOk And back, _
            "total " & total0 & "->" & m_Repo.TotalCount & " markerGone=" & (m_Repo.FindDocById(idM) < 0) & " (work copy replaced, source untouched)"
        On Error Resume Next
        Kill bp
        Exit Sub
fail:
        RAssert "Import.backup", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' DataDir.read: the settings dialog reads the effective data directory
    ' (TbDataDir); gate closes it via GateAnswer and asserts the shown
    ' value == the resolver output. The registry WRITE is never exercised.
    Private Sub GateDataDir()
        On Error GoTo fail
        Dim dd As TbDataDir
        Set dd = New TbDataDir
        Dim eff As String
        eff = dd.GetEffectiveDirectory()
        ShowDataDirDialog
        Dim okD As Boolean
        okD = (Len(eff) > 3) And (StrComp(DataDirDlg.CurrentDir, eff, vbBinaryCompare) = 0)
        RAssert "DataDir.read", okD, "effective='" & eff & "' dlg='" & DataDirDlg.CurrentDir & "' (registry write NOT exercised)"
        Exit Sub
fail:
        RAssert "DataDir.read", False, "err=" & Err.Number & " " & Err.Description
    End Sub

    ' Recycle.empty: two temp notes soft-deleted -> bin view -> the REAL
    ' empty path (ConfirmDlg auto-OK) -> total back, exactly two new
    ' tombstones, bin empty. Pre-existing bin notes are moved out of the
    ' bin first (flag flip only, no tombstones) and restored afterwards.
    Private Sub GateRecycleEmpty()
        On Error GoTo fail
        Dim total0 As Long, del0 As Long
        total0 = m_Repo.TotalCount
        del0 = TombstoneCountR()

        ' move the pre-existing bin notes aside (in_recycling_bin flips only)
        Dim keep() As String, nKeep As Long, i As Long
        ReDim keep(0 To m_Repo.TotalCount)
        For i = 0 To m_Repo.TotalCount - 1
            If m_Repo.NoteBin(i) Then
                keep(nKeep) = m_Repo.NoteId(i)
                nKeep = nKeep + 1
            End If
        Next
        For i = 0 To nKeep - 1
            m_Repo.SetNoteRecycling keep(i), False
        Next

        Dim idA As String, idB As String
        idA = m_Repo.AddNew("<p>bin empty probe A " & Format$(Now, "hhnnss") & "</p>")
        idB = m_Repo.AddNew("<p>bin empty probe B " & Format$(Now, "hhnnss") & "</p>")
        If (Left$(idA, 4) = "ERR:") Or (Left$(idB, 4) = "ERR:") Then
            RAssert "Recycle.empty", False, "AddNew failed: " & m_Repo.LastErr
            GoTo restore
        End If
        Dim rcA As String, rcB As String
        rcA = m_Repo.SetNoteRecycling(idA, True)
        rcB = m_Repo.SetNoteRecycling(idB, True)
        m_loadDoc = -1
        m_lockedDoc = False
        m_binMode = True
        RebuildFilterCurrent
        If m_Repo.BinCount <> 2 Then
            RAssert "Recycle.empty", False, "bin count " & m_Repo.BinCount & " want 2 rc=[" & rcA & "][" & rcB & "] lastErr=[" & m_Repo.LastErr & "]"
            GoTo restore
        End If

        EmptyRecycleBinFromUi              ' ConfirmDlg auto-OK in gate mode

        Dim okE As Boolean
        okE = (m_Repo.BinCount = 0) And (m_Repo.TotalCount = total0) And (TombstoneCountR() = del0 + 2)
        RAssert "Recycle.empty", okE, _
            "bin 2->" & m_Repo.BinCount & " total=" & m_Repo.TotalCount & " tombstones +" & (TombstoneCountR() - del0)

restore:
        On Error Resume Next
        If Len(idA) > 0 And (m_Repo.FindDocById(idA) >= 0) Then m_Repo.DeleteNote idA
        If Len(idB) > 0 And (m_Repo.FindDocById(idB) >= 0) Then m_Repo.DeleteNote idB
        For i = 0 To nKeep - 1
            m_Repo.SetNoteRecycling keep(i), True
        Next
        m_binMode = False
        m_loadDoc = -1
        m_lockedDoc = False
        RebuildFilterCurrent
        m_sel = 0
        m_offset = 0
        LoadNoteForEdit
        RedrawAll "gate_bin_empty_cleanup"
        Exit Sub
fail:
        RAssert "Recycle.empty", False, "err=" & Err.Number & " " & Err.Description
        m_binMode = False
        RebuildFilterCurrent
    End Sub

    Private Sub GateP5B()
        GateSafeList
        GateSafeWrongPw
        GateSafeRoundtrip
        GateImportBackup
        GateDataDir
        GateRecycleEmpty
    End Sub

    ' -syncgate gates: full synchronization round against the local WebDAV
    ' mock (mock\start-webdav.ps1). The mock-server settings come from the
    ' -syncsettings= ini; the script also passes -syncchoice=cloud so the
    ' conflict dialog auto-answers (no modal in automation).
    Private Sub GateSyncRound()
        On Error GoTo fail
        WLog "[Sync.gates] begin"
        ' snapshot the work repo: the gates mutate it (G5 replaces it with
        ' the id-patched empty fixture) - restored from this copy at gateEnd
        Dim snapPath As String
        snapPath = P3Dir & "\sync\probe\pre_sync_gate.silentnotes"
        If Len(Dir$(snapPath, vbNormal)) > 0 Then Kill snapPath
        FileCopy WorkRepo, snapPath
        ' cold-start warmup: first MergeRepositoryXml + SaveRepository do .NET JIT/CGEN
        If m_Repo.IsOpen Then
            Dim warmBytes() As Byte
            If ReadBytesF(WorkRepo, warmBytes) Then
                Dim tw As Single
                tw = Timer
                Dim warmRes As String
                warmRes = m_Repo.MergeWithCloud(B64OfBytes(warmBytes))
                WLog "[Sync.warmup] merge cold-call +" & Format(Timer - tw, "0.00") & "s head=" & Left$(warmRes, 16)
                m_Repo.SaveNow
                WLog "[Sync.warmup] save cold-call +" & Format(Timer - tw, "0.00") & "s"
                Dim warmRes2 As String
                warmRes2 = m_Repo.MergeWithCloud(B64OfBytes(warmBytes))
                WLog "[Sync.warmup] merge2 +" & Format(Timer - tw, "0.00") & "s head=" & Left$(warmRes2, 16)
            End If
        End If
        If Not SyncEnsureInfra() Then
            RAssert "Sync.infra", False, "chilkat/crypto/transfer init failed"
            Exit Sub
        End If
        RAssert "Sync.infra", True, "chilkat actx + Crypt2 + Gzip ready"

        ' ---- G1 transfer crypto (no server): roundtrip + header + wrong code
        Dim sample() As Byte
        sample = m_U8.Encode("<?xml version=""1.0"" encoding=""utf-8""?><silentnotes id=""gate"">probe</silentnotes>")
        Dim code As String
        code = SyncGateCode()
        Dim packed() As Byte
        If Not m_Transfer.EncryptRepo(sample, code, packed) Then
            RAssert "Sync.transfer_crypto", False, "encrypt: " & m_Transfer.LastErr
            GoTo gateEnd
        End If
        Dim headS As String
        headS = HeadTextOf(packed, 100)
        Dim okHdr As Boolean
        okHdr = (InStr(1, headS, "SilentNotes v=2$aes_gcm$", vbTextCompare) = 1)
        okHdr = okHdr And (InStr(1, headS, "$gzip$", vbTextCompare) > 0)
        Dim back() As Byte
        If Not m_Transfer.DecryptRepo(packed, code, back) Then
            RAssert "Sync.transfer_crypto", False, "decrypt: " & m_Transfer.LastErr
            GoTo gateEnd
        End If
        Dim okRound As Boolean
        okRound = BytesEqual(sample, back)
        Dim wrongOk As Boolean
        wrongOk = False
        Dim dummy() As Byte
        If Not m_Transfer.DecryptRepo(packed, "WrongGateCode99x", dummy) Then
            wrongOk = (StrComp(m_Transfer.LastErr, "wrong_transfer_code", vbTextCompare) = 0)
        End If
        RAssert "Sync.transfer_crypto", okHdr And okRound And wrongOk, _
            "header=" & okHdr & " roundtrip=" & okRound & " wrongcode-flag=" & wrongOk

        ' ---- G2 first upload (remote wiped)
        If Not SyncLoadSettings() Then GoTo gateEnd
        If Not m_SyncSettings.IsConfigured() Then
            RAssert "Sync.upload_new", False, "gate settings not configured (pass -syncsettings=)"
            GoTo gateEnd
        End If
        ' GATE SAFETY: the sync gates delete/overwrite the remote file - they
        ' must never see a real server url (a failed gate-ini load falls back
        ' to the imported original settings!)
        If InStr(1, m_SyncSettings.ServerUrl, "127.0.0.1", vbTextCompare) = 0 Then
            RAssert "Sync.upload_new", False, "gate settings must point at 127.0.0.1"
            GoTo gateEnd
        End If
        Dim wd As TbWebdav
        Set wd = New TbWebdav
        Dim et As String
        If Not wd.Init(m_Ck, m_SyncSettings.ServerUrl, m_SyncSettings.Username, m_SyncSettings.Password, et) Then
            RAssert "Sync.upload_new", False, "webdav init: " & et
            GoTo gateEnd
        End If
        Dim fileUrl As String
        fileUrl = m_SyncSettings.RepoFileUrl()
        wd.DeleteFile fileUrl            ' start clean (404 ok)
        Dim res As String
        res = RunSyncNow()
        Dim localBytes() As Byte
        ReadBytesF WorkRepo, localBytes
        Dim remotePacked() As Byte
        Dim okRemote As Boolean
        If wd.GetFile(fileUrl, remotePacked) Then
            Dim remoteXml() As Byte
            If m_Transfer.DecryptRepo(remotePacked, m_SyncSettings.TransferCode, remoteXml) Then
                okRemote = BytesEqual(remoteXml, localBytes)
            End If
        End If
        RAssert "Sync.upload_new", (res = "uploaded_new") And okRemote, _
            "res=" & res & " remoteDecryptEqualsLocal=" & okRemote & " status=" & wd.LastStatus

        ' ---- G3 clean second run
        res = RunSyncNow()
        RAssert "Sync.clean", res = "clean", "res=" & res

        ' ---- G4 merge of a remote-side change (variant repo built through
        ' the SAME backend instance: TbPureGw model state is global, a second
        ' instance would clobber the open repository)
        Dim nBefore As Long
        nBefore = m_Repo.TotalCount
        Dim variantPath As String
        variantPath = P3Dir & "\sync\probe\gate_variant.silentnotes"
        If Len(Dir$(variantPath, vbNormal)) > 0 Then Kill variantPath
        FileCopy WorkRepo, variantPath
        m_Repo.CloseRepo
        m_Repo.OpenExisting variantPath
        m_Repo.AddNew "<p>gate cloud variant note</p>"
        m_Repo.SaveNow
        m_Repo.CloseRepo
        m_Repo.OpenExisting WorkRepo
        Dim variantBytes() As Byte
        ReadBytesF variantPath, variantBytes
        Dim variantPacked() As Byte
        If Not m_Transfer.EncryptRepo(variantBytes, m_SyncSettings.TransferCode, variantPacked) Then
            RAssert "Sync.merge_remote", False, "variant encrypt: " & m_Transfer.LastErr
            GoTo gateEnd
        End If
        If Not wd.PutFile(fileUrl, variantPacked) Then
            RAssert "Sync.merge_remote", False, "variant PUT status=" & wd.LastStatus
            GoTo gateEnd
        End If
        res = RunSyncNow()
        Dim okMerge As Boolean
        okMerge = (res = "merged") Or (res = "downloaded")
        okMerge = okMerge And (m_Repo.TotalCount = nBefore + 1)
        Dim localAfter() As Byte
        ReadBytesF WorkRepo, localAfter
        Dim okMergeNote As Boolean
        Dim sAfter As String
        sAfter = m_U8.Decode(localAfter)
        okMergeNote = (InStr(1, sAfter, "gate cloud variant note", vbBinaryCompare) > 0)
        RAssert "Sync.merge_remote", okMerge And okMergeNote, _
            "res=" & res & " count " & nBefore & "->" & m_Repo.TotalCount & " variantNoteLocal=" & okMergeNote

        ' ---- G5 id conflict -> auto choice cloud (local replaced); the empty
        ' repo is derived from the work repo (same id), the id gets patched so
        ' the mismatch branch is reached
        Dim emptyBytes() As Byte
        ReadBytesF EmptyRepo, emptyBytes
        Dim localBytesG() As Byte
        ReadBytesF WorkRepo, localBytesG
        Dim localIdG As String
        localIdG = m_SyncId.RepoIdOfBytes(localBytesG)
        Dim altId As String
        If Left$(localIdG, 1) = "a" Then
            altId = "b" & Mid$(localIdG, 2)
        Else
            altId = "a" & Mid$(localIdG, 2)
        End If
        Dim sEmpty As String
        sEmpty = m_U8.Decode(emptyBytes)
        sEmpty = Replace(sEmpty, localIdG, altId)
        emptyBytes = m_U8.Encode(sEmpty)
        If InStr(1, sEmpty, altId, vbBinaryCompare) = 0 Then
            RAssert "Sync.conflict_choice", False, "empty repo id patch failed (fixture drift)"
            GoTo gateEnd
        End If
        Dim emptyPacked() As Byte
        If Not m_Transfer.EncryptRepo(emptyBytes, m_SyncSettings.TransferCode, emptyPacked) Then
            RAssert "Sync.conflict_choice", False, "conflict encrypt: " & m_Transfer.LastErr
            GoTo gateEnd
        End If
        If Not wd.PutFile(fileUrl, emptyPacked) Then
            RAssert "Sync.conflict_choice", False, "conflict PUT status=" & wd.LastStatus
            GoTo gateEnd
        End If
        res = RunSyncNow()
        ReadBytesF WorkRepo, localAfter
        Dim okCloud As Boolean
        okCloud = (res = "downloaded") And BytesEqual(localAfter, emptyBytes)
        RAssert "Sync.conflict_choice", okCloud, _
            "res=" & res & " localReplacedByCloud=" & BytesEqual(localAfter, emptyBytes)

gateEnd:
        ' restore the pre-gate snapshot + drop the remote (next run starts
        ' clean); the repo state feeds the screenshots afterwards
        On Error Resume Next
        wd.DeleteFile fileUrl
        If Len(Dir$(variantPath, vbNormal)) > 0 Then Kill variantPath
        m_Repo.CloseRepo
        If Len(Dir$(snapPath, vbNormal)) > 0 Then
            Kill WorkRepo
            FileCopy snapPath, WorkRepo
            Kill snapPath
        End If
        m_Repo.OpenExisting WorkRepo
        m_loadDoc = -1
        m_sel = 0
        m_offset = 0
        RebuildFilterCurrent
        ClampScroll
        LoadNoteForEdit
        RedrawAll "sync_gate_cleanup"
        WLog "[Sync.gates] end (work repo restored)"
        Exit Sub
fail:
        RAssert "Sync.gates", False, "err=" & Err.Number & " " & Err.Description
        LogCrash "GateSyncRound fail err=" & Err.Number & " " & Err.Description
        Resume gateEnd
    End Sub

    ' transfer code of the loaded gate settings (empty -> gates cannot run
    ' the crypto parts deterministically; surfaced in the G1 detail)
    Private Function SyncGateCode() As String
        On Error Resume Next
        SyncLoadSettings
        SyncGateCode = m_SyncSettings.TransferCode
    End Function

    Private Function HeadTextOf(data() As Byte, ByVal n As Long) As String
        On Error Resume Next
        If ArrLenB(data) < n Then n = ArrLenB(data)
        Dim head() As Byte
        ReDim head(0 To n - 1)
        Dim i As Long
        For i = 0 To n - 1
            head(i) = data(i)
        Next
        HeadTextOf = m_U8.Decode(head)
    End Function

    ' returns "" when every token matches the spec table, else a name list
    Private Function ThemeDiff(t As TbTheme, ByVal themeName As String) As String
        Dim d As String
        Dim i As Long
        For i = 0 To t.TokenCount - 1
            If t.TokenValue(i) <> t.SpecValue(themeName, i) Then
                d = d & " " & t.TokenName(i)
            End If
        Next
        ThemeDiff = d
    End Function
#End If

    ' ================================================================ logging

    ' P5-A crash.log wiring. tB has no global exception hook - the log is
    ' written from the three known failure exits EXPLICITLY (Form_Load
    ' hardFail, GateSyncRound fail, RunSyncNow error). Data directory =
    ' the VALUE HKCU\Software\SilentNotes\DataDirectory (TbDataDir, exe
    ' dir fallback); crash.log lands in its root in the .NET shells'
    ' format: "[yyyy/MM/dd HH:mm:ss] <body>\r\n\r\n", UTF-8 without BOM.
    Private m_crashLogPath As String

    Private Function CrashLogPathR() As String
        On Error Resume Next
        If Len(m_crashLogPath) = 0 Then
            Dim dd As TbDataDir
            Set dd = New TbDataDir
            m_crashLogPath = dd.GetEffectiveDirectory() & "\crash.log"
        End If
        CrashLogPathR = m_crashLogPath
    End Function

    ' append one crash.log entry (never throws; failures stay silent here
    ' - the crash logger must not become the crash)
    Private Sub LogCrash(ByVal context As String)
        On Error Resume Next
        Dim lg As TbLog
        Set lg = New TbLog
        lg.AppendEntry CrashLogPathR(), "SilentNotesTbP3: " & context
    End Sub

    Private Sub WLog(s As String)
        On Error Resume Next
        Dim ba() As Byte
        ba = m_U8.Encode(s & vbCrLf)
        Dim f As Integer
        f = FreeFile
        Open ResultPath For Binary Access Read Write As #f
        Seek #f, LOF(f) + 1
        Put #f, , ba
        Close #f
    End Sub

#If Not CBool(RELEASE_BUILD) Then
    Private Sub RPass(ByVal gate As String, ByVal detail As String)
        m_pass = m_pass + 1
        WLog "[" & gate & "] PASS " & detail
    End Sub

    Private Sub RFail(ByVal gate As String, ByVal detail As String)
        m_fail = m_fail + 1
        WLog "[" & gate & "] FAIL " & detail
    End Sub

    Private Sub RAssert(ByVal gate As String, ByVal ok As Boolean, ByVal detail As String)
        If ok Then
            RPass gate, detail
        Else
            RFail gate, detail
        End If
    End Sub
#End If

    Private Sub ILog(ByVal action As String, ByVal detail As String)
        WLog "[Interact." & action & "] INFO " & detail
    End Sub

    Private Function FileLenSafe(ByVal p As String) As Long
        On Error Resume Next
        FileLenSafe = FileLen(p)
    End Function

    ' Command line: -screenshot | /screenshot, /empty, -theme=blue|graphite|
    ' light|dark, -shotfile=name.png (relative names land in P3Dir).
    ' (-size= is accepted but ignored: the client is fixed 1200x800.)
    Private Sub ParseArgs()
        Dim toks() As String
        Dim i As Long
        Dim t As String

        toks = Split(Command$, " ")
        For i = 0 To UBound(toks)
            t = Trim$(toks(i))
            If Len(t) > 0 Then
                If StrComp(t, "-screenshot", vbTextCompare) = 0 Or StrComp(t, "/screenshot", vbTextCompare) = 0 Then
                    m_shotMode = True
                ElseIf InStr(1, t, "-theme=", vbTextCompare) = 1 Then
                    t = Mid$(t, 8)
                    If StrComp(t, "blue", vbTextCompare) = 0 Or StrComp(t, "light", vbTextCompare) = 0 Then
                        m_themeOverride = "blue"
                    ElseIf StrComp(t, "graphite", vbTextCompare) = 0 Or StrComp(t, "dark", vbTextCompare) = 0 Then
                        m_themeOverride = "graphite"
                    End If
                ElseIf InStr(1, t, "-shotfile=", vbTextCompare) = 1 Then
                    t = Mid$(t, 11)
                    If Len(t) > 0 Then
                        If InStr(t, "\") = 0 And InStr(t, "/") = 0 Then t = P3Dir & "\" & t
                        m_shotFile = t
                    End If
#If Not CBool(RELEASE_BUILD) Then
                ElseIf StrComp(t, "-maxshot", vbTextCompare) = 0 Then
                    m_maxShot = True
                ElseIf StrComp(t, "-scrollshot", vbTextCompare) = 0 Then
                    m_scrollShot = True
                ElseIf StrComp(t, "-gates", vbTextCompare) = 0 Then
                    m_gatesMode = True
                ElseIf StrComp(t, "-syncgate", vbTextCompare) = 0 Then
                    m_syncGate = True
                ElseIf InStr(1, t, "-syncchoice=", vbTextCompare) = 1 Then
                    m_syncChoice = Mid$(t, 13)
                ElseIf InStr(1, t, "-syncsettings=", vbTextCompare) = 1 Then
                    m_syncIniOverride = Mid$(t, 15)
#End If
                End If
            End If
        Next
    End Sub

    ' IE doc mode for the hosted Trident (VB-line EnsureBrowserEmulationMode
    ' pattern; 8888 = IE8 standards regardless of doctype - the XP floor
    ' the editor degrades to). Harmless if it fails - the editor tolerates
    ' the default doc mode.
    Private Sub EnsureEmulationKey()
        On Error Resume Next
        Dim hk As Long
        Dim path1 As String, path2 As String
        path1 = "Software\Microsoft\Internet Explorer\Main\FeatureControl\FEATURE_BROWSER_EMULATION"
        path2 = "Software\Microsoft\Internet Explorer\Main\FeatureControl"
        Dim v As Long
        v = 8888
        RegCreateKeyExW HKEY_CURRENT_USER, StrPtr(path1), 0, 0, 0, KEY_SET_VALUE, 0, hk, 0
        If hk <> 0 Then
            RegSetValueExW hk, StrPtr("SilentNotesTbP3_win32.exe"), 0, REG_DWORD, v, 4
            RegCloseKey hk
            WLog "[Editor.emulation] FEATURE_BROWSER_EMULATION=8888 (IE8) for SilentNotesTbP3_win32.exe"
        Else
            ' intermediate key may be missing - create it, then retry
            RegCreateKeyExW HKEY_CURRENT_USER, StrPtr(path2), 0, 0, 0, KEY_SET_VALUE, 0, hk, 0
            If hk <> 0 Then RegCloseKey hk
            hk = 0
            RegCreateKeyExW HKEY_CURRENT_USER, StrPtr(path1), 0, 0, 0, KEY_SET_VALUE, 0, hk, 0
            If hk <> 0 Then
                RegSetValueExW hk, StrPtr("SilentNotesTbP3_win32.exe"), 0, REG_DWORD, v, 4
                RegCloseKey hk
                WLog "[Editor.emulation] FEATURE_BROWSER_EMULATION=8888 (IE8) for SilentNotesTbP3_win32.exe"
            Else
                WLog "[Editor.emulation] WARN could not write emulation key (default doc mode)"
            End If
        End If
    End Sub

    ' window class name of a handle (writable BSTR via StrPtr)
    Private Function WindowClassOf(ByVal hWnd As Long) As String
        On Error Resume Next
        Dim s As String
        Dim r As Long
        s = Space$(256)
        r = GetClassNameW(hWnd, StrPtr(s), 256)
        If r > 0 Then WindowClassOf = Left$(s, r)
    End Function

#If Not CBool(RELEASE_BUILD) Then
    ' Per-function probe of every TbGfx capability used by the shell - pins
    ' down which API declare shape fails inside the class (UDT params etc).
    Private Sub GfxProbe()
        On Error Resume Next
        Dim h As Long
        Dim sx As Long, sy As Long
        h = hDC
        WLog "[gfx.probe] hdc=0x" & Hex$(h)

        Err.Clear
        m_G.FillRc h, 0, 0, 20, 20, RGB(255, 0, 0)
        WLog "[gfx.probe.fill] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.FrameRc h, 0, 0, 20, 20, RGB(0, 255, 0)
        WLog "[gfx.probe.frame] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.DrawCircle h, 30, 30, 5, RGB(0, 0, 255)
        WLog "[gfx.probe.circle] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.TextAt h, "probe", 2, 40, RGB(0, 0, 0), m_G.FontUI
        WLog "[gfx.probe.text] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.ChipRect h, 0, 60, 40, 80, RGB(255, 255, 0), RGB(0, 0, 0)
        WLog "[gfx.probe.chip] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.DrawTriUp h, 50, 90, 7, 4, RGB(255, 0, 255)
        WLog "[gfx.probe.tri] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.DrawLock h, 60, 100, RGB(0, 0, 0)
        WLog "[gfx.probe.lock] err=" & Err.Number & " " & Err.Description

        Err.Clear
        sx = 100
        sy = 100
        m_G.ScreenToClientPx Me.hWnd, sx, sy
        WLog "[gfx.probe.stc] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.TrackLeave Me.hWnd
        WLog "[gfx.probe.trackleave] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.TextWidth(h, "probe", m_G.FontUI)
        WLog "[gfx.probe.textwidth] err=" & Err.Number & " " & Err.Description

        Err.Clear
        Dim savedClip As Long
        savedClip = m_G.ClipBegin(h, 0, 0, 100, 100)
        WLog "[gfx.probe.clip] err=" & Err.Number & " " & Err.Description
        m_G.ClipEnd h, savedClip

        Err.Clear
        m_G.GradRect h, 0, 110, 60, 130, RGB(255, 255, 255), RGB(0, 0, 128)
        WLog "[gfx.probe.grad] err=" & Err.Number & " " & Err.Description

        Err.Clear
        m_G.Bevel h, 70, 110, 110, 130, RGB(255, 255, 255), RGB(96, 96, 96), False
        WLog "[gfx.probe.bevel] err=" & Err.Number & " " & Err.Description
    End Sub
#End If

    ' ===================================================== UI strings
    ' UTF-16 codepoints via ChrW$; the trailing & keeps 4-digit hex
    ' literals >= &H8000 Long (tB TB0012 treats them as negative Integer
    ' otherwise). Each helper documents its rendered text.

    Private Function SAll() As String            ' "鍏ㄩ儴"
        SAll = ChrW$(&H5168&) & ChrW$(&H90E8&)
    End Function

    Private Function SBtnNew() As String         ' "+ 鏂扮瑪璁?
        SBtnNew = "+ " & ChrW$(&H65B0&) & ChrW$(&H7B14&) & ChrW$(&H8BB0&)
    End Function

    Private Function SBtnSafe() As String        ' "瀹夊叏绠?
        SBtnSafe = ChrW$(&H5B89&) & ChrW$(&H5168&) & ChrW$(&H7BB1&)
    End Function

    Private Function SBtnSync() As String         ' 同步
        SBtnSync = ChrW$(&H540C&) & ChrW$(&H6B65&)
    End Function

    Private Function SBtnSet() As String          ' 设置
        SBtnSet = ChrW$(&H8BBE&) & ChrW$(&H7F6E&)
    End Function

    Private Function SSyncTitle() As String       ' 同步提示
        SSyncTitle = ChrW$(&H540C&) & ChrW$(&H6B65&) & ChrW$(&H63D0&) & ChrW$(&H793A&)
    End Function

    Private Function SSettingsHint() As String    ' 传输码用于加密云端数据（16位）
        SSettingsHint = ChrW$(&H4F20&) & ChrW$(&H8F93&) & ChrW$(&H7801&) & ChrW$(&H7528&) & _
            ChrW$(&H4E8E&) & ChrW$(&H52A0&) & ChrW$(&H5BC6&) & ChrW$(&H4E91&) & ChrW$(&H7AEF&) & _
            ChrW$(&H6570&) & ChrW$(&H636E&) & " (16)"
