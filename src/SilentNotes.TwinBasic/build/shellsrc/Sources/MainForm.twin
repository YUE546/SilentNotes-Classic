Option Explicit

[Description("SilentNotes twinBASIC P3: native chrome shell + MSHTML editor")]
[FormDesignerId("7E4C1A02-93B5-4F6D-8A21-C0D51B9F0004")]
[PredeclaredId]
Class MainForm

    ' RELEASE_BUILD: 0 = development build (gate suite available), 1 = release
    ' artifact with the gate/diagnostic machinery compiled out. build.cmd
    ' release flips this line for the build and restores it afterwards.
    ' (declared inside the class: a #Const above the Class header did not
    ' take effect in the built exe)
    ' tB pit: #If tests need CBool() - bare #If Not CONST is always True
    ' (Compiler-Constants doc, "not Boolean values")
#Const RELEASE_BUILD = 0

    ' ==================================================================
    ' P3 shell + MSHTML editor, perf rework (2026-10-25):
    '   - native title bar; BorderStyle=1 (no drag-resize) but MaxButton
    '     IS enabled again - the layout is dynamic (maximize/restore OK)
    '   - scroll perf: full-list content cache (one bitmap, ~85x60px);
    '     wheel = row steps through the built-in VScrollBar -> strip blit;
    '     hover/selection re-render single rows; TextClip is one
    '     GetTextExtentExPointW call; GDI brushes/pens are cached
    '   - click perf: the two affected rows repaint immediately from the
    '     cache (no full-window redraw, no waiting on the editor swap);
    '     repeated clicks on the same note are skipped
    '   - flicker fix retained: every full frame is composed on the
    '     backbuffer and blitted once; Paint counts feed Flicker.*
    '   - P3 editor: SHDocVw WebBrowser (designer child) + MSHTML late-bound
    '     (TbEdit), format toolbar (GDI icons), paste cleaner (TbClean),
    '     Ctrl+click links (TbEditSub), modal link dialog (LinkDlg)
    ' ScaleMode is vbPixels; every coordinate in this file is a pixel.
    ' All UI strings are built in the S*() helpers at the bottom of this
    ' file (ChrW$ literals with a trailing & so >= &H8000 stays Long).
    ' ==================================================================

    Private Const P3Dir As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic"
    Private Const ResultPath As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\temp\p3_result.txt"
    Private Const IniPath As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\ui_settings.ini"
    Private Const ShotPath As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\temp\shot.png"
    Private Const WorkRepo As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\test_repo.silentnotes"
    Private Const EmptyRepo As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\sync\probe\empty_repo.silentnotes"

    ' layout metrics (pixels) - the spec, single source of truth
    Private Const ToolH As Long = 64
    Private Const TagH As Long = 36
    Private Const StatusH As Long = 24
    Private Const ListW As Long = 280
    Private Const ItemH As Long = 60
    Private Const SbW As Long = 12           ' item/cache width basis (ListW - SbW)
    Private Const SbNativeW As Long = 17     ' built-in VScrollBar width (SM_CXVSCROLL)
    Private Const BtnNewW As Long = 96
    Private Const BtnSafeW As Long = 84
    Private Const BtnSyncW As Long = 64
    Private Const BtnSaveNW As Long = 64
    Private Const BtnSetW As Long = 64
    Private Const BtnH As Long = 48
    Private Const MoonS As Long = 48
    Private Const FixedW As Long = 1200      ' normal-state client (maximize allowed)
    Private Const FixedH As Long = 800

    ' P4 sync assets
    Private Const ChilkatDir As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\chilkat-new-win32\chilkatax-win32"
    Private Const SyncIniPath As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\sync_settings.ini"
    Private Const SyncBackupDir As String = "D:\vibe coding\silentnotes\src\SilentNotes.TwinBasic\sync\backups"

    ' format toolbar: B I S | H1 H2 H3 | UL OL | HR | A(link)
    ' design width (client 1200): 10x52 + 9x2 + 4x2 = 546, left edge x=172
    ' (12px clear of the search box, 10px of the moon button); narrower
    ' clients compress the buttons (LayoutAll) instead of overlapping the box
    Private Const FmtN As Long = 10
    Private Const FmtW As Long = 52
    Private Const FmtPitch As Long = 54      ' 52px button + 2px gap

    ' window styles for the Frame.native gate
    Private Const WS_CAPTION = &HC00000
    Private Const WS_SYSMENU = &H80000
    Private Const WS_MINIMIZEBOX = &H20000
    Private Const WS_MAXIMIZEBOX = &H10000
    Private Const WS_THICKFRAME = &H40000
    Private Const GWL_WNDPROC = -4
    Private Const GWL_STYLE = -16
    Private Const GWL_EXSTYLE = -20

    ' API (primitive parameters only - UDT declares live in the classes)
    Private Declare Function GetWindowLongW Lib "user32" (ByVal hWnd As Long, ByVal nIndex As Long) As Long
    Private Declare Function GetClassNameW Lib "user32" (ByVal hWnd As Long, ByVal buf As Long, ByVal nMax As Long) As Long
    Private Declare Function GetPixel Lib "gdi32" (ByVal hdc As Long, ByVal x As Long, ByVal y As Long) As Long
    Private Declare Function SetWindowPos Lib "user32" (ByVal hWnd As Long, ByVal hWndAfter As Long, ByVal x As Long, ByVal y As Long, ByVal cx As Long, ByVal cy As Long, ByVal flags As Long) As Long
    Private Declare Function GetWindowRectW Lib "user32" Alias "GetWindowRect" (ByVal hWnd As Long, ByRef rc As RECTW) As Long
    Private Declare Function AdjustWindowRectEx Lib "user32" (ByRef rc As RECTW, ByVal style As Long, ByVal menu As Long, ByVal exStyle As Long) As Long
    Private Declare Function GetSystemMetrics Lib "user32" (ByVal nIndex As Long) As Long

    Private Type RECTW
        L As Long
        T As Long
        R As Long
        B As Long
    End Type
    Private Declare Function SetCursorPos Lib "user32" (ByVal x As Long, ByVal y As Long) As Long
    Private Declare Function ClientToScreenA Lib "user32" Alias "ClientToScreen" (ByVal hWnd As Long, ByRef pt As POINTM) As Long
    Private Declare Function GetTickCount Lib "kernel32" () As Long
    Private Declare Function ShellExecuteW Lib "shell32" (ByVal hWnd As Long, ByVal op As Long, ByVal file As Long, ByVal params As Long, ByVal dir As Long, ByVal show As Long) As Long
    Private Declare Function SetForegroundWindow Lib "user32" (ByVal hWnd As Long) As Long
    Private Declare Function SendMessageW Lib "user32" (ByVal hWnd As Long, ByVal uMsg As Long, ByVal wParam As Long, ByVal lParam As Long) As Long
    Private Declare Function RegCreateKeyExW Lib "advapi32" (ByVal hKey As Long, ByVal subKey As Long, ByVal reserved As Long, ByVal cls As Long, ByVal options As Long, ByVal samDesired As Long, ByVal secAttr As Long, ByRef phkResult As Long, ByVal disposition As Long) As Long
    Private Declare Function RegSetValueExW Lib "advapi32" (ByVal hKey As Long, ByVal name As Long, ByVal reserved As Long, ByVal typ As Long, ByRef data As Long, ByVal cb As Long) As Long
    Private Declare Function RegCloseKey Lib "advapi32" (ByVal hKey As Long) As Long

    Private Const HKEY_CURRENT_USER = &H80000001
    Private Const KEY_SET_VALUE As Long = &H20006       ' STANDARD_RIGHTS_WRITE + KEY_SET_VALUE + KEY_CREATE_SUB_KEY
    Private Const REG_DWORD = 4

    Private Type POINTM
        px As Long
        py As Long
    End Type

    Private Type TRect
        x1 As Long
        y1 As Long
        x2 As Long
        y2 As Long
    End Type

    ' layout rects (all client pixels)
    Private m_rcTool As TRect
    Private m_rcTag As TRect
    Private m_rcList As TRect
    Private m_rcEdit As TRect
    Private m_rcStatus As TRect
    Private m_rcSb As TRect
    Private m_rcSearch As TRect
    Private m_rcNew As TRect
    Private m_rcSaveN As TRect           ' toolbar save button
    Private m_rcSafe As TRect
    Private m_rcSync As TRect           ' sync button
    Private m_rcSet As TRect            ' sync-settings button
    Private m_rcTheme As TRect          ' moon button, toolbar right end
    Private m_rcEmptyBtn As TRect
    Private m_rcFmt(0 To FmtN - 1) As TRect

    Private m_W As Long
    Private m_H As Long

    Private m_Th As TbTheme
    Private m_Repo As TbRepo
    Private m_U8 As TbUtf8
    Private m_G As TbGfx
    Private m_Ed As TbEdit

    ' P4 sync (lazy init - Chilkat activation context only when syncing)
    Private m_Ck As TbChilkat
    Private m_Crypto As TbCrypto
    Private m_Transfer As TbTransfer
    Private m_SyncSettings As TbSyncSettings
    Private m_SyncId As TbSync            ' RepoIdOfBytes + backup rotation
    Private m_syncBusy As Boolean
    Private m_syncGate As Boolean         ' -syncgate: run the mock-server gates
    Private m_syncChoice As String        ' -syncchoice=: auto-answer for MergeDlg
    Private m_syncIniOverride As String   ' -syncsettings=: gate settings file

    ' hover / press state (the toolbar buttons are native CommandButtons
    ' and own their own visual state)
    Private m_hovItem As Long
    Private m_hovSb As Boolean          ' hand-drawn fallback only
    Private m_sbDrag As Boolean         ' hand-drawn fallback only
    Private m_sbDragDy As Long
    Private m_tracked As Boolean

    ' list scroll: built-in VScrollBar (user-approved), hand-drawn fallback
    ' if the runtime probe fails. m_offset stays the pixel truth (row
    ' aligned); the control mirrors it, Change/Scroll feed back into it.
    Private m_sbNative As Boolean
    Private m_syncSb As Boolean         ' recursion guard while driving vsList

    ' list content cache: rebuilt only on data epoch/theme changes; row
    ' level changes re-render single rows (RenderCacheRow) and the fast
    ' paths blit the visible strip (RepaintListFast)
    Private m_listCacheEpoch As Long
    Private m_listThemeDirty As Boolean
    Private m_fastN As Long             ' fast path blit counter (diag)

    ' format button toggled states (0=B 1=I 2=S 3=H1 4=H2 5=H3 6=UL 7=OL)
    Private m_fmtOn(0 To FmtN - 1) As Boolean

    ' scrollbar geometry (recomputed by CalcSb)
    Private m_sbThumbY As Long
    Private m_sbThumbH As Long
    Private m_sbMaxOff As Long

    ' tag picker (native cboTag): m_chipName feeds ChipTagName for filtering,
    ' m_syncChip holds off cboTag_Click while ListIndex is set in code.
    ' The picker's LAST entry is the recycle-bin pseudo tag (P5-A): picking
    ' it flips m_binMode - the list then shows only in-bin notes and
    ' tag/search filters step aside.
    Private m_chipName() As String
    Private m_chipN As Long
    Private m_chipSel As Long      ' 0 = "all"
    Private m_syncChip As Boolean
    Private m_binMode As Boolean   ' recycle-bin view (cboTag last entry)

    ' list state
    Private m_sel As Long          ' selected visible row
    Private m_offset As Long       ' scroll offset in pixels

    ' editor state
    Private m_editReady As Boolean
    Private m_loadDoc As Long      ' doc index loaded in the editor, -1 = none
    Private m_loadedHtml As String ' editor html baseline at load (dirty test)
    Private m_lockedDoc As Boolean ' P5-B: loaded safe note is LOCKED (save-guarded placeholder)
    Private m_ieHwnd As Long       ' Internet Explorer_Server child hwnd
    Private m_openProbe As Boolean ' Link.ctrlclick gate: don't really launch
    Private m_lastLinkUrl As String

    ' flicker counters + diagnostic trace
    Private m_paintN As Long       ' Form_Paint invocations
    Private m_redrawN As Long      ' RedrawAll invocations
    Private m_diagActive As Boolean
    Private m_diagLines As Long

    ' tmrFmt state machine: 0=idle wait 1=hover sweep 2=finish 3=polling
    Private m_phase As Long
    Private m_phaseTick As Long
    Private m_idleBase As Long
    Private m_idleTick0 As Long
    Private m_hoverBase As Long
    Private m_pollTick As Long
    Private m_pollLen As Long

    ' self-check
    Private m_pass As Long
    Private m_fail As Long
    Private m_shotMode As Boolean
    Private m_lastDrawErr As String
    Private m_cueTried As Boolean     ' first Form_Activate ran
    Private m_statusMsg As String     ' P6: transient status-bar feedback
    Private m_iconLoaded As Boolean   ' P6: form icon from the embedded app.ico

    ' perf instrumentation (GetTickCount, milliseconds)
    Private m_bootTick As Long        ' Form_Load entry tick
    Private m_firstFrameTick As Long  ' ms since boot at the first full redraw
    Private m_listRebuildN As Long    ' full-list cache rebuilds (perf counter)

    ' command line options (-size is ignored with a fixed client;
    ' -theme=blue|graphite|light|dark, -shotfile=name.png, -maxshot, -scrollshot,
    ' -gates). IMPORTANT: the startup gates move the cursor (hover sweep),
    ' synthesize clicks and maximize/restore the window - they must NEVER
    ' run on a normal launch. They only run with -screenshot or -gates
    ' (both are test/CI invocations).
    Private m_themeOverride As String
    Private m_shotFile As String
    Private m_maxShot As Boolean      ' -maxshot: maximize, capture, exit
    Private m_scrollShot As Boolean   ' -scrollshot: wheel 3 rows, capture, exit
    Private m_gatesMode As Boolean    ' -gates: run startup gates, then stay open

    ' badge statistics of the visible pool (gate log + screenshot probe)
    Private m_pinN As Long
    Private m_safeN As Long

    ' ================================================================ events

    Private Sub Form_Load()
        On Error GoTo hardFail

        m_bootTick = GetTickCount()
        ParseArgs
        If Len(m_shotFile) = 0 Then m_shotFile = ShotPath

        Set m_U8 = New TbUtf8
        Set m_Th = New TbTheme
        m_Th.LoadFromIni IniPath
        If Len(m_themeOverride) > 0 Then
            m_Th.Apply m_themeOverride   ' temporary (not persisted to ini)
        End If
        Set m_Repo = New TbRepo
        Set m_G = New TbGfx
        Set m_Ed = New TbEdit
        m_Ed.SetBrowser wbEdit
        m_loadDoc = -1
        m_lockedDoc = False

        On Error Resume Next
        Kill ResultPath
        On Error GoTo hardFail

        WLog "=== SilentNotesTbP3 start " & Format$(Now, "yyyy/mm/dd hh:nn:ss") & IIf(m_shotMode, " mode=+screenshot", "") & " ==="

        Me.Caption = "SilentNotes"

        ' light subclass: WM_ERASEBKGND suppression (flicker) + WM_MOUSEWHEEL
        ' (list scroll). No NCHITTEST / MINMAXINFO - native chrome.
        TbSubclass.Install Me.hWnd, Me

        ' fixed client 1200x800 (native frame, no resize, no maximize)
        SnapFixedSize
        LayoutAll
        m_G.Init
        m_G.InitBackbuffer hDC, m_W, m_H
        txtFind.FontName = "Segoe UI"
        txtFind.FontSize = 9

        ' toolbar button captions: ChrW$ literals (the tbform stays ASCII)
        ' cmdSafe starts locked (caption + accent switch over in UpdateSafeBadge)
        On Error Resume Next
        lblSearch.Caption = ChrW$(&H641C&) & ChrW$(&H7D22&) & ChrW$(&HFF1A&)    ' 搜索：
        cmdNew.Caption = SBtnNew()
        cmdSaveN.Caption = SBtnSaveNote()
        cmdSaveN.Enabled = True
        cmdSafe.Caption = SBtnSafe()
        cmdSafe.Enabled = True              ' tbform legacy Enabled:false (P2) - the safe UI is live since P5-B
        cmdSync.Caption = SBtnSync()
        cmdSet.Caption = SBtnSet()
        cmdTheme.Caption = ChrW$(&H4E3B&) & ChrW$(&H9898&)    ' 主题
        cmdFmt0.Caption = SFmtCap(0)
        cmdFmt1.Caption = SFmtCap(1)
        cmdFmt2.Caption = SFmtCap(2)
        cmdFmt3.Caption = SFmtCap(3)
        cmdFmt4.Caption = SFmtCap(4)
        cmdFmt5.Caption = SFmtCap(5)
        cmdFmt6.Caption = SFmtCap(6)
        cmdFmt7.Caption = SFmtCap(7)
        cmdFmt8.Caption = SFmtCap(8)
        cmdFmt9.Caption = SFmtCap(9)
        cmdTagMgr.Caption = ChrW$(&H7BA1&) & ChrW$(&H7406&)    ' 7BA1 7406 = guan li (manage)
        ' the tbform deserializer chokes on the Alignment/BackStyle enum
        ' props - set them at runtime (1 = opaque, right label right-aligned).
        ' P6: the status strip is a SOLID GDI fill with OPAQUE native labels
        ' riding it (same BackColor from ApplyChildTheme - no seams)
        lblStatusL.BackStyle = 1
        lblStatusR.BackStyle = 1
        lblStatusR.Alignment = 1
        cboTag.Style = vbComboDropdownList    ' pick-only (recreates the window)
        On Error GoTo hardFail
        ApplyToolbarIcons
        ApplyChildTheme
        UpdateSafeBadge              ' P5-B: locked caption/face at boot

        ' P6: form icon from the embedded app.ico (title bar icon; the exe
        ' icon comes from the same resource through project.iconForm).
        ' LoadResPicture first (VB6 path); tB's LoadPicture on the raw
        ' resource bytes as the fallback (same pattern as the silk pngs)
        m_iconLoaded = False
        On Error Resume Next
        Me.Icon = LoadResPicture("app.ico", vbResIcon)
        m_iconLoaded = (Err.Number = 0)
        If Not m_iconLoaded Then
            Dim icb() As Byte
            icb = LoadResData("app.ico", "ICON")
            If UBound(icb) >= 0 Then
                Dim ip As Object
                Set ip = Global.LoadPicture(icb)
                If (Err.Number = 0) And (Not ip Is Nothing) Then
                    Set Me.Icon = ip
                    m_iconLoaded = True
                End If
            End If
        End If
        Err.Clear
        On Error GoTo hardFail
        WLog "[Icon.form] loaded=" & m_iconLoaded

        ' built-in VScrollBar probe (user-approved control swap): falls back
        ' to the hand-drawn scrollbar if the control misbehaves. The sync
        ' guard is held during the probe so the Value writes stay silent.
        m_sbNative = True
        m_syncSb = True
        On Error Resume Next
        Err.Clear
        vsList.Min = 0
        vsList.Max = 10
        vsList.LargeChange = 3
        vsList.Value = 4
        If Err.Number <> 0 Then
            m_sbNative = False
        ElseIf vsList.Value <> 4 Then
            m_sbNative = False
        End If
        vsList.Value = 0
        Err.Clear
        m_syncSb = False
        On Error GoTo hardFail
        WLog "[Sb.native] built-in VScrollBar probe=" & m_sbNative & " (fallback = hand-drawn scrollbar)"

        EnsureEmulationKey

        ' ---- editor control props (navigation starts in Form_Activate:
        ' Trident defers navigation completion until the host window is
        ' VISIBLE, so a Form_Load pump stalls ~10s on a cold start)
        On Error Resume Next
        wbEdit.Silent = True
        wbEdit.RegisterAsDropTarget = False
        wbEdit.Visible = True
        On Error GoTo hardFail

#If Not CBool(RELEASE_BUILD) Then
        GfxProbe
#End If

        ' geometry probe: window size in screen pixels vs the form's own
        ' scale - they must agree or the layout space is scaled somewhere
        Dim tppx As Long
        tppx = Screen.TwipsPerPixelX
        WLog "[geom.probe] winPx=" & (Me.Width \ tppx) & "x" & (Me.Height \ Screen.TwipsPerPixelY) & " scale=" & ScaleWidth & "x" & ScaleHeight & " client=" & m_W & "x" & m_H & " twipsPerPx=" & tppx

        LoadRepoAndChips
        LoadNoteForEdit
#If Not CBool(RELEASE_BUILD) Then
        If m_shotMode Or m_gatesMode Then
            RunStartupGates            ' gates hijack the cursor - test mode only
        End If
#End If

        RebuildFilterCurrent
        RedrawAll "load_done"
        WLog "[draw.probe] pix(17,18)=0x" & Hex$(GetPixel(hDC, 17, 18)) & " pix(300,300)=0x" & Hex$(GetPixel(hDC, 300, 300)) & " err=[" & m_lastDrawErr & "]"
        WLog "[Perf.t.firstframe] +" & m_firstFrameTick & "ms (first full redraw after boot)"

        ' the flicker machine (tmrFmt) is enabled at the END of
        ' Form_Activate, after the editor bring-up pump
        Exit Sub
hardFail:
        ' P1 pitfall: never Unload inside Form_Load - keep the window up,
        ' the failure is visible in p3_result.txt and the status bar.
        WLog "[Form_Load.hardFail] err=" & Err.Number & " " & Err.Description
        LogCrash "Form_Load hardFail err=" & Err.Number & " " & Err.Description
        RedrawAll "hardfail"
    End Sub

    Private Sub Form_Activate()
        On Error Resume Next
        If Not m_cueTried Then
            m_cueTried = True
            If Len(txtFind.Text) = 0 Then EnterCue   ' placeholder while unfocused

            ' the window is now VISIBLE - Trident finishes its navigation
            ' only for a visible host, so the editor is brought up here
            ' (needed on EVERY launch, normal included)
            EnsureEditorReady
            LoadNoteForEdit

#If Not CBool(RELEASE_BUILD) Then
            If m_shotMode Or m_gatesMode Then
                ' TEST-ONLY from here on: the search probe, the editor
                ' gates and the flicker-machine phases below hijack the
                ' cursor (sweeps), maximize/restore and wobble the window -
                ' none of that may run on a normal launch
                If m_Repo.IsOpen Then
                    StartDiagBlock
                Else
                    ' control-window recreation in Form_Load's early section
                    ' (cboTag.Style, FontName, ...) can deliver WM_ACTIVATE
                    ' mid-Form_Load - BEFORE LoadRepoAndChips ran. The editor
                    ' gates need the repo (AddNew etc. hit m_gw) - park in
                    ' phase -1 and let tmrFmt start the block once the repo
                    ' is open (LoadRepoAndChips is synchronous, so the first
                    ' tick after Form_Load sees it ready)
                    m_phase = -1
                    m_phaseTick = 0
                End If
            Else
                ' normal launch: straight to the steady state - the timer
                ' only does its runtime duties (format button states +
                ' paste garbage poll), no diagnostic phases
                m_diagActive = False
                m_phase = 3
                m_phaseTick = 0
                m_pollLen = -1
            End If
#End If
#If CBool(RELEASE_BUILD) Then
            ' release: straight to the steady state; -screenshot boots the
            ' real app and self-exits after one capture (no gates)
            m_diagActive = False
            If m_shotMode Then m_phase = 4 Else m_phase = 3
            m_phaseTick = 0
            m_pollLen = -1
#End If
            tmrFmt.Interval = 60
            tmrFmt.Enabled = True
        End If
    End Sub

#If Not CBool(RELEASE_BUILD) Then
    ' Search probe + editor gates + diagnostic phase-machine start. Runs
    ' either straight from Form_Activate (repo already open) or from the
    ' phase -1 deferral in tmrFmt_Timer (Form_Activate fired before
    ' LoadRepoAndChips). tB's .Visible property reads False on MainForm
    ' children even while they render fine (windowless-style tB controls) -
    ' the gate asserts the control exists instead of its Visible lie.
    Private Sub StartDiagBlock()
        Static diagStarted As Boolean
        If diagStarted Then Exit Sub   ' re-entry: gates pump modals -> the
                                       ' timer refires the -1 deferral
        diagStarted = True
        RAssert "Search.placeholder.after_show", txtFind.hWnd <> 0, _
            "native search box present (label + edit row)"
        RunEditorGates
        ' the synthetic-click phases below sweep the tag strip -
        ' opening the combo dropdown or the modal tag manager there
        ' would hang the run, so both stay disabled until steady state
        cboTag.Enabled = False
        cmdTagMgr.Enabled = False
        m_diagActive = True
        m_diagLines = 0
        m_phase = 0
        m_phaseTick = 0
    End Sub
#End If

    ' Brings the MSHTML editor up now that the host window is visible:
    ' a REAL Navigate2 (the control's initial document is special - its
    ' body does not survive the designMode flip), pump for the completion
    ' event, then EditorInit with an 8s body budget. Finally installs the
    ' IE_Server mouse subclass.
    Private Sub EnsureEditorReady()
        On Error Resume Next
        If m_editReady Then
            InstallEditorSubclass
            Exit Sub
        End If
        Dim t0 As Long
        t0 = GetTickCount()
        m_Ed.ResetDocReady
        wbEdit.Navigate2 "about:blank"
        Do While (Not m_Ed.DocReady()) And (GetTickCount() - t0) < 10000
            DoEvents
        Loop
        WLog "[Editor.host] navigation complete after " & (GetTickCount() - t0) & "ms"
        If m_Ed.EditorInit() Then
            m_editReady = True
            WLog "[Editor.host] designMode=" & m_Ed.DocMode() & " ready=True"
        Else
            WLog "[Editor.host] FAIL " & m_Ed.LastErr
        End If
        InstallEditorSubclass
    End Sub

    Private Sub InstallEditorSubclass()
        On Error Resume Next
        If m_ieHwnd <> 0 Then Exit Sub
        If Not m_editReady Then Exit Sub
        m_Ed.WalkLog = ""
        m_ieHwnd = m_Ed.FindIEServerHwnd(Me.hWnd)
        If m_ieHwnd <> 0 Then
            TbEditSub.Install m_ieHwnd, Me
            WLog "[Editor.host] ie_server=0x" & Hex$(m_ieHwnd) & " class=" & WindowClassOf(m_ieHwnd) & " walk=" & m_Ed.WalkLog & " ctrl_sub=True"
        Else
            WLog "[Editor.host] ie_server NOT FOUND walk=" & m_Ed.WalkLog
        End If
    End Sub

    ' AutoRedraw is off: every expose repaints the full client here
    Private Sub Form_Paint()
        On Error Resume Next
        m_paintN = m_paintN + 1
        RedrawAll "wm_paint"
    End Sub

    Private Sub Form_Resize()
        On Error Resume Next
        If WindowState = 1 Then Exit Sub   ' vbMinimized
        ' maximize/restore allowed (MaxButton=True, border stays fixed-single
        ' so there is no drag-resize). Layout is DYNAMIC: every region derives
        ' from ScaleWidth/ScaleHeight. A size change is a one-shot event
        ' (maximize/restore), so one full redraw is accepted.
        LayoutAll
        ClampScroll
        LayoutChips
        RebuildFilterCurrent
        RedrawAll "resize"
    End Sub

    Private Sub Form_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim mx As Long, my As Long
        If Button <> 1 Then Exit Sub
        mx = CLng(X)
        my = CLng(Y)

        If (Not m_sbNative) And InRc(m_rcSb, mx, my) Then
            SbMouseDown mx, my              ' hand-drawn fallback only
        Else
            Dim v As Long
            v = ItemAt(mx, my)
            If v >= 0 Then
                ILog "item_click", "row=" & v & " id=" & m_Repo.NoteId(m_Repo.VisDoc(v))
                SelectVisible v         ' two-row cache repaint inside
            End If
        End If
        ' NOTE: no trailing RedrawAll - every branch above owns its repaint.
        ' The old unconditional full repaint here (plus the one in MouseUp)
        ' made one click cost three full window redraws.
    End Sub

    Private Sub Form_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        On Error Resume Next
        If Not m_tracked Then
            If m_G.TrackLeave(Me.hWnd) Then m_tracked = True
        End If
        If m_sbDrag Then
            SbDragMove CLng(Y)
        Else
            If UpdateHover(CLng(X), CLng(Y)) Then RedrawAll "mousemove"
        End If
    End Sub

    Private Sub Form_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_sbDrag Then
            m_sbDrag = False
            RepaintListFast                     ' fallback scrollbar visual
            Exit Sub
        End If
        ' no trailing RedrawAll (press-release branches repaint themselves;
        ' a plain list click already painted via SelectVisible)
    End Sub

    Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
        ' Ctrl+N new note / Ctrl+F focus search / Ctrl+T theme (test hook)
        ' / Ctrl+P pin toggle / Ctrl+R restore (recycle-bin mode only)
        ' / Ctrl+E encrypt toggle (P5-B) / Ctrl+S explicit save
        If (Shift And 2) > 0 Then
            If KeyCode = 78 Then          ' N
                NewNote
                KeyCode = 0
            ElseIf KeyCode = 70 Then      ' F
                On Error Resume Next
                txtFind.Visible = True  ' SetFocus fails on hidden controls
                txtFind.SetFocus
                KeyCode = 0
            ElseIf KeyCode = 83 Then      ' S
                cmdSaveN_Click
                KeyCode = 0
            ElseIf KeyCode = 84 Then      ' T
                ToggleTheme
                KeyCode = 0
            ElseIf KeyCode = 80 Then      ' P
                TogglePinFromUi
                KeyCode = 0
            ElseIf KeyCode = 82 Then      ' R
                RestoreSelectedFromBin
                KeyCode = 0
            ElseIf KeyCode = 69 Then      ' E
                ToggleEncryptSelectedFromUi
                KeyCode = 0
            End If
            Exit Sub
        End If
        If KeyCode = 46 Then              ' Delete / Shift+Delete / Ctrl+Shift+Delete
            ' the search box is the only control where Delete edits text -
            ' never steal it while the user is typing (ActiveControl can
            ' error when nothing holds focus - resolve it into a flag first)
            Dim inFind As Boolean
            On Error Resume Next
            inFind = (Me.ActiveControl Is txtFind)
            On Error GoTo 0
            If Not inFind Then
                If (Shift And 3) = 3 Then
                    EmptyRecycleBinFromUi      ' Ctrl+Shift+Delete (bin mode)
                ElseIf (Shift And 1) > 0 Then
                    PurgeSelectedFromBin
                Else
                    DeleteSelectedFromUi
                End If
                KeyCode = 0
            End If
            Exit Sub
        End If
        If KeyCode = 38 Then              ' Up
            MoveSel -1
            KeyCode = 0
        ElseIf KeyCode = 40 Then          ' Down
            MoveSel 1
            KeyCode = 0
        ElseIf KeyCode = 27 Then          ' Esc
            ClearSearch
            KeyCode = 0
        End If
    End Sub

    ' Search placeholder: tB's ThunderRT6TextBox silently drops TextHint
    ' (and EM_SETCUEBANNER), so the cue is simulated - dimmed placeholder
    ' text while empty+unfocused, cleared on focus, restored on blur.
    Private m_cueOn As Boolean

    Private Sub EnterCue()
        On Error Resume Next
        m_cueOn = True
        txtFind.ForeColor = m_Th.TextMuted
        txtFind.Text = ChrW$(&H641C&) & ChrW$(&H7D22&) & ChrW$(&H7B14&) & ChrW$(&H8BB0&) & ChrW$(&H2026&)
    End Sub

    Private Sub LeaveCue()
        On Error Resume Next
        m_cueOn = False
        txtFind.ForeColor = m_Th.Text
        txtFind.Text = ""
    End Sub

    ' P6 cue-race guard: while m_cueOn the box carries the placeholder
    ' string, which is NOT a query. Every filter read goes through here, so
    ' a Form_Activate EnterCue racing ahead of Form_Load's RebuildFilterCurrent
    ' (pitfall 8.13-9) can never turn "搜索笔记…" into a search that empties
    ' the list on every boot.
    Private Function EffectiveQuery() As String
        If m_cueOn Then Exit Function        ' placeholder is not a query
        EffectiveQuery = txtFind.Text
    End Function

    Private Sub txtFind_Change()
        On Error Resume Next
        If m_cueOn Then Exit Sub               ' placeholder text is not a query
        RebuildFilterCurrent
        If m_sel < 0 Then m_sel = 0
        ILog "search_change", "text='" & txtFind.Text & "' visible=" & m_Repo.VisibleCount
        RedrawAll "search"
    End Sub

    Private Sub txtFind_GotFocus()
        On Error Resume Next
        If m_cueOn Then LeaveCue
    End Sub

    Private Sub txtFind_LostFocus()
        On Error Resume Next
        If (Not m_cueOn) And Len(txtFind.Text) = 0 Then EnterCue
    End Sub

    ' the search box is a permanently visible native TextBox with a Label
    ' beside it (XP dialog style) - no hidden/fake placeholder swapping

    ' ============================================= toolbar command buttons

    ' Click forwards each button's action
    Private Sub cmdNew_Click()
        NewNote
    End Sub

    Private Sub cmdTheme_Click()
        ToggleTheme
    End Sub

    ' P5-B safe box: any open safe -> lock all (VB SafeButton_Click);
    ' else open the safe dialog (unlock existing / create new - one combined
    ' dialog where VB uses two variants)
    Private Sub cmdSafe_Click()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then Exit Sub
        If Len(m_Repo.SafeFirstOpenId()) > 0 Then
            m_Repo.SafeCloseAll
            AfterSafeAction
            SetStatusMsg SSafeLockedAll()
            ILog "safe_toggle", "locked all"
            Exit Sub
        End If
        Dim openBefore As String
        openBefore = m_Repo.SafeFirstOpenId()
        ShowSafeDialog ""
        If Len(SafeDlg.LastErr) > 0 Then
            ILog "safe_dlg", "lastErr=" & SafeDlg.LastErr
        End If
        AfterSafeAction
        ' P6: unlock/create through the dialog reports in the status bar
        If (Len(openBefore) = 0) And (Len(m_Repo.SafeFirstOpenId()) > 0) Then
            SetStatusMsg SSafeUnlocked()
        End If
        Exit Sub
fail:
        ILog "safe_toggle", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' modal SafeDlg (gate auto-answer through the real button paths). Same
    ' timer-off pump + m_modalPump guard as ShowConfirmModal.
    Private Sub ShowSafeDialog(ByVal gateAnswer As String)
        On Error GoTo fail
        SafeDlg.Preload m_Repo, Me.hWnd
        If (m_shotMode Or m_gatesMode Or m_syncGate) And (Len(gateAnswer) > 0) Then
            ' gate path: consume through the real handlers without Show -
            ' the Activate-driven answer loses to foreground focus fights
            SafeDlg.GateAnswer = gateAnswer
            SafeDlg.AutoAnswerNow
            Exit Sub
        End If
        Dim timerWasOn As Boolean
        timerWasOn = tmrFmt.Enabled
        If timerWasOn Then tmrFmt.Enabled = False
        m_modalPump = True
        SafeDlg.Show 1, Me
        m_modalPump = False
        If timerWasOn Then tmrFmt.Enabled = True
        Exit Sub
fail:
        m_modalPump = False
        On Error Resume Next
        If timerWasOn Then tmrFmt.Enabled = True
        WLog "[SafeDlg] err=" & Err.Number & " " & Err.Description
    End Sub

    ' refresh list/editor + toolbar badge after any safe-state change
    ' (unlock decrypts titles, lock falls back to placeholders, import
    ' restarts the gateway session so every safe starts locked)
    Private Sub AfterSafeAction()
        UpdateSafeBadge
        RebuildFilterCurrent
        m_loadDoc = -1
        m_lockedDoc = False
        LoadNoteForEdit
        RedrawAll "safe_action"
    End Sub

    ' toolbar safe button state: caption + accent forecolor + icon swap
    ' (VB UpdateSafeStatusBadge: symbol F023/F13E + accent colors)
    Private Sub UpdateSafeBadge()
        On Error Resume Next
        Dim anyOpen As Boolean
        anyOpen = (m_Repo.IsOpen) And (Len(m_Repo.SafeFirstOpenId()) > 0)
        If anyOpen Then
            cmdSafe.Caption = SSafeOpenCap()
            SetToolbarIcon cmdSafe, "lock_open.png"
            cmdSafe.ForeColor = m_Th.SelLine
        Else
            cmdSafe.Caption = SBtnSafe()
            SetToolbarIcon cmdSafe, "lock.png"
            cmdSafe.ForeColor = &H80000012          ' system button text
        End If
    End Sub

    ' Ctrl+E: encrypt the selected note into the first open safe / remove
    ' the protection of an encrypted note (VB ToggleEncryptNoteFromUi)
    Private Sub ToggleEncryptSelectedFromUi()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then Exit Sub
        If m_binMode Then Exit Sub
        If m_sel < 0 Or m_sel >= m_Repo.VisibleCount Then Exit Sub
        Dim doc As Long
        doc = m_Repo.VisDoc(m_sel)
        Dim id As String
        id = m_Repo.NoteId(doc)
        Dim sid As String
        sid = m_Repo.NoteSafeId(doc)

        If Len(sid) > 0 Then
            ' encrypted -> remove protection (VB down-branch)
            If Not m_Repo.SafeIsOpen(sid) Then
                SetStatusMsg SSafeLockedFirst()
                ILog "note_encrypt", "locked id=" & id
                Exit Sub
            End If
            Dim rd As String
            rd = m_Repo.DecryptFromSafe(id)
            If Left$(rd, 4) = "ERR:" Then
                SetStatusMsg SDecryptFail() & rd
                ILog "note_encrypt", "FAILED unencrypt id=" & id & " " & rd
                Exit Sub
            End If
            RebuildFilterCurrent
            LoadNoteForEditDoc doc          ' plain content back, baseline reset
            RedrawAll "note_unencrypt"
            SetStatusMsg SUnencrypted()
            ILog "note_encrypt", "unencrypted id=" & id
        Else
            ' plain -> encrypt into the first open safe (VB up-branch)
            Dim openId As String
            openId = m_Repo.SafeFirstOpenId()
            If Len(openId) = 0 Then
                ShowSafeDialog ""           ' VB opens the password dialog first
                openId = m_Repo.SafeFirstOpenId()
                If Len(openId) = 0 Then Exit Sub
            End If
            Dim re As String
            re = m_Repo.EncryptToSafe(id, openId)
            If Left$(re, 4) = "ERR:" Then
                SetStatusMsg SEncryptFail() & re
                ILog "note_encrypt", "FAILED encrypt id=" & id & " " & re
                Exit Sub
            End If
            RebuildFilterCurrent
            LoadNoteForEditDoc doc          ' content unchanged, baseline reset
            RedrawAll "note_encrypt"
            SetStatusMsg SEncrypted()
            ILog "note_encrypt", "encrypted id=" & id & " safe=" & openId
        End If
        Exit Sub
fail:
        ILog "note_encrypt", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' ================================================== P5-B recycle bin

    ' Ctrl+Shift+Delete / cmdBinEmpty (bin mode only): purge EVERY note in
    ' the recycling bin after confirmation (VB recycle-bin page button)
    Private Sub EmptyRecycleBinFromUi()
        On Error GoTo fail
        If Not m_Repo.IsOpen Then Exit Sub
        If Not m_binMode Then Exit Sub
        If m_Repo.BinCount = 0 Then
            SetStatusMsg SBinAlreadyEmpty()
            Exit Sub
        End If
        If Not ShowConfirmModal(SBinTitle(), SEmptyBinQ() & " (" & m_Repo.BinCount & ")", SOkEmptyBin()) Then Exit Sub

        ' snapshot the doomed ids FIRST - DeleteNote reloads + shifts indices
        Dim ids() As String, n As Long, i As Long
        ReDim ids(0 To m_Repo.TotalCount)
        For i = 0 To m_Repo.TotalCount - 1
            If m_Repo.NoteBin(i) Then
                ids(n) = m_Repo.NoteId(i)
                n = n + 1
            End If
        Next
        Dim k As Long, fails As Long
        fails = 0
        For k = 0 To n - 1
            If Not m_Repo.DeleteNote(ids(k)) Then fails = fails + 1
        Next
        m_loadDoc = -1
        m_lockedDoc = False
        RebuildFilterCurrent
        m_sel = 0
        m_offset = 0
        LoadNoteForEdit
        RedrawAll "bin_empty"
        SetStatusMsg SEmptiedN(n - fails)    ' after the redraw
        ILog "bin_empty", "purged=" & (n - fails) & " failed=" & fails & " bin=" & m_Repo.BinCount
        Exit Sub
fail:
        ILog "bin_empty", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    Private Sub cmdBinEmpty_Click()
        EmptyRecycleBinFromUi
    End Sub

    ' ============================================== P5-B settings dialog

    ' cmdSet opens the combined settings dialog (data directory + import
    ' backup + sync settings entry); the sync dialog stays reachable from
    ' inside it
    Private Sub cmdSet_Click()
        ShowDataDirDialog
    End Sub

    Private Sub ShowDataDirDialog()
        On Error GoTo fail
        Dim dd As TbDataDir
        Set dd = New TbDataDir
        DataDirDlg.Preload dd.GetEffectiveDirectory(), BackupInitialDir(), Me.hWnd
        If m_shotMode Or m_gatesMode Or m_syncGate Then
            DataDirDlg.GateAnswer = "close"     ' gate NEVER writes the registry
        End If
        Dim timerWasOn As Boolean
        timerWasOn = tmrFmt.Enabled
        If timerWasOn Then tmrFmt.Enabled = False
        m_modalPump = True
        DataDirDlg.Show 1, Me
        m_modalPump = False
        If timerWasOn Then tmrFmt.Enabled = True

        Dim act As String
        act = DataDirDlg.Action
        If Left$(act, 8) = "savedir:" Then
            Dim newPath As String
            newPath = Mid$(act, 9)
            If ShowConfirmModal(SSetDirTitle(), SSetDirQ() & vbCrLf & newPath, SBtnOK()) Then
                Dim wd As TbDataDir
                Set wd = New TbDataDir
                If wd.WriteToRegistry(newPath) Then
                    SetStatusMsg SSetDirDone()
                    ILog "datadir", "written=" & newPath & " (effective after restart)"
                Else
                    SetStatusMsg SSetDirFail()
                    ILog "datadir", "write FAILED " & newPath
                End If
            End If
        ElseIf Left$(act, 7) = "import:" Then
            ImportBackupFromUi Mid$(act, 8)
        ElseIf StrComp(act, "sync", vbTextCompare) = 0 Then
            OpenSyncSettingsUi False
        End If
        Exit Sub
fail:
        m_modalPump = False
        On Error Resume Next
        If timerWasOn Then tmrFmt.Enabled = True
        WLog "[DataDirDlg] err=" & Err.Number & " " & Err.Description
    End Sub

    ' import a repository backup over the WORK copy (never the original
    ' under D:\Documents): confirm -> close the gateway session -> FileCopy
    ' -> OpenExisting + LoadAll -> full refresh
    Private Sub ImportBackupFromUi(ByVal srcPath As String)
        On Error GoTo fail
        If Len(srcPath) = 0 Then Exit Sub
        If Len(Dir$(srcPath, vbNormal)) = 0 Then Exit Sub
        If Not ShowConfirmModal(SImportTitle(), SImportQ(), SOkImport()) Then Exit Sub

        SaveIfDirty
        Dim totalBefore As Long
        totalBefore = m_Repo.TotalCount
        If Not m_Repo.RestoreFromBackup(srcPath, WorkRepo) Then
            SetStatusMsg SImportFail() & m_Repo.LastErr
            ILog "import_backup", "FAILED " & m_Repo.LastErr
            Exit Sub
        End If
        ' the session restart closed every safe + dropped the bin view
        m_binMode = False
        m_chipSel = 0
        m_syncChip = True
        cboTag.ListIndex = 0
        m_syncChip = False
        LayoutChips
        RebuildFilterCurrent
        m_loadDoc = -1
        m_lockedDoc = False
        m_sel = 0
        m_offset = 0
        LoadNoteForEdit
        UpdateSafeBadge
        RedrawAll "import_backup"
        ' P6: feedback carries the SOURCE file name
        Dim srcName As String
        srcName = srcPath
        If InStrRev(srcPath, "\") > 0 Then srcName = Mid$(srcPath, InStrRev(srcPath, "\") + 1)
        SetStatusMsg SImported() & ChrW$(&HFF1A&) & srcName
        ILog "import_backup", "from='" & srcPath & "' total " & totalBefore & "->" & m_Repo.TotalCount
        Exit Sub
fail:
        ILog "import_backup", "FAILED err=" & Err.Number & " " & Err.Description
    End Sub

    ' initial directory of the import file dialog: the data directory's
    ' sync_backups subfolder when it exists, else the data directory
    Private Function BackupInitialDir() As String
        On Error Resume Next
        Dim dd As TbDataDir
        Set dd = New TbDataDir
        Dim d As String
        d = dd.GetEffectiveDirectory()
        If Len(Dir$(d & "\sync_backups", vbDirectory)) > 0 Then
            BackupInitialDir = d & "\sync_backups"
        Else
            BackupInitialDir = d
        End If
    End Function

    ' ============================================================ P4 sync

    Private Sub cmdSync_Click()
        RunSyncNow
    End Sub

    ' toolbar save: explicit save of the current note (in addition to the
    ' switch-away and unload saves)
    Private Sub cmdSaveN_Click()
        If Not m_editReady Or m_loadDoc < 0 Then Exit Sub
        If Not m_Repo.IsOpen Then Exit Sub
        Dim wasDirty As Boolean
        wasDirty = EditorDirty()
        SaveIfDirty
        If wasDirty Then
            SetStatusMsg SSaved()
        Else
            SetStatusMsg SNothingToSave()
        End If
    End Sub

    ' (cmdSet_Click lives in the P5-B settings dialog section)

    Private Function SyncIniPathR() As String
        If Len(m_syncIniOverride) > 0 Then
            SyncIniPathR = m_syncIniOverride
        Else
            SyncIniPathR = SyncIniPath
        End If
    End Function

    ' P6 status-bar feedback (replaces the bare SyncStatus caption write):
    ' SetStatusMsg shows an operation message in the LEFT cell and arms
    ' tmrStatus (5s one-shot); RevertStatus restores the default row - left
    ' cell = counts line (or bin line), right cell = sync status. Surviving
    ' redraws: DrawStatusBar writes m_statusMsg while it is set, so a
    ' RepaintListFast between the action and the revert keeps the message.
    Private Sub SetStatusMsg(ByVal msg As String)
        On Error Resume Next
        m_statusMsg = msg
        lblStatusL.Caption = msg
        tmrStatus.Enabled = False            ' restart the one-shot
        tmrStatus.Interval = 5000
        tmrStatus.Enabled = True
        RedrawAll "status_msg"               ' immediate strip repaint: the
                                             ' GDI text must not lag a beat
    End Sub

    ' back to the steady-state row (also the RevertStatus gate target)
    Private Sub RevertStatus()
        On Error Resume Next
        m_statusMsg = ""
        tmrStatus.Enabled = False
        lblStatusL.Caption = DefaultLeftText()
        lblStatusR.Caption = ""
        RedrawAll "status_revert"
    End Sub

    ' the default LEFT cell text (counts / recycle-bin / load-fail)
    Private Function DefaultLeftText() As String
        On Error Resume Next
        If Not m_Repo.IsOpen Then
            DefaultLeftText = SLoadFail()
        ElseIf m_binMode Then
            DefaultLeftText = SRecycleBin() & " " & SMidDot() & " " & m_Repo.BinCount & " " & SNotesUnit()
        Else
            DefaultLeftText = m_Repo.VisibleCount & " " & SNotesUnit() & " " & SMidDot() & " " & m_Repo.TagCount & " " & STagsUnit()
        End If
    End Function

    ' 5s elapsed -> back to the default row. Modal-pump guard: an owner
    ' window's WM_TIMER still dispatches inside a modal pump - defer the
    ' revert until the dialog is gone (pitfall 8.16-2 lesson)
    Private Sub tmrStatus_Timer()
        On Error Resume Next
        If m_modalPump Then Exit Sub
        RevertStatus
    End Sub

    ' lazy init: Chilkat reg-free actx + Crypt2 + Gzip. Cheap after the
    ' first call (objects are kept for the session).
    Private Function SyncEnsureInfra() As Boolean
        On Error GoTo fail
        If m_Ck Is Nothing Then
            Set m_Ck = New TbChilkat
            If Not m_Ck.Init(ChilkatDir & "\chilkat.manifest", ChilkatDir) Then
                WLog "[Sync.infra] chilkat actx failed le=" & m_Ck.LastWin32Error
                Exit Function
            End If
        End If
        If m_Crypto Is Nothing Then
            Dim et As String
            Set m_Crypto = New TbCrypto
            If Not m_Crypto.Init(m_Ck, et) Then
                WLog "[Sync.infra] TbCrypto init failed: " & et
                Exit Function
            End If
        End If
        If m_Transfer Is Nothing Then
            Dim et2 As String
            Set m_Transfer = New TbTransfer
            If Not m_Transfer.Init(m_Crypto, m_Ck, et2) Then
                WLog "[Sync.infra] TbTransfer init failed: " & et2
                Exit Function
            End If
        End If
        SyncEnsureInfra = True
        Exit Function
    fail:
        WLog "[Sync.infra] err=" & Err.Number & " " & Err.Description
    End Function

    Private Function SyncLoadSettings() As Boolean
        If m_SyncSettings Is Nothing Then Set m_SyncSettings = New TbSyncSettings
        m_SyncSettings.Load SyncIniPathR()
        SyncLoadSettings = True
    End Function

    ' modal settings dialog; True when confirmed+saved
    Private Function OpenSyncSettingsUi(ByVal fromSync As Boolean) As Boolean
        On Error GoTo fail
        If Not SyncEnsureInfra() Then Exit Function
        SyncLoadSettings
        SyncDlg.Preload Me.hWnd
        SyncDlg.ServerUrl = m_SyncSettings.ServerUrl
        SyncDlg.Username = m_SyncSettings.Username
        SyncDlg.Password = m_SyncSettings.Password
        SyncDlg.TransferCode = m_SyncSettings.TransferCode
        SyncDlg.Hint = SSettingsHint()
        If m_shotMode Or m_gatesMode Or m_syncGate Then
            ' gate path: consume GateApply through the real handler without
            ' Show (the Activate-driven answer loses to focus fights)
            SyncDlg.GateApply = True
            SyncDlg.ApplyNow
        Else
            ShowModalGuarded SyncDlg
        End If
        If Not SyncDlg.Confirmed Then Exit Function
        m_SyncSettings.ServerUrl = SyncDlg.ServerUrl
        m_SyncSettings.Username = SyncDlg.Username
        m_SyncSettings.Password = SyncDlg.Password
        ' accept grouped input ("xxxx xxxx" / "xxxx-xxxx"), reject garbage
        Dim c As String
        c = m_Transfer.SanitizeCode(SyncDlg.TransferCode)
        If Len(SyncDlg.TransferCode) = 0 Then
            m_SyncSettings.TransferCode = ""
        ElseIf Len(c) > 0 Then
            m_SyncSettings.TransferCode = c
        Else
            SetStatusMsg SSyncBadCode()
        End If
        m_SyncSettings.Save SyncIniPathR()
        OpenSyncSettingsUi = True
        Exit Function
    fail:
        WLog "[Sync.settings] dialog err=" & Err.Number & " " & Err.Description
    End Function

    ' One full synchronization, original SynchronizationStory semantics:
    ' remote missing -> upload (generate transfer code when none set);
    ' same repository id -> ALWAYS merge (gateway NoteRepositoryMerger),
    ' write local / upload only the changed sides (fingerprint flags);
    ' different id -> three-way choice dialog (merge/local/cloud).
    ' Result: uploaded_new|clean|merged|uploaded|downloaded|conflict_choice|
    ' cancelled|error (the sync gates assert on these codes).
    Private Function RunSyncNow() As String
        Dim res As String
        res = "error"
        m_syncBusy = True
        On Error GoTo done

        If Not SyncEnsureInfra() Then GoTo done
        If Not SyncLoadSettings() Then GoTo done
        If Not m_SyncSettings.IsConfigured() Then
            If Not OpenSyncSettingsUi(True) Then
                res = "cancelled"
                SetStatusMsg SSyncCancelled()
                GoTo done
            End If
            If Not m_SyncSettings.IsConfigured() Then
                SetStatusMsg SSyncNotConfigured()
                GoTo done
            End If
        End If

        SetStatusMsg SSyncing()

        ' 1. persist pending edits, read the local repository
        SaveIfDirty
        If m_Repo.IsOpen Then m_Repo.SaveNow
        Dim localBytes() As Byte
        If Not ReadBytesF(WorkRepo, localBytes) Then
            SetStatusMsg SSyncFailed() & "local repository read failed"
            GoTo done
        End If
        If m_SyncId Is Nothing Then
            Set m_SyncId = New TbSync
            m_SyncId.Init Nothing, m_Crypto, WorkRepo, "", SyncBackupDir, ""
        End If
        Dim localId As String
        localId = m_SyncId.RepoIdOfBytes(localBytes)

        ' 2. transport
        Dim wd As TbWebdav
        Set wd = New TbWebdav
        Dim et As String
        If Not wd.Init(m_Ck, m_SyncSettings.ServerUrl, m_SyncSettings.Username, m_SyncSettings.Password, et) Then
            SetStatusMsg SSyncFailed() & et
            GoTo done
        End If
        Dim fileUrl As String
        fileUrl = m_SyncSettings.RepoFileUrl()

        ' 3. remote present?
        Dim props As TbWebdavProps
        If Not wd.Propfind(fileUrl, props) Then
            SetStatusMsg SSyncFailed() & wd.LastError
            WLog "[Sync.run] propfind failed: " & wd.LastError & " status=" & wd.LastStatus
            GoTo done
        End If

        Dim uploadBytes() As Byte
        uploadBytes = localBytes
        Dim didBackup As Boolean
        Dim newCode As String
        newCode = ""

        If Not props.Exists Then
            ' first upload; a missing transfer code gets a fresh generated one
            If Len(m_SyncSettings.TransferCode) = 0 Then
                newCode = m_Transfer.GenerateCode()
                m_SyncSettings.TransferCode = newCode
            End If
            Dim packed() As Byte
            If Not m_Transfer.EncryptRepo(localBytes, m_SyncSettings.TransferCode, packed) Then
                SetStatusMsg SSyncFailed() & m_Transfer.LastErr
                GoTo done
            End If
            If Not m_SyncId.CreateBackup() Then WLog "[Sync.run] backup failed (continuing)"
            If Not wd.PutFile(fileUrl, packed) Then
                SetStatusMsg SSyncFailed() & "PUT status=" & wd.LastStatus
                GoTo done
            End If
            If Len(newCode) > 0 Then
                m_SyncSettings.Save SyncIniPathR()
                AnnounceNewCode newCode
            End If
            res = "uploaded_new"
            SetStatusMsg SSyncUploaded()
            GoTo done
        End If

        ' 4. download + decrypt the cloud repository
        Dim cloudBytes() As Byte
        If Not wd.GetFile(fileUrl, cloudBytes) Then
            SetStatusMsg SSyncFailed() & "GET status=" & wd.LastStatus
            GoTo done
        End If
        Dim _t0 As Single, _ta As Single
        _t0 = Timer
        WLog "[Sync.t] after GET"
        Dim cloudXml() As Byte
        If m_Transfer.LooksEncrypted(cloudBytes) Then
            If Not m_Transfer.DecryptRepo(cloudBytes, m_SyncSettings.TransferCode, cloudXml) Then
                If StrComp(m_Transfer.LastErr, "wrong_transfer_code", vbTextCompare) = 0 Then
                    SetStatusMsg SSyncWrongCode()
                Else
                    SetStatusMsg SSyncFailed() & m_Transfer.LastErr
                End If
                WLog "[Sync.run] cloud decrypt failed: " & m_Transfer.LastErr
                GoTo done
            End If
        ElseIf LooksLikeXmlB(cloudBytes) Then
            cloudXml = cloudBytes
            WLog "[Sync.run] cloud repository is PLAINTEXT xml (unexpected for original clients)"
        Else
            SetStatusMsg SSyncFailed() & "cloud blob is neither encrypted nor xml"
            GoTo done
        End If
        _ta = Timer
        WLog "[Sync.t] after decrypt +" & Format(_ta - _t0, "0.00") & "s"

        ' 5. repository id comparison
        Dim cloudId As String
        cloudId = m_SyncId.RepoIdOfBytes(cloudXml)
        WLog "[Sync.t] after repoid +" & Format(Timer - _ta, "0.00") & "s"
        If (Len(localId) > 0) And (Len(cloudId) > 0) Then
            If StrComp(localId, cloudId, vbTextCompare) <> 0 Then
                Dim choice As String
                choice = AskMergeChoice()
                WLog "[Sync.run] id mismatch local=" & localId & " cloud=" & cloudId & " choice=" & choice
                If Len(choice) = 0 Then
                    res = "cancelled"
                    SetStatusMsg SSyncCancelled()
                    GoTo done
                ElseIf StrComp(choice, "cloud", vbTextCompare) = 0 Then
                    If Not didBackup Then
                        If Not m_SyncId.CreateBackup() Then
                            SetStatusMsg SSyncFailed() & "backup failed"
                            GoTo done
                        End If
                        didBackup = True
                    End If
                    If Not WriteBytesF(WorkRepo, cloudXml) Then
                        SetStatusMsg SSyncFailed() & "local write failed"
                        GoTo done
                    End If
                    SyncApplyRepoChanged
                    res = "downloaded"
                    SetStatusMsg SSyncDownloaded()
                    GoTo done
                ElseIf StrComp(choice, "local", vbTextCompare) = 0 Then
                    res = "uploaded"
                    GoTo doUpload
                End If
                ' "merge" falls through into the merge path
            End If
        End If

        ' 6. merge (same repository id, or explicit merge choice)
        Dim rMerge As String
        _ta = Timer
        WLog "[Sync.t] before MergeWithCloud"
        rMerge = m_Repo.MergeWithCloud(B64OfBytes(cloudXml))
        WLog "[Sync.t] after MergeWithCloud +" & Format(Timer - _ta, "0.00") & "s head=" & Left$(rMerge, 12)
        If Left$(rMerge, 4) = "ERR:" Then
            SetStatusMsg SSyncFailed() & rMerge
            GoTo done
        End If
        Dim mp() As String
        mp = Split(rMerge, "|")
        Dim eqLocal As Boolean
        Dim eqCloud As Boolean
        eqLocal = (StrComp(mp(0), "OK:1", vbBinaryCompare) = 0)
        eqCloud = (StrComp(mp(1), "1", vbBinaryCompare) = 0)
        Dim mergedBytes() As Byte
        mergedBytes = BytesOfB64(mp(2))

        If eqLocal And eqCloud Then
            res = "clean"
            SetStatusMsg SSyncClean()
            GoTo done
        End If

        If Not eqLocal Then
            If Not didBackup Then
                If Not m_SyncId.CreateBackup() Then
                    SetStatusMsg SSyncFailed() & "backup failed"
                    GoTo done
                End If
                didBackup = True
            End If
            If Not WriteBytesF(WorkRepo, mergedBytes) Then
                SetStatusMsg SSyncFailed() & "local write failed"
                GoTo done
            End If
            WLog "[Sync.t] after local write +" & Format(Timer - _t0, "0.00") & "s"
            SyncApplyRepoChanged
            WLog "[Sync.t] after apply +" & Format(Timer - _t0, "0.00") & "s"
        End If
        If eqCloud Then
            ' the cloud already holds the merged state - only the local write
            ' was needed, a PUT would re-upload byte-identical content
            res = "downloaded"
            SetStatusMsg SSyncDownloaded()
        Else
            uploadBytes = mergedBytes
            If eqLocal Then
                res = "uploaded"
            Else
                res = "merged"
            End If
            GoTo doUpload
        End If

doUpload:
        _ta = Timer
        Dim packedU() As Byte
        If Not m_Transfer.EncryptRepo(uploadBytes, m_SyncSettings.TransferCode, packedU) Then
            SetStatusMsg SSyncFailed() & m_Transfer.LastErr
            GoTo done
        End If
        WLog "[Sync.t] after encrypt +" & Format(Timer - _ta, "0.00") & "s"
        If Not wd.PutFile(fileUrl, packedU) Then
            SetStatusMsg SSyncFailed() & "PUT status=" & wd.LastStatus
            GoTo done
        End If
        If res = "uploaded" Then SetStatusMsg SSyncUploaded()
        If res = "merged" Then SetStatusMsg SSyncMerged()

done:
        If res = "error" Then
            WLog "[Sync.run] ended with error"
            If Err.Number <> 0 Then
                LogCrash "RunSyncNow ended with error err=" & Err.Number & " " & Err.Description
            Else
                LogCrash "RunSyncNow ended with error (infra/settings failure)"
            End If
        End If
        WLog "[Sync.done] res=" & res & " local=" & localId & " cloud=" & cloudId
        RunSyncNow = res
        m_syncBusy = False
    End Function

    ' conflict choice (MergeDlg); gates auto-answer via -syncchoice=
    Private Function AskMergeChoice() As String
        On Error Resume Next
        If Len(m_syncChoice) > 0 Then
            AskMergeChoice = m_syncChoice
            Exit Function
        End If
        MergeDlg.Preload Me.hWnd
        ShowModalGuarded MergeDlg
        AskMergeChoice = MergeDlg.Choice
    End Function

    ' reopen the (rewritten) work repository and refresh list/editor
    Private Sub SyncApplyRepoChanged()
        On Error Resume Next
        m_Repo.ReloadSession WorkRepo
        m_loadDoc = -1
        m_sel = 0
        m_offset = 0
        RebuildFilterCurrent
        ClampScroll
        LoadNoteForEdit
        RedrawAll "sync_apply"
    End Sub

    Private Sub AnnounceNewCode(ByVal code As String)
        Dim disp As String
        disp = m_Transfer.FormatCodeForDisplay(code)
        WLog "[Sync.newcode] transfer code created: " & disp & " (saved to sync settings)"
        If m_shotMode Or m_gatesMode Or m_syncGate Then Exit Sub
        On Error Resume Next
        MsgBox SNewCodeMsg1() & vbCrLf & disp & vbCrLf & vbCrLf & SNewCodeMsg2(), 0, SSyncTitle()
    End Sub

    ' ------------------------------------------------------------ helpers

    Private Function LooksLikeXmlB(data() As Byte) As Boolean
        On Error Resume Next
        Dim n As Long
        n = ArrLenB(data)
        If n > 512 Then n = 512
        Dim head() As Byte
        ReDim head(0 To n - 1)
        Dim i As Long
        For i = 0 To n - 1
            head(i) = data(i)
        Next
        Dim s As String
        s = m_U8.Decode(head)
        If InStr(1, s, "<?xml", vbTextCompare) > 0 Then
            LooksLikeXmlB = True
        ElseIf InStr(1, s, "<silentnotes", vbTextCompare) > 0 Then
            LooksLikeXmlB = True
        End If
    End Function

    Private Function ReadBytesF(ByVal path As String, ByRef data() As Byte) As Boolean
        On Error GoTo fail
        Dim f As Integer
        Dim n As Long
        f = FreeFile
        Open path For Binary Access Read As #f
        n = LOF(f)
        If n > 0 Then
            ReDim data(0 To n - 1)
            Get #f, , data
        End If
        Close #f
        ReadBytesF = True
        Exit Function
    fail:
    End Function

    ' strong-typed Byte() before Put (Variant writes a 12-byte descriptor)
    Private Function WriteBytesF(ByVal path As String, ByRef data() As Byte) As Boolean
        On Error GoTo fail
        Dim ba() As Byte
        ba = data
        If Len(Dir$(path, vbNormal)) > 0 Then Kill path
        Dim f As Integer
        f = FreeFile
        Open path For Binary Access Write As #f
        Put #f, , ba
        Close #f
        WriteBytesF = True
        Exit Function
    fail:
    End Function

    Private Function B64OfBytes(ByRef data() As Byte) As String
        On Error Resume Next
        Dim b As TbBase64
        Set b = New TbBase64
        B64OfBytes = b.Encode(data)
    End Function

    Private Function BytesOfB64(ByVal s As String) As Byte()
        On Error Resume Next
        Dim b As TbBase64
        Set b = New TbBase64
        Dim v As Variant
        v = b.Decode(s)
        If IsArray(v) Then
            Dim ba() As Byte
            ba = v
            BytesOfB64 = ba
        End If
    End Function

    Private Function CountSubStr(ByVal s As String, ByVal subS As String) As Long
        Dim c As Long
        Dim p As Long
        p = InStr(1, s, subS, vbBinaryCompare)
        Do While p > 0
            c = c + 1
            p = InStr(p + 1, s, subS, vbBinaryCompare)
        Loop
        CountSubStr = c
    End Function

    Private Function ArrLenB(b() As Byte) As Long
        On Error GoTo emptyArr
        ArrLenB = UBound(b) + 1
        Exit Function
    emptyArr:
        ArrLenB = 0
    End Function

    Private Function BytesEqual(a() As Byte, b() As Byte) As Boolean
        Dim n As Long
        n = ArrLenB(a)
        If n <> ArrLenB(b) Then Exit Function
        Dim i As Long
        For i = 0 To n - 1
            If a(i) <> b(i) Then Exit Function
        Next
        BytesEqual = True
    End Function

