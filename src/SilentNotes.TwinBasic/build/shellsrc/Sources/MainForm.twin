    Private Function SSetDirDone() As String     ' "数据目录已写入，重启后生效"
        SSetDirDone = ChrW$(&H6570&) & ChrW$(&H636E&) & ChrW$(&H76EE&) & ChrW$(&H5F55&) & _
            ChrW$(&H5DF2&) & ChrW$(&H5199&) & ChrW$(&H5165&) & ChrW$(&HFF0C&) & _
            ChrW$(&H91CD&) & ChrW$(&H542F&) & ChrW$(&H540E&) & ChrW$(&H751F&) & _
            ChrW$(&H6548&)
    End Function

    Private Function SSetDirFail() As String     ' "数据目录写入失败"
        SSetDirFail = ChrW$(&H6570&) & ChrW$(&H636E&) & ChrW$(&H76EE&) & ChrW$(&H5F55&) & _
            ChrW$(&H5199&) & ChrW$(&H5165&) & ChrW$(&H5931&) & ChrW$(&H8D25&)
    End Function

#If Not CBool(RELEASE_BUILD) Then
    ' synthetic rich probe html for the editor gates (empty mode / fallback)
    Private Function SRichProbeHtml() As String
        SRichProbeHtml = "<h1>gate heading</h1><p>hello <b>bold</b> and <i>italic</i> text</p>" & _
            "<ul><li>alpha</li><li>beta</li></ul><blockquote>quoted line</blockquote>" & _
            "<p><a href=""https://example.invalid/"">a link</a> tail</p><hr>"
    End Function

    ' capture-only demo html for screenshots (never saved)
    Private Function SRichDemoHtml() As String
        Dim t As String
        ' 鎷ユ姳鎷熺墿鏂拌瑙?        t = "<h1>" & ChrW$(&H62E5&) & ChrW$(&H62B1&) & ChrW$(&H62DF&) & ChrW$(&H7269&) & ChrW$(&H65B0&) & ChrW$(&H89C6&) & ChrW$(&H89C9&) & "</h1>"
        ' 杩欐槸鏂扮殑缂栬緫鍣ㄧ焊闈細鍔犵矖銆佹枩浣撲笌娓呭崟鍦ㄥ師鐢?MSHTML 涓紪杈戙€?        t = t & "<p>" & ChrW$(&H8FD9&) & ChrW$(&H662F&) & ChrW$(&H65B0&) & ChrW$(&H7684&) & ChrW$(&H7F16&) & ChrW$(&H8F91&) & ChrW$(&H5668&) & ChrW$(&H7EB8&) & ChrW$(&H9762&) & ChrW$(&HFF1A&) & "<b>" & ChrW$(&H52A0&) & ChrW$(&H7C97&) & "</b>" & ChrW$(&H3001&) & "<i>" & ChrW$(&H659C&) & ChrW$(&H4F53&) & "</i>" & ChrW$(&H4E0E&) & ChrW$(&H6E05&) & ChrW$(&H5355&) & ChrW$(&H5728&) & ChrW$(&H539F&) & ChrW$(&H751F&) & " MSHTML " & ChrW$(&H4E2D&) & ChrW$(&H7F16&) & ChrW$(&H8F91&) & ChrW$(&H3002&) & "</p>"
        ' 鏀寔鍔犵矖涓庢爣棰?/ 鍒楄〃椤逛簩
        t = t & "<ul><li>" & ChrW$(&H652F&) & ChrW$(&H6301&) & ChrW$(&H52A0&) & ChrW$(&H7C97&) & ChrW$(&H4E0E&) & ChrW$(&H6807&) & ChrW$(&H9898&) & "</li><li>" & ChrW$(&H5217&) & ChrW$(&H8868&) & ChrW$(&H9879&) & ChrW$(&H4E8C&) & "</li></ul>"
        ' 寮曠敤涓€琛?        t = t & "<blockquote>" & ChrW$(&H5F15&) & ChrW$(&H7528&) & ChrW$(&H4E00&) & ChrW$(&H884C&) & "</blockquote>"
        t = t & "<p><a href=""https://example.invalid/"">" & ChrW$(&H793A&) & ChrW$(&H4F8B&) & ChrW$(&H94FE&) & ChrW$(&H63A5&) & "</a></p>"
        SRichDemoHtml = t
    End Function
#End If

End Class
