    ' spec reference table (hex written 0xRRGGBB) used by the startup gate
    Public Function SpecValue(ByVal themeName As String, ByVal i As Long) As Long
        Dim v As Long
        v = -1
        If CanonicalName(themeName) = "blue" Then
            Select Case i
                Case T_TITLEGRADTOP: v = &HFAFCFE
                Case T_TITLEGRADBOT: v = &HC9D9EC
                Case T_TITLELINE: v = &H99B3CE
                Case T_TITLETEXT: v = &H1E395B
                Case T_FRAME: v = &H6E8BB0
                Case T_TOOLGRADTOP: v = &HD4D0C8
                Case T_TOOLGRADBOT: v = &HD4D0C8
                Case T_TOOLLINE: v = &H808080
                Case T_BTNHOVERTOP: v = &HFFFFFF
                Case T_BTNHOVERBOT: v = &HDCE4EF
                Case T_BTNHOVERLINE: v = &H98B5D1
                Case T_CAPHOVERTOP: v = &HFDE8CC
                Case T_CAPHOVERBOT: v = &HF8DDC0
                Case T_CAPHOVERLINE: v = &HE19602
                Case T_CLOSEHOVERTOP: v = &HD14B4B
                Case T_CLOSEHOVERBOT: v = &HC24444
                Case T_TAGBG: v = &HD4D0C8
                Case T_CHIPTOP: v = &HD4D0C8
                Case T_CHIPBOT: v = &HD4D0C8
                Case T_CHIPLINE: v = &H808080
                Case T_CHIPTEXT: v = &H0
                Case T_CHIPSELTOP: v = &H316AC5
                Case T_CHIPSELBOT: v = &H316AC5
                Case T_CHIPSELLINE: v = &H316AC5
                Case T_LISTBG: v = &HFFFFFF
                Case T_ITEMHOVER: v = &HE0E0E0
                Case T_SELTOP: v = &H316AC5
                Case T_SELBOT: v = &H316AC5
                Case T_SELLINE: v = &H316AC5
                Case T_SELBAR: v = &H316AC5
                Case T_PINTRI: v = &HA246A
                Case T_LOCKC: v = &H808080
                Case T_EDITPANEL: v = &HD4D0C8
                Case T_EDITSHEET: v = &HFFFFFF
                Case T_SUNKENLIGHT: v = &HFFFFFF
                Case T_SUNKENDARK: v = &H808080
                Case T_SEARCHLINE: v = &H808080
                Case T_SEARCHFOCUS: v = &H316AC5
                Case T_STATUSTOP: v = &HD4D0C8
                Case T_STATUSBOT: v = &HD4D0C8
                Case T_STATUSLINE: v = &H808080
                Case T_GRIP: v = &H808080
                Case T_TEXT: v = &H0
                Case T_TEXTMUTED: v = &H808080
                Case T_BRANDDOT: v = &H2A609E
                Case T_ROWSEP: v = &HC0C0C0
            End Select
        Else
            Select Case i
                Case T_TITLEGRADTOP: v = &H4A5058
                Case T_TITLEGRADBOT: v = &H2F343A
                Case T_TITLELINE: v = &H22262A
                Case T_TITLETEXT: v = &HE8EAED
                Case T_FRAME: v = &H1A1D20
                Case T_TOOLGRADTOP: v = &H3A4046
                Case T_TOOLGRADBOT: v = &H2E3439
                Case T_TOOLLINE: v = &H22262A
                Case T_BTNHOVERTOP: v = &H4E565F
                Case T_BTNHOVERBOT: v = &H4A515A
                Case T_BTNHOVERLINE: v = &H6B7480
                Case T_CAPHOVERTOP: v = &H5C646E
                Case T_CAPHOVERBOT: v = &H565E67
                Case T_CAPHOVERLINE: v = &H6B7480
                Case T_CLOSEHOVERTOP: v = &HB03A3A
                Case T_CLOSEHOVERBOT: v = &HA53535
                Case T_TAGBG: v = &H2B3036
                Case T_CHIPTOP: v = &H3E454D
                Case T_CHIPBOT: v = &H3A4048
                Case T_CHIPLINE: v = &H5A6470
                Case T_CHIPTEXT: v = &HCDD3DA
                Case T_CHIPSELTOP: v = &H4E6178
                Case T_CHIPSELBOT: v = &H42546A
                Case T_CHIPSELLINE: v = &H7489A4
                Case T_LISTBG: v = &H32373D
                Case T_ITEMHOVER: v = &H3E454D
                Case T_SELTOP: v = &H0078D7
                Case T_SELBOT: v = &H0078D7
                Case T_SELLINE: v = &H0078D7
                Case T_SELBAR: v = &H0078D7
                Case T_PINTRI: v = &H9DB8E0
                Case T_LOCKC: v = &H9AA5B1
                Case T_EDITPANEL: v = &H26292E
                Case T_EDITSHEET: v = &H202429
                Case T_SUNKENLIGHT: v = &H4A5158
                Case T_SUNKENDARK: v = &H14171A
                Case T_SEARCHLINE: v = &H14171A
                Case T_SEARCHFOCUS: v = &H7C93B5
                Case T_STATUSTOP: v = &H343940
                Case T_STATUSBOT: v = &H2A2E33
                Case T_STATUSLINE: v = &H22262A
                Case T_GRIP: v = &H4E565F
                Case T_TEXT: v = &HE8EAED
                Case T_TEXTMUTED: v = &H8A929C
                Case T_BRANDDOT: v = &H7C93B5
                Case T_ROWSEP: v = &H3C434B
            End Select
        End If
        If v < 0 Then
            SpecValue = -1
        Else
            SpecValue = RGB((v \ &H10000) And &HFF, (v \ &H100) And &HFF, v And &HFF)
        End If
    End Function

    Public Function Toggle() As String
        If StrComp(m_Name, "graphite", vbTextCompare) = 0 Then
            Apply "blue"
        Else
            Apply "graphite"
        End If
        Toggle = m_Name
    End Function

    ' --------------------------------------------------------- persistence

    ' Reads ui.theme from the ini; legacy light/dark map to blue/graphite.
    ' Missing file / key / unknown value -> "blue".
    Public Function LoadFromIni(iniPath As String) As String
        Dim ini As TbIni
        Dim v As String
        On Error GoTo fallback
        Set ini = New TbIni
        If ini.Load(iniPath) Then
            v = ini.GetValue("ui", "theme", "blue")
        Else
            v = "blue"
        End If
        If Len(v) = 0 Then v = "blue"
        If Not Apply(v) Then Apply "blue"
        LoadFromIni = m_Name
        Exit Function
fallback:
        Apply "blue"
        LoadFromIni = m_Name
    End Function

    ' Writes ui.theme=<canonical name> into the ini (creates it when missing).
    Public Function SaveToIni(iniPath As String) As Boolean
        Dim ini As TbIni
        On Error GoTo fail
        Set ini = New TbIni
        If Not ini.Load(iniPath) Then
            SeedIniFile iniPath
            Set ini = New TbIni
            If Not ini.Load(iniPath) Then Exit Function
        End If
        ini.SetValue "ui", "theme", m_Name
        SaveToIni = ini.Save(iniPath)
        Exit Function
fail:
        SaveToIni = False
    End Function

    ' TbIni.SetValue is a no-op on an unloaded instance, so a missing file is
    ' seeded with a minimal [ui] section first (UTF-8, BOM-less).
    Private Sub SeedIniFile(ByVal iniPath As String)
        On Error Resume Next
        Dim u8 As TbUtf8
        Dim ba() As Byte
        Dim f As Integer
        Set u8 = New TbUtf8
        ba = u8.Encode("[ui]" & vbCrLf & "theme=" & m_Name & vbCrLf)
        f = FreeFile
        Open iniPath For Binary Access Write As #f
        Put #f, , ba
        Close #f
    End Sub

End Class
