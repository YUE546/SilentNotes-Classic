Option Explicit

' TbTheme - skeuomorphic dual theme token table for the P2 shell.
' blue     = classic Office 2007 Blue family (replaces flat "light")
' graphite = Krypton Sparkle dark family  (replaces flat "dark")
' Legacy ini values map on read: light -> blue, dark -> graphite; the ini is
' only ever written the new names. Values are COLORREF (0x00BBGGRR).
'
' Tokens are stored in m_t() indexed by T_* constants; named Property Gets
' expose them to the drawing code, TokenValue/TokenName/TokenCount let the
' startup gate diff the applied table against SpecValue (the spec table).

Class TbTheme

    ' ------------------------------------------------------- token indices

    Private Const T_TITLEGRADTOP = 0
    Private Const T_TITLEGRADBOT = 1
    Private Const T_TITLELINE = 2
    Private Const T_TITLETEXT = 3
    Private Const T_FRAME = 4
    Private Const T_TOOLGRADTOP = 5
    Private Const T_TOOLGRADBOT = 6
    Private Const T_TOOLLINE = 7
    Private Const T_BTNHOVERTOP = 8
    Private Const T_BTNHOVERBOT = 9
    Private Const T_BTNHOVERLINE = 10
    Private Const T_CAPHOVERTOP = 11
    Private Const T_CAPHOVERBOT = 12
    Private Const T_CAPHOVERLINE = 13
    Private Const T_CLOSEHOVERTOP = 14
    Private Const T_CLOSEHOVERBOT = 15
    Private Const T_TAGBG = 16
    Private Const T_CHIPTOP = 17
    Private Const T_CHIPBOT = 18
    Private Const T_CHIPLINE = 19
    Private Const T_CHIPTEXT = 20
    Private Const T_CHIPSELTOP = 21
    Private Const T_CHIPSELBOT = 22
    Private Const T_CHIPSELLINE = 23
    Private Const T_LISTBG = 24
    Private Const T_ITEMHOVER = 25
    Private Const T_SELTOP = 26
    Private Const T_SELBOT = 27
    Private Const T_SELLINE = 28
    Private Const T_SELBAR = 29
    Private Const T_PINTRI = 30
    Private Const T_LOCKC = 31
    Private Const T_EDITPANEL = 32
    Private Const T_EDITSHEET = 33
    Private Const T_SUNKENLIGHT = 34
    Private Const T_SUNKENDARK = 35
    Private Const T_SEARCHLINE = 36
    Private Const T_SEARCHFOCUS = 37
    Private Const T_STATUSTOP = 38
    Private Const T_STATUSBOT = 39
    Private Const T_STATUSLINE = 40
    Private Const T_GRIP = 41
    Private Const T_TEXT = 42
    Private Const T_TEXTMUTED = 43
    Private Const T_BRANDDOT = 44
    Private Const T_ROWSEP = 45

    Private Const T_COUNT = 46

    Private m_Name As String
    Private m_t(0 To 45) As Long

    Private Sub Class_Initialize()
        Apply "blue"
    End Sub

    ' -------------------------------------------------------------- counts

    Public Property Get TokenCount() As Long
        TokenCount = T_COUNT
    End Property

    Public Property Get TokenValue(ByVal i As Long) As Long
        If i >= 0 And i < T_COUNT Then TokenValue = m_t(i)
    End Property

    Public Property Get TokenName(ByVal i As Long) As String
        TokenName = TokenNameByIdx(i)
    End Property

    Private Function TokenNameByIdx(ByVal i As Long) As String
        Select Case i
            Case T_TITLEGRADTOP: TokenNameByIdx = "titleGradTop"
            Case T_TITLEGRADBOT: TokenNameByIdx = "titleGradBot"
            Case T_TITLELINE: TokenNameByIdx = "titleLine"
            Case T_TITLETEXT: TokenNameByIdx = "titleText"
            Case T_FRAME: TokenNameByIdx = "frame"
            Case T_TOOLGRADTOP: TokenNameByIdx = "toolGradTop"
            Case T_TOOLGRADBOT: TokenNameByIdx = "toolGradBot"
            Case T_TOOLLINE: TokenNameByIdx = "toolLine"
            Case T_BTNHOVERTOP: TokenNameByIdx = "btnHoverTop"
            Case T_BTNHOVERBOT: TokenNameByIdx = "btnHoverBot"
            Case T_BTNHOVERLINE: TokenNameByIdx = "btnHoverLine"
            Case T_CAPHOVERTOP: TokenNameByIdx = "capHoverTop"
            Case T_CAPHOVERBOT: TokenNameByIdx = "capHoverBot"
            Case T_CAPHOVERLINE: TokenNameByIdx = "capHoverLine"
            Case T_CLOSEHOVERTOP: TokenNameByIdx = "closeHoverTop"
            Case T_CLOSEHOVERBOT: TokenNameByIdx = "closeHoverBot"
            Case T_TAGBG: TokenNameByIdx = "tagBg"
            Case T_CHIPTOP: TokenNameByIdx = "chipTop"
            Case T_CHIPBOT: TokenNameByIdx = "chipBot"
            Case T_CHIPLINE: TokenNameByIdx = "chipLine"
            Case T_CHIPTEXT: TokenNameByIdx = "chipText"
            Case T_CHIPSELTOP: TokenNameByIdx = "chipSelTop"
            Case T_CHIPSELBOT: TokenNameByIdx = "chipSelBot"
            Case T_CHIPSELLINE: TokenNameByIdx = "chipSelLine"
            Case T_LISTBG: TokenNameByIdx = "listBg"
            Case T_ITEMHOVER: TokenNameByIdx = "itemHover"
            Case T_SELTOP: TokenNameByIdx = "selTop"
            Case T_SELBOT: TokenNameByIdx = "selBot"
            Case T_SELLINE: TokenNameByIdx = "selLine"
            Case T_SELBAR: TokenNameByIdx = "selBar"
            Case T_PINTRI: TokenNameByIdx = "pinTri"
            Case T_LOCKC: TokenNameByIdx = "lock"
            Case T_EDITPANEL: TokenNameByIdx = "editPanel"
            Case T_EDITSHEET: TokenNameByIdx = "editSheet"
            Case T_SUNKENLIGHT: TokenNameByIdx = "sunkenLight"
            Case T_SUNKENDARK: TokenNameByIdx = "sunkenDark"
            Case T_SEARCHLINE: TokenNameByIdx = "searchLine"
            Case T_SEARCHFOCUS: TokenNameByIdx = "searchFocus"
            Case T_STATUSTOP: TokenNameByIdx = "statusTop"
            Case T_STATUSBOT: TokenNameByIdx = "statusBot"
            Case T_STATUSLINE: TokenNameByIdx = "statusLine"
            Case T_GRIP: TokenNameByIdx = "grip"
            Case T_TEXT: TokenNameByIdx = "text"
            Case T_TEXTMUTED: TokenNameByIdx = "textMuted"
            Case T_BRANDDOT: TokenNameByIdx = "brandDot"
        Case T_ROWSEP: TokenNameByIdx = "rowSep"
        End Select
    End Function

