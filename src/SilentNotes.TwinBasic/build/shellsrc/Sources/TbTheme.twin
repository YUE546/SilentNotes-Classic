    End Property

    Public Property Get ChipSelBot() As Long
        ChipSelBot = m_t(T_CHIPSELBOT)
    End Property

    Public Property Get ChipSelLine() As Long
        ChipSelLine = m_t(T_CHIPSELLINE)
    End Property

    Public Property Get ListBg() As Long
        ListBg = m_t(T_LISTBG)
    End Property

    Public Property Get ItemHover() As Long
        ItemHover = m_t(T_ITEMHOVER)
    End Property

    Public Property Get SelTop() As Long
        SelTop = m_t(T_SELTOP)
    End Property

    Public Property Get SelBot() As Long
        SelBot = m_t(T_SELBOT)
    End Property

    Public Property Get SelLine() As Long
        SelLine = m_t(T_SELLINE)
    End Property

    Public Property Get SelBar() As Long
        SelBar = m_t(T_SELBAR)
    End Property

    Public Property Get PinTri() As Long
        PinTri = m_t(T_PINTRI)
    End Property

    Public Property Get LockC() As Long
        LockC = m_t(T_LOCKC)
    End Property

    Public Property Get EditPanel() As Long
        EditPanel = m_t(T_EDITPANEL)
    End Property

    Public Property Get EditSheet() As Long
        EditSheet = m_t(T_EDITSHEET)
    End Property

    Public Property Get SunkenLight() As Long
        SunkenLight = m_t(T_SUNKENLIGHT)
    End Property

    Public Property Get SunkenDark() As Long
