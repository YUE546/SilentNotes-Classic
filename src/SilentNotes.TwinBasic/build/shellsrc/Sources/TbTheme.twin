    ' --------------------------------------------------------------- apply

    ' Applies the named theme. Legacy flat names map: light->blue,
    ' dark->graphite. Returns False for unknown names.
    Public Function Apply(themeName As String) As Boolean
        Dim canon As String
        canon = CanonicalName(themeName)
        If Len(canon) = 0 Then Exit Function
        If canon = "blue" Then
            ApplyBlue
        Else
            ApplyGraphite
        End If
        m_Name = canon
        Apply = True
    End Function

    ' light -> blue, dark -> graphite (legacy ini values keep working)
    Public Function CanonicalName(themeName As String) As String
        If StrComp(themeName, "blue", vbTextCompare) = 0 Or StrComp(themeName, "light", vbTextCompare) = 0 Then
            CanonicalName = "blue"
        ElseIf StrComp(themeName, "graphite", vbTextCompare) = 0 Or StrComp(themeName, "dark", vbTextCompare) = 0 Then
            CanonicalName = "graphite"
        End If
    End Function

    Private Sub ApplyBlue()
        ' classic gray family (VB6/Win2000 button face #D4D0C8): chrome
        ' strips flat, list white, XP solid selection #316AC5
        m_t(T_TITLEGRADTOP) = RGB(&HFA, &HFC, &HFE)   ' #FAFCFE (unused by drawing)
        m_t(T_TITLEGRADBOT) = RGB(&HC9, &HD9, &HEC)   ' #C9D9EC (unused by drawing)
        m_t(T_TITLELINE) = RGB(&H99, &HB3, &HCE)      ' #99B3CE (unused by drawing)
        m_t(T_TITLETEXT) = RGB(&H1E, &H39, &H5B)      ' #1E395B (unused by drawing)
        m_t(T_FRAME) = RGB(&H6E, &H8B, &HB0)          ' #6E8BB0 (unused by drawing)
        m_t(T_TOOLGRADTOP) = RGB(&HD4, &HD0, &HC8)    ' #D4D0C8 (flat)
        m_t(T_TOOLGRADBOT) = RGB(&HD4, &HD0, &HC8)    ' #D4D0C8 (flat)
        m_t(T_TOOLLINE) = RGB(&H80, &H80, &H80)       ' #808080
        m_t(T_BTNHOVERTOP) = RGB(&HFF, &HFF, &HFF)    ' #FFFFFF (unused by drawing)
        m_t(T_BTNHOVERBOT) = RGB(&HDC, &HE4, &HEF)    ' #DCE4EF (unused by drawing)
        m_t(T_BTNHOVERLINE) = RGB(&H98, &HB5, &HD1)   ' #98B5D1 (unused by drawing)
        m_t(T_CAPHOVERTOP) = RGB(&HFD, &HE8, &HCC)    ' #FDE8CC (unused by drawing)
        m_t(T_CAPHOVERBOT) = RGB(&HF8, &HDD, &HC0)    ' #F8DDC0 (unused by drawing)
        m_t(T_CAPHOVERLINE) = RGB(&HE1, &H96, &H02)   ' #E19602 (unused by drawing)
        m_t(T_CLOSEHOVERTOP) = RGB(&HD1, &H4B, &H4B)  ' #D14B4B (unused by drawing)
        m_t(T_CLOSEHOVERBOT) = RGB(&HC2, &H44, &H44)  ' #C24444 (unused by drawing)
        m_t(T_TAGBG) = RGB(&HD4, &HD0, &HC8)          ' #D4D0C8
        m_t(T_CHIPTOP) = RGB(&HD4, &HD0, &HC8)        ' #D4D0C8
        m_t(T_CHIPBOT) = RGB(&HD4, &HD0, &HC8)        ' #D4D0C8
        m_t(T_CHIPLINE) = RGB(&H80, &H80, &H80)       ' #808080
        m_t(T_CHIPTEXT) = RGB(&H00, &H00, &H00)       ' #000000
        m_t(T_CHIPSELTOP) = RGB(&H31, &H6A, &HC5)     ' #316AC5
        m_t(T_CHIPSELBOT) = RGB(&H31, &H6A, &HC5)     ' #316AC5
        m_t(T_CHIPSELLINE) = RGB(&H31, &H6A, &HC5)    ' #316AC5
        m_t(T_LISTBG) = RGB(&HFF, &HFF, &HFF)         ' #FFFFFF
        m_t(T_ITEMHOVER) = RGB(&HE0, &HE0, &HE0)      ' #E0E0E0 (gray hover wash)
        m_t(T_SELTOP) = RGB(&H31, &H6A, &HC5)         ' #316AC5 (XP solid selection)
        m_t(T_SELBOT) = RGB(&H31, &H6A, &HC5)         ' #316AC5
        m_t(T_SELLINE) = RGB(&H31, &H6A, &HC5)        ' #316AC5
        m_t(T_SELBAR) = RGB(&H31, &H6A, &HC5)         ' #316AC5
        m_t(T_PINTRI) = RGB(&H0A, &H24, &H6A)         ' #0A246A (classic navy)
        m_t(T_LOCKC) = RGB(&H80, &H80, &H80)          ' #808080
        m_t(T_EDITPANEL) = RGB(&HD4, &HD0, &HC8)      ' #D4D0C8
        m_t(T_EDITSHEET) = RGB(&HFF, &HFF, &HFF)      ' #FFFFFF
        m_t(T_SUNKENLIGHT) = RGB(&HFF, &HFF, &HFF)    ' #FFFFFF
        m_t(T_SUNKENDARK) = RGB(&H80, &H80, &H80)     ' #808080
        m_t(T_SEARCHLINE) = RGB(&H80, &H80, &H80)     ' #808080
        m_t(T_SEARCHFOCUS) = RGB(&H31, &H6A, &HC5)    ' #316AC5
        m_t(T_STATUSTOP) = RGB(&HD4, &HD0, &HC8)      ' #D4D0C8 (flat)
        m_t(T_STATUSBOT) = RGB(&HD4, &HD0, &HC8)      ' #D4D0C8 (flat)
        m_t(T_STATUSLINE) = RGB(&H80, &H80, &H80)     ' #808080
        m_t(T_GRIP) = RGB(&H80, &H80, &H80)           ' #808080
        m_t(T_TEXT) = RGB(&H00, &H00, &H00)           ' #000000
        m_t(T_TEXTMUTED) = RGB(&H80, &H80, &H80)      ' #808080
        m_t(T_BRANDDOT) = RGB(&H2A, &H60, &H9E)       ' #2A609E (unused by drawing)
        m_t(T_ROWSEP) = RGB(&HC0, &HC0, &HC0)         ' #C0C0C0
    End Sub

    Private Sub ApplyGraphite()
        m_t(T_TITLEGRADTOP) = RGB(&H4A, &H50, &H58)   ' #4A5058
        m_t(T_TITLEGRADBOT) = RGB(&H2F, &H34, &H3A)   ' #2F343A
        m_t(T_TITLELINE) = RGB(&H22, &H26, &H2A)      ' #22262A
        m_t(T_TITLETEXT) = RGB(&HE8, &HEA, &HED)      ' #E8EAED
        m_t(T_FRAME) = RGB(&H1A, &H1D, &H20)          ' #1A1D20
        m_t(T_TOOLGRADTOP) = RGB(&H3A, &H40, &H46)    ' #3A4046
        m_t(T_TOOLGRADBOT) = RGB(&H2E, &H34, &H39)    ' #2E3439
        m_t(T_TOOLLINE) = RGB(&H22, &H26, &H2A)       ' #22262A
        m_t(T_BTNHOVERTOP) = RGB(&H4E, &H56, &H5F)    ' #4E565F
        m_t(T_BTNHOVERBOT) = RGB(&H4A, &H51, &H5A)    ' #4A515A (hue of #4E565F, slight deepen)
        m_t(T_BTNHOVERLINE) = RGB(&H6B, &H74, &H80)   ' #6B7480
        m_t(T_CAPHOVERTOP) = RGB(&H5C, &H64, &H6E)    ' #5C646E
        m_t(T_CAPHOVERBOT) = RGB(&H56, &H5E, &H67)    ' #565E67 (hue of #5C646E, slight deepen)
        m_t(T_CAPHOVERLINE) = RGB(&H6B, &H74, &H80)   ' #6B7480
        m_t(T_CLOSEHOVERTOP) = RGB(&HB0, &H3A, &H3A)  ' #B03A3A
        m_t(T_CLOSEHOVERBOT) = RGB(&HA5, &H35, &H35)  ' #A53535 (slight deepen)
        m_t(T_TAGBG) = RGB(&H2B, &H30, &H36)          ' #2B3036
        m_t(T_CHIPTOP) = RGB(&H3E, &H45, &H4D)        ' #3E454D
        m_t(T_CHIPBOT) = RGB(&H3A, &H40, &H48)        ' #3A4048 (hue of #3E454D, slight deepen)
        m_t(T_CHIPLINE) = RGB(&H5A, &H64, &H70)       ' #5A6470
        m_t(T_CHIPTEXT) = RGB(&HCD, &HD3, &HDA)       ' #CDD3DA
        m_t(T_CHIPSELTOP) = RGB(&H4E, &H61, &H78)     ' #4E6178
        m_t(T_CHIPSELBOT) = RGB(&H42, &H54, &H6A)     ' #42546A
        m_t(T_CHIPSELLINE) = RGB(&H74, &H89, &HA4)    ' #7489A4
        m_t(T_LISTBG) = RGB(&H32, &H37, &H3D)         ' #32373D
        m_t(T_ITEMHOVER) = RGB(&H3E, &H45, &H4D)      ' #3E454D (chip-family hover wash, keeps #E8EAED text readable)
        m_t(T_SELTOP) = RGB(&H00, &H78, &HD7)         ' #0078D7 (solid selection blue)
        m_t(T_SELBOT) = RGB(&H00, &H78, &HD7)         ' #0078D7
        m_t(T_SELLINE) = RGB(&H00, &H78, &HD7)        ' #0078D7
        m_t(T_SELBAR) = RGB(&H00, &H78, &HD7)         ' #0078D7
        m_t(T_PINTRI) = RGB(&H9D, &HB8, &HE0)         ' #9DB8E0
        m_t(T_LOCKC) = RGB(&H9A, &HA5, &HB1)          ' #9AA5B1
        m_t(T_EDITPANEL) = RGB(&H26, &H29, &H2E)      ' #26292E
        m_t(T_EDITSHEET) = RGB(&H20, &H24, &H29)      ' #202429 (recessed sheet)
        m_t(T_SUNKENLIGHT) = RGB(&H4A, &H51, &H58)    ' #4A5158
        m_t(T_SUNKENDARK) = RGB(&H14, &H17, &H1A)     ' #14171A
        m_t(T_SEARCHLINE) = RGB(&H14, &H17, &H1A)     ' #14171A
        m_t(T_SEARCHFOCUS) = RGB(&H7C, &H93, &HB5)    ' #7C93B5
